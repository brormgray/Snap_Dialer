{
  "name": "snap-dialer",
  "version": "1.8.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "version:sync": "node scripts/version-sync.js sync",
    "version:bump": "node scripts/version-sync.js patch",
    "version:minor": "node scripts/version-sync.js minor",
    "export:web": "node scripts/version-sync.js sync && expo export -p web",
    "deploy": "npm run export:web && node deploy-surge.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^4.4.5",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-camera": "~16.0.0",
    "expo-constants": "~17.0.3",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-image-manipulator": "~13.0.5",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
