{"step_index":1989,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-23T17:38:35Z","content":"Created At: 2026-08-23T13:38:35-04:00\nCompleted At: 2026-08-23T13:38:35-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/geminiModelService.ts`\nTotal Lines: 69\nTotal Bytes: 2448\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * Dynamic Google Gemini API Model Discovery Service\n3:  * Queries the live Google Gemini API endpoint to retrieve all currently active, available models\n4:  * for the user's API key and prioritizes ultra-fast Flash vision models.\n5:  */\n6: \n7: export class GeminiModelService {\n8:   private static cachedModels: string[] | null = null;\n9:   private static cacheTimestamp: number = 0;\n10: \n11:   /**\n12:    * Retrieves active models dynamically from the Google Generative Language API\n13:    */\n14:   static async getActiveModels(apiKey: string): Promise<string[]> {\n15:     const now = Date.now();\n16:     // Cache for 1 hour to prevent unnecessary API overhead\n17:     if (this.cachedModels && this.cachedModels.length > 0 && (now - this.cacheTimestamp < 3600000)) {\n18:       return this.cachedModels;\n19:     }\n20: \n21:     const fallbackList = [\n22:       'gemini-2.5-flash',\n23:       'gemini-2.5-pro',\n24:       'gemini-2.0-flash',\n25:       'gemini-2.0-flash-lite',\n26:       'gemini-1.5-flash-latest',\n27:       'gemini-1.5-pro-latest',\n28:       'gemini-3.7-flash',\n29:       'gemini-3.6-flash',\n30:       'gemini-3.5-flash',\n31:     ];\n32: \n33:     try {\n34:       const endpoint = https://generativelanguage.googleapis.com/v1beta/models?key=;\n35:       const response = await fetch(endpoint);\n36:       if (response.ok) {\n37:         const data = await response.json();\n38:         const available: string[] = (data?.models || [])\n39:           .filter((m: any) => m.supportedGenerationMethods?.includes('generateContent'))\n40:           .map((m: any) => m.name.replace(/^models\\//, ''));\n41: \n42:         if (available.length > 0) {\n43:           // Sort so high-speed flash vision models are tried first\n44:           const sorted = available.sort((a, b) => {\n45:             const aName = a.toLowerCase();\n46:             const bName = b.toLowerCase();\n47: \n48:             // Give highest priority to modern flash models (2.5-flash, 2.0-flash, 3.x-flash)\n49:             const aScore = aName.includes('2.5-flash') ? 100 : aName.includes('2.0-flash') ? 90 : aName.includes('flash') ? 80 : 50;\n50:             const bScore = bName.includes('2.5-flash') ? 100 : bName.includes('2.0-flash') ? 90 : bName.includes('flash') ? 80 : 50;\n51: \n52:             return bScore - aScore;\n53:           });\n54: \n55:           this.cachedModels = sorted;\n56:           this.cacheTimestamp = now;\n57:           return sorted;\n58:         }\n59:       }\n60:     } catch (e) {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
