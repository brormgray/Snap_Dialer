aptics.ImpactFeedbackStyle.Heavy);\\n      } else if (typeof navigator !== 'undefined' && navigator.vibrate) {\\n        navigator.vibrate([30, 50, 30]);\\n      }\\n    } catch {}\\n  }\\n\\n  /**\\n   * Success notification (used for Connected / Qualified)\\n   */\\n  static async success() {\\n    try {\\n      const Haptics = await this.getModule();\\n      if (Haptics) {\\n        await Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);\\n      } else if (typeof navigator !== 'undefined' && navigator.vibrate) {\\n        navigator.vibrate([15, 30, 60]);\\n      }\\n    } catch {}\\n  }\\n\\n  /**\\n   * E\n<truncated 365 bytes>","Description":"\"Sensory Haptic feedback service with native iOS/Android expo-haptics and web fallbacks\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\brorm\\\\.gemini\\\\antigravity\\\\scratch\\\\snap-dialer\\\\src\\\\services\\\\hapticsService.ts\"","toolAction":"\"Writing haptics service\"","toolSummary":"\"Write HapticsService.ts\""}}],"truncated_fields":["tool_calls"]}
