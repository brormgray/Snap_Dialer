tured(optimizedUri);\\n      }\\n    } catch (e: any) {\\n      setIsProcessing(false);\\n      Alert.alert('Image Error', e?.message || 'Failed to select image.');\\n    }\\n  };\\n\\n  const handleImageCaptured = async (uri: string) => {\\n    setImageUri(uri);\\n    setIsProcessing(true);\\n    try {\\n      const leads = await VisionService.extractLeadsFromImage(uri, apiKey);\\n      await HapticsService.success();\\n      setExtractedLeads(leads);\\n      setHasScanned(true);\\n    } catch (e: any) {\\n      const msg = e?.message || 'Could not parse leads from image.';\\n      if (Platform.OS === 'web' && typeof window !== 'undefined') {\\n        window.alert(`Scan Notice: ${msg}`);\\n      } else {\\n        Alert.alert('Scan Notice', msg);\\n      }\\n      // Initialize an empty editable educator entry linked to the photo so user can manually verify\\n      setExtractedLeads([\\n        {\\n          id: `manual_${Date.now()}`,\\n          name: '',\\n          phone: '',\\n          school: 'VOL',\\n          email: '',\\n          planning_period: '',\\n          years_in_frs: '',\\n  \n<truncated 5721 bytes>","StartLine":"55","TargetContent":"\"  const takePhoto = asyn