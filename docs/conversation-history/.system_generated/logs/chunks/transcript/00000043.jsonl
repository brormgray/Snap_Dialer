ptions = {};\\n  }\\n  if (hostname === 'surge.surge.sh') {\\n    return callback(null, '192.241.214.148', 4);\\n  }\\n  if (hostname === 'surge.sh' || hostname.endsWith('.surge.sh') || hostname.endsWith('.surge.io')) {\\n    return callback(null, '138.197.235.123', 4);\\n  }\\n  return origLookup(hostname, options, callback);\\n};\\n\\n// Launch Surge Deploy\\nconst surge = require('C:/Users/brorm/AppData/Local/npm-cache/_npx/23158936acd5c32d/node_modules/surge')({\\n  endpoint: 'https://surge.surge.sh'\\n});\\nsurge(['./dist', 'valuteachers-dialer.surge.sh', '--endpoint', 'https://surge.surge.sh']);\\n\"","Description":"\"Write complete deploy-surge.js with undici and socket DNS bypass\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\brorm\\\\.gemini\\\\antigravity\\\\scratch\\\\snap-dialer\\\\deploy-surge.js\"","toolAction":"\"Writing deploy-surge.js\"","toolSummary":"\"Write deploy-surge.js\""}}]}
