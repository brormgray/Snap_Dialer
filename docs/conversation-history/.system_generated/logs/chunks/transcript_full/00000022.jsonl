const newCadenceStep = lead.cadence_step + 1;\n236: \n237:     await db.withTransactionAsync(async () => {\n238:       // Update lead\n239:       await db.runAsync(\n240:         `UPDATE leads \n241:          SET last_disposition = ?, \n242:              attempts_count = ?, \n243:              cadence_step = ?, \n244:              last_attempt_at = ?, \n245:              notes = COALESCE(?, notes),\n246:              updated_at = ?\n247:          WHERE id = ?`,\n248:         [disposition, newAttempts, newCadenceStep, now, note || null, now, leadId]\n249:       );\n250: \n251:       // Recalculate list stats\n252:       const stats = await db.getFirstAsync<{ total: number; completed: number; connected: number }>(\n253:         `SELECT \n254:            COUNT(*) as total,\n255:            SUM(CASE WHEN last_disposition IN ('connected', 'bad_number', 'do_not_call') THEN 1 ELSE 0 END) as completed,\n256:            SUM(CASE WHEN last_disposition = 'connected' THEN 1 ELSE 0 END) as connected\n257:          FROM leads WHERE list_id = ?`,\n258:         [lead.list_id]\n259:       );\n260: \n261:       if (stats) {\n262:         await db.runAsync(\n263:           `UPDATE lists \n264:            SET completed_leads = ?, connected_leads = ?, updated_at = ? \n265:            WHERE id = ?`,\n266:           [stats.completed || 0, stats.connected || 0, now, lead.list_id]\n267:         );\n268:       }\n269:     });\n270:   }\n271: \n272:   static async scheduleFollowUp(leadId: string, followUpDateISO: string, note?: string): Promise<void> {\n273:     const db = await getDatabase();\n274:     const now = new Date().toISOString();\n275:     await db.runAsync(\n276:       `UPDATE leads \n277:        SET follow_up_at = ?, \n278:            last_disposition = 'callback_requested', \n279:            notes = COALESCE(?, notes), \n280:            updated_at = ? \n281:        WHERE id = ?`,\n282:       [followUpDateISO, note || null, now, leadId]\n283:     );\n284:   }\n285: \n286:   stati