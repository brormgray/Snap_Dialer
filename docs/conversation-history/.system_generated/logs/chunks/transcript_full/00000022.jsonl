al_salary, present_403b_contribution, \n30:             source_image_uri, company, notes, cadence_step, last_disposition, attempts_count, created_at, updated_at\n31:           ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 'pending', 0, ?, ?)`,\n32:           [\n33:             leadId,\n34:             listId,\n35:             item.name.trim(),\n36:             item.phone.trim(),\n37:             item.school || 'VOL',\n38:             item.email || null,\n39:             item.age || null,\n40:             item.planning_period || null,\n41:             item.room_number || null,\n42:             item.years_in_frs || null,\n43:             item.text_ok !== undefined ? (item.text_ok ? 1 : 0) : 1,\n44:             item.frs_knowledge || null,\n45:             JSON.stringify(item.frs_interests || []),\n46:             item.custom_questions || null,\n47:             JSON.stringify(item.meeting_preferences || []),\n48:             item.annual_salary || null,\n49:             item.present_403b_contribution || null,\n50:             item.source_image_uri || imageUri || null,\n51:             item.company || 'ValuTeachers',\n52:             item.notes || null,\n53:             now,\n54:             now,\n55:           ]\n56:         );\n57:       }\n58:     });\n59: \n60:     return {\n61:       id: listId,\n62:       title,\n63:       source_image_uri: imageUri,\n64:       total_leads: validLeads.length,\n65:       completed_leads: 0,\n66:       connected_leads: 0,\n67:       created_at: now,\n68:       updated_at: now,\n69:     };\n70:   }\n71: \n72:   /**\n73:    * Adds a single educator lead directly to the master pipeline without requiring a list\n74:    */\n75:   static async addSingleLead(\n76:     item: ExtractedLeadItem,\n77:     imageUri?: string | null\n78:   ): Promise<Lead> {\n79:     const db = await getDatabase();\n80:     const leadId = 'lead_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);\n81:     const now = new Date().toISOString();\n82: \n83:     await db.runAsync(\n84:       `INSERT INTO leads (\n85:         id, list_id, name, phone, school, email, age, planning_period, \n86:         room_number, years_in_frs, text_ok, frs_knowledge, frs_interests, \n87:         custom_questions, meeting_preferences, annual_salary, present_403b_contribution, \n88:         source_image_uri, company, notes, cadence_step, last_disposition, attempts_count, created_at, updated_at\n89:       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 'pending', 0, ?, ?)`,\n90:       [\n91:         leadId,\n92:         'master_queue',\n93:         item.name.trim(),\n94:         item.phone.trim(),\n95:         item.school || 'VOL',\n96:         item.email || null,\n97:         item.age || null,\n98:         item.planning_period || null,\n99:         item.room_number || null,\n100:         item.years_in_frs || null,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
