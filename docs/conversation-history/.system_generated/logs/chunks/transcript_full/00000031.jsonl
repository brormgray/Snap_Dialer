h JPEG (quality 0.75, <250KB)\n   * on-device before any API or OCR processing.\n   */\n  static async downsampleAndCompress(imageUri: string): Promise<string> {\n    if (Platform.OS === 'web') {\n      return await this.downsampleWebImage(imageUri, 1600, 0.75);\n    }\n\n    try {\n      const ImageManipulator = await import('expo-image-manipulator');\n      const manipulated = await ImageManipulator.manipulateAsync(\n        imageUri,\n        [{ resize: { width: 1600 } }],\n        { compress: 0.75, format: ImageManipulator.SaveFormat.JPEG }\n      );\n      return manipulated.uri;","TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\services\\documentScannerService.ts","toolAction":"Adding ts-ignore to optional imports in documentScannerService.ts","toolSummary":"Add ts-ignore in documentScannerService.ts"}}]}
