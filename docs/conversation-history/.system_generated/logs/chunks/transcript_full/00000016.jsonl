{"step_index":593,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T17:58:22Z","content":"Created At: 2026-08-20T13:58:22-04:00\nCompleted At: 2026-08-20T13:58:22-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/aiSmsService.ts`\nTotal Lines: 122\nTotal Bytes: 6194\nShowing lines 1 to 115\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Lead, CallLog, AppSettings } from '../types';\n2: import { SettingsRepository } from '../db/settingsRepository';\n3: import { CallLogsRepository } from '../db/callLogsRepository';\n4: \n5: export class AiSmsService {\n6:   /**\n7:    * Generates a subtly persuasive, warm, and tailored SMS message for Florida educators\n8:    * where the primary objective is scheduling a quick in-person sit-down during their\n9:    * requested planning period or preferred time window.\n10:    */\n11:   static async generatePersuasiveSMS(\n12:     lead: Lead,\n13:     currentDisposition?: string,\n14:     providedApiKey?: string,\n15:     toneFocus?: 'meeting_confirmation' | 'unanswered_followup' | 'drop_bonus_focus' | 'planning_period'\n16:   ): Promise<string> {\n17:     const settings = await SettingsRepository.getSettings();\n18:     const agentName = settings.user_name || 'Alex';\n19:     let key = providedApiKey || settings.gemini_api_key;\n20: \n21:     // If no API key, return a high-converting default ValuTeachers sit-down template\n22:     if (!key || key.trim().length === 0) {\n23:       return this.getFallbackSMS(lead, agentName);\n24:     }\n25: \n26:     try {\n27:       const history = await CallLogsRepository.getLogsForLead(lead.id);\n28: \n29:       const historySummary = history\n30:         .slice(0, 4)\n31:         .map(\n32:           (h) =>\n33:             `- Attempt at ${new Date(h.timestamp).toLocaleDateString()}: Disposition \"${h.disposition}\"${\n34:               h.note ? `, Note: \"${h.note}\"` : ''\n35:             }`\n36:         )\n37:         .join('\\n');\n38: \n39:       const preferredTimes = (lead.meeting_preferences || []).join(', ') || 'your planning period';\n40:       const interests = (lead.frs_interests || []).join(', ') || 'Florida State Retirement & 403(b) options';\n41: \n42:       const prompt = `\n43: You are an expert consultative copywriter for ValuTeachers working with Florida public school teachers (Florida Retirement System / FRS).\n44: \n45: PRIMARY OBJECTIVE:\n46: Schedule an in-person sit-down with the teacher during their full planning period (or classroom/room number as indicated on their report card) to review their FRS state pension calculation, 403(b) options, DROP timeline, and the 5% bonus. Note that these sit-down consultations are comprehensive and take place during their planning session.\n47: \n48: Context for Educator:\n49: - Educator Name: ${lead.name}\n50: - School / District: ${lead.school || 'Florida School District'}\n51: - Planning Period / Room: ${lead.planning_period || 'N/A'}${lead.room_number ? `, Room ${lead.room_number}` : ''}\n52: - Years in FRS: ${lead.years_in_frs || 'N/A'} years\n53: - FRS Knowledge Level: \"${lead.frs_knowledge || 'Moderate'}\"\n54: - Specific Needs / Inquiries Checked on Report Card: ${interests}\n55: - Educator's Written Question: \"${lead.custom_questions || 'None'}\"\n56: - Requested Sit-Down / Meeting Availability: ${preferredTimes}\n57: - Current Call Outcome: ${currentDisposition || 'Follow-up'}\n58: - Previous Contact History & Notes:\n59: ${historySummary || 'First outreach attempt.'}\n60: - ValuTeachers Representative Name: ${agentName}\n61: \n62: Strategy & Tone Guidelines:\n63: 1. Focus on scheduling the SIT-DOWN: Frame the message around locking in a sit-down during their planning period (${lead.planning_period || 'planning period'}) or preferred slot (${preferredTimes}).\n64: 2. Mention being on campus / visiting ${lead.school || 'the school'} so the sit-down feels effortless, convenient, and focused on their classroom.\n65: 3. Subtly persuasive & consultative: Avoid aggressive sales language. Speak as a trusted educational retirement advisor who received their handwritten request.\n66: 4. Seamlessly incorporate their specific interest (e.g. 5% bonus on contributions, DROP calculation, or 403b clarity).\n67: 5. Length: Keep between 180 and 240 characters for immediate readability on mobile screens.\n68: 6. Frictionless Call-to-Action: Ask a simple confirmation question (e.g. \"I'll be at ${lead.school || 'the school'} this week—does ${preferredTimes} still work for a sit-down during your planning period in your room to review your options, or is another day better?\").\n69: 7. Output ONLY the raw SMS text without quotes or preamble.\n70: `;\n71: \n72:       const candidateModels = ['gemini-3.6-flash', 'gemini-2.0-flash', 'gemini-1.5-flash'];\n73: \n74:       for (const model of candidateModels) {\n75:         try {\n76:           const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`;\n77: \n78:           const response = await fetch(endpoint, {\n79:             method: 'POST',\n80:             headers: { 'Content-Type': 'application/json' },\n81:             body: JSON.stringify({\n82:               contents: [{ parts: [{ text: prompt }] }],\n83:               generationConfig: {\n84:                 temperature: 0.3,\n85:                 maxOutputTokens: 180,\n86:               },\n87:             }),\n88:           });\n89: \n90:           if (response.ok) {\n91:             const data = await response.json();\n92:             const text = data?.candidates?.[0]?.content?.parts?.[0]?.text?.trim();\n93:             if (text) {\n94:               return text.replace(/^[\"']|[\"']$/g, '');\n95:             }\n96:           }\n97:         } catch {\n98:           // try next model\n99:         }\n100:       }\n101: \n102:     return this.getFallbackSMS(lead, agentName);\n103:   }\n104: \n105:   private static getFallbackSMS(lead: Lead, agentName: string = 'Alex'): string {\n106:     const firstName = lead.name ? lead.name.split(' ')[0] : 'there';\n107:     const school = lead.school || 'your school';\n108:     const planning = lead.planning_period || 'your planning period';\n109:     const room = lead.room_number ? ` in Room ${lead.room_number}` : '';\n110:     const primaryTime =\n111:       lead.meeting_preferences && lead.meeting_preferences.length > 0\n112:         ? lead.meeting_preferences[0].replace(/^[0-9]\\.\\s*/, '')\n113:         : `during ${planning}`;\n114: \n115:     if (lead.years_in_frs && parseInt(lead.years_in_frs, 10) >= 15) {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
