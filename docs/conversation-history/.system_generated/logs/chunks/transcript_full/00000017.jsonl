st stats = await db.getFirstAsync<{ total: number; completed: number; connected: number }>(\n144:         `SELECT \n145:            COUNT(*) as total,\n146:            SUM(CASE WHEN last_disposition IN ('connected', 'bad_number', 'do_not_call') THEN 1 ELSE 0 END) as completed,\n147:            SUM(CASE WHEN last_disposition = 'connected' THEN 1 ELSE 0 END) as connected\n148:          FROM leads WHERE list_id = ?`,\n149:         [lead.list_id]\n150:       );\n151: \n152:       if (stats) {\n153:         await db.runAsync(\n154:           `UPDATE lists \n155:            SET completed_leads = ?, connected_leads = ?, updated_at = ? \n156:            WHERE id = ?`,\n157:           [stats.completed || 0, stats.connected || 0, now, lead.list_id]\n158:         );\n159:       }\n160:     });\n161:   }\n162: \n163:   static async scheduleFollowUp(leadId: string, followUpDateISO: string, note?: string): Promise<void> {\n164:     const db = await getDatabase();\n165:     const now = new Date().toISOString();\n166:     await db.runAsync(\n167:       `UPDATE leads \n168:        SET follow_up_at = ?, \n169:            last_disposition = 'callback_requested', \n170:            notes = COALESCE(?, notes), \n171:            updated_at = ? \n172:        WHERE id = ?`,\n173:       [followUpDateISO, note || null, now, leadId]\n174:     );\n175:   }\n176: \n177:   static async getUpcomingFollowUps(): Promise<Lead[]> {\n178:     const db = await getDatabase();\n179:     const rawLeads = await db.getAllAsync<any>(\n180:       `SELECT * FROM leads \n181:        WHERE follow_up_at IS NOT NULL \n182:        ORDER BY follow_up_at ASC`\n183:     );\n184:     return rawLeads.map(this.hydrateLead);\n185:   }\n186: \n187:   private static hydrateLead(raw: any): Lead {\n188:     let interests: string[] = [];\n189:     let preferences: string[] = [];\n190: \n191:     if (typeof raw.frs_interests === 'string') {\n192:       try {\n193:         interests = JSON.parse(raw.frs_interests);\n194:       } 