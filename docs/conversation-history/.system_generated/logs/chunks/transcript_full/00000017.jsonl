ry</Text>\n215:               </TouchableOpacity>\n216: \n217:               <TouchableOpacity\n218:                 style={styles.secondaryCaptureButton}\n219:                 onPress={() => setPasteModalVisible(true)}\n220:               >\n221:                 <Clipboard size={22} color=\"#94A3B8\" />\n222:                 <Text style={styles.secondaryCaptureButtonText}>Paste Text / CSV (100% Offline)</Text>\n223:               </TouchableOpacity>\n224: \n225:               <TouchableOpacity\n226:                 style={[styles.secondaryCaptureButton, { borderColor: '#3B82F6', backgroundColor: 'rgba(59, 130, 246, 0.1)' }]}\n227:                 onPress={() => {\n228:                   HapticsService.success();\n229:                   setExtractedLeads(VisionService.getDemoExtractedLeads());\n230:                   setHasScanned(true);\n231:                 }}\n232:               >\n233:                 <Sparkles size={20} color=\"#38BDF8\" />\n234:                 <Text style={[styles.secondaryCaptureButtonText, { color: '#38BDF8', fontWeight: '700' }]}>\n235:                   Load Sample Lead Sheet (Instant)\n236:                 </Text>\n237:               </TouchableOpacity>\n238:             </View>\n239: \n240:             {/* Optional API Key Input */}\n241:             <View style={styles.apiKeyContainer}>\n242:               <Text style={styles.apiKeyLabel}>Gemini Vision API Key (Optional)</Text>\n243:               <TextInput\n244:                 style={styles.input}\n245:                 placeholder=\"Leave blank to use smart offline demo extractor\"\n246:                 placeholderTextColor=\"#64748B\"\n247:                 value={apiKey}\n248:                 onChangeText={setApiKey}\n249:                 secureTextEntry\n250:               />\n251:               <Text style={styles.apiKeyHint}>\n252:                 If left blank, pre-loaded sample leads or offline pattern matching will be used.\n253:               </Text>\n254:             </View