{"step_index":645,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T18:04:25Z","content":"Created At: 2026-08-20T14:04:25-04:00\nCompleted At: 2026-08-20T14:04:25-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/screens/ListsScreen.tsx`\nTotal Lines: 711\nTotal Bytes: 19578\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React, { useState, useEffect, useCallback } from 'react';\n2: import {\n3:   View,\n4:   Text,\n5:   StyleSheet,\n6:   FlatList,\n7:   TouchableOpacity,\n8:   SafeAreaView,\n9:   StatusBar,\n10:   ActivityIndicator,\n11:   Alert,\n12:   TextInput,\n13:   ScrollView,\n14:   Platform,\n15: } from 'react-native';\n16: import { useFocusEffect } from '@react-navigation/native';\n17: import {\n18:   Camera,\n19:   PhoneCall,\n20:   Plus,\n21:   Trash2,\n22:   CheckCircle2,\n23:   ChevronRight,\n24:   ChevronDown,\n25:   BarChart3,\n26:   Settings,\n27:   RotateCcw,\n28:   Search,\n29:   User,\n30:   Calendar,\n31:   Clock,\n32: } from 'lucide-react-native';\n33: import { LeadsRepository } from '../db/leadsRepository';\n34: import { HapticsService } from '../services/hapticsService';\n35: import { LeadList, Lead, CallDisposition } from '../types';\n36: \n37: export default function ListsScreen({ navigation }: any) {\n38:   const [lists, setLists] = useState<LeadList[]>([]);\n39:   const [expandedListId, setExpandedListId] = useState<string | null>(null);\n40:   const [listLeads, setListLeads] = useState<{ [listId: string]: Lead[] }>({});\n41:   const [upcomingFollowUps, setUpcomingFollowUps] = useState<Lead[]>([]);\n42:   const [filterDisposition, setFilterDisposition] = useState<string>('all');\n43:   const [searchQuery, setSearchQuery] = useState<string>('');\n44:   const [loading, setLoading] = useState<boolean>(true);\n45: \n46:   const loadLists = async () => {\n47:     try {\n48:       const data = await LeadsRepository.getAllLists();\n49:       setLists(data);\n50:       const followUps = await LeadsRepository.getUpcomingFollowUps();\n51:       setUpcomingFollowUps(followUps);\n52: \n53:       if (expandedListId) {\n54:         const leads = await LeadsRepository.getLeadsForList(expandedListId);\n55:         setListLeads((prev) => ({ ...prev, [expandedListId]: leads }));\n56:       }\n57:     } catch (e) {\n58:       console.error(e);\n59:     } finally {\n60:       setLoading(false);\n61:     }\n62:   };\n63: \n64:   useFocusEffect(\n65:     useCallback(() => {\n66:       loadLists();\n67:     }, [expandedListId])\n68:   );\n69: \n70:   const toggleExpand = async (listId: string) => {\n71:     await HapticsService.tick();\n72:     if (expandedListId === listId) {\n73:       setExpandedListId(null);\n74:     } else {\n75:       setExpandedListId(listId);\n76:       const leads = await LeadsRepository.getLeadsForList(listId);\n77:       setListLeads((prev) => ({ ...prev, [listId]: leads }));\n78:     }\n79:   };\n80: \n81:   const handleDelete = async (id: string, title: string) => {\n82:     if (Platform.OS === 'web') {\n83:       const confirmed = typeof window !== 'undefined' && window.confirm(`Are you sure you want to delete \"${title}\"?`);\n84:       if (confirmed) {\n85:         await HapticsService.heavy();\n86:         await LeadsRepository.deleteList(id);\n87:         loadLists();\n88:       }\n89:       return;\n90:     }\n91: \n92:     Alert.alert('Delete List', `Are you sure you want to delete \"${title}\"?`, [\n93:       { text: 'Cancel', style: 'cancel' },\n94:       {\n95:         text: 'Delete',\n96:         style: 'destructive',\n97:         onPress: async () => {\n98:           await HapticsService.heavy();\n99:           await LeadsRepository.deleteList(id);\n100:           loadLists();\n101:         },\n102:       },\n103:     ]);\n104:   };\n105: \n106:   const handleRecycleList = async (listId: string, title: string) => {\n107:     await HapticsService.medium();\n108: \n109:     const doRecycle = async () => {\n110:       await HapticsService.success();\n111:       const db = await import('../db/database').then((m) => m.getDatabase());\n112:       await db.runAsync(\n113:         `UPDATE leads \n114:          SET last_disposition = 'pending' \n115:          WHERE list_id = ? AND last_disposition IN ('no_answer', 'voicemail')`,\n116:         [listId]\n117:       );\n118:       loadLists();\n119:     };\n120: \n121:     if (Platform.OS === 'web') {\n122:       const confirmed = typeof window !== 'undefined' && window.confirm(`Recycle unanswered leads in \"${title}\" for next attempt?`);\n123:       if (confirmed) {\n124:         await doRecycle();\n125:       }\n126:       return;\n127:     }\n128: \n129:     Alert.alert(\n130:       'Recycle Unanswered Leads for Next Attempt?',\n131:       `This will reset leads in \"${title}\" that did not connect so you can run the next call cadence attempt.`,\n132:       [\n133:         { text: 'Cancel', style: 'cancel' },\n134:         {\n135:           text: 'Recycle for Attempt',\n136:           onPress: doRecycle,\n137:         },\n138:       ]\n139:     );\n140:   };\n141: \n142:   const getStatusColor = (disp?: CallDisposition | null) => {\n143:     switch (disp) {\n144:       case 'connected':\n145:         return '#10B981';\n146:       case 'no_answer':\n147:       case 'voicemail':\n148:         return '#F59E0B';\n149:       case 'bad_number':\n150:       case 'do_not_call':\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":646,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-20T18:04:25Z","thinking":"**Constructing the Dashboard**\n\nI'm now focused on building the Individual Leads Dashboard UI within `ListsScreen.tsx`. It's designed to directly display individual leads. I've begun to structure the search and filter tabs, which will include sections for \"All Leads\", \"Pending / Needs Call\", and \"Sit\" leads, as the primary views. I anticipate this dashboard will greatly enhance lead management.\n\n\n**Designing the Dashboard Details**\n\nI'm now integrating crucial components into the lead dashboard. I've defined the top header with the ValuTeachers SnapDialer logo, quick action button, and settings gear. Key performance indicators (KPIs) like Total Leads, Ready to Dial, Sit-Downs, and Follow-Ups are in place. The main \"Start Power Dialing\" button now initiates the `DialerHUD`. Lead cards will now showcase detailed educator info.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect, useCallback } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  FlatList,\n  TouchableOpacity,\n  SafeAreaView,\n  StatusBar,\n  ActivityIndicator,\n  Alert,\n  TextInput,\n  Modal,\n  Image,\n  Platform,\n} from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport {\n  Camera,\n  PhoneCall,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  ChevronRight,\n  Settings,\n  RotateCcw,\n  Search,\n  User,\n  Calendar,\n  Clock,\n  MessageSquare,\n  Eye,\n  X,\n  Sparkles,\n  FileCheck,\n  Building,\n  GraduationCap,\n} from 'lucide-react-native';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { HapticsService } from '../services/hapticsService';\nimport { TelephonyService } from '../services/telephonyService';\nimport { Lead, CallDisposition } from '../types';\n\nexport default function ListsScreen({ navigation }: any) {\n  const [leads, setLeads] = useState<Lead[]>([]);\n  const [filteredLeads, setFilteredLeads] = useState<Lead[]>([]);\n  const [filterTab, setFilterTab] = useState<'all' | 'pending' | 'connected' | 'callback' | 'unanswered'>('all');\n  const [searchQuery, setSearchQuery] = useState<string>('');\n  const [loading, setLoading] = useState<boolean>(true);\n\n  // Original Card Image Proof Modal\n  const [previewImageUri, setPreviewImageUri] = useState<string | null>(null);\n\n  const loadLeads = async () => {\n    try {\n      const all = await LeadsRepository.getAllLeads();\n      setLeads(all);\n    } catch (e) {\n      console.error('Failed to load leads:', e);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useFocusEffect(\n    useCallback(() => {\n      loadLeads();\n    }, [])\n  );\n\n  useEffect(() => {\n    applyFilters();\n  }, [leads, filterTab, searchQuery]);\n\n  const applyFilters = () => {\n    let result = [...leads];\n\n    // Filter by Tab\n    if (filterTab === 'pending') {\n      result = result.filter((l) => !l.last_disposition || l.last_disposition === 'pending');\n    } else if (filterTab === 'connected') {\n      result = result.filter((l) => l.last_disposition === 'connected');\n    } else if (filterTab === 'callback') {\n      result = result.filter((l) => l.last_disposition === 'callback_requested' || !!l.follow_up_at);\n    } else if (filterTab === 'unanswered') {\n      result = result.filter((l) => ['no_answer', 'voicemail'].includes(l.last_disposition || ''));\n    }\n\n    // Filter by Search Query\n    if (searchQuery.trim().length > 0) {\n      const q = searchQuery.toLowerCase().trim();\n      result = result.filter(\n        (l) =>\n          l.name.toLowerCase().includes(q) ||\n          l.phone.includes(q) ||\n          (l.school && l.school.toLowerCase().includes(q)) ||\n          (l.planning_period && l.planning_period.toLowerCase().includes(q)) ||\n          (l.room_number && l.room_number.toLowerCase().includes(q))\n      );\n    }\n\n    setFilteredLeads(result);\n  };\n\n  const handleStartMasterQueue = async () => {\n    await HapticsService.success();\n    const pendingCount = leads.filter(\n      (l) => !l.last_disposition || ['pending', 'no_answer', 'voicemail'].includes(l.last_disposition)\n    ).length;\n\n    if (pendingCount === 0) {\n      Alert.alert(\n        'Queue Complete',\n        'All educators have been contacted! Snap a new report card or recycle unanswered calls to start again.'\n      );\n      return;\n    }\n\n    navigation.navigate('DialerHUD', {\n      listId: 'master_queue',\n      listTitle: 'ValuTeachers Calling Queue',\n    });\n  };\n\n  const handleDialSingle = async (lead: Lead) => {\n    await HapticsService.medium();\n    navigation.navigate('LeadDetail', { leadId: lead.id });\n  };\n\n  const handleDeleteLead = async (leadId: string, name: string) => {\n    if (Platform.OS === 'web') {\n      const confirmed = typeof window !== 'undefined' && window.confirm(`Permanently delete \"${name}\"?`);\n      if (confirmed) {\n        await HapticsService.heavy();\n        await LeadsRepository.deleteLead(leadId);\n        loadLeads();\n      }\n      return;\n    }\n\n    Alert.alert('Delete Contact', `Are you sure you want to delete \"${name}\"?`, [\n      { text: 'Cancel', style: 'cancel' },\n      {\n        text: 'Delete',\n        style: 'destructive',\n        onPress: async () => {\n          await HapticsService.heavy();\n          await LeadsRepository.deleteLead(leadId);\n          loadLeads();\n        },\n      },\n    ]);\n  };\n\n  const handleRecycleUnanswered = async () => {\n    await HapticsService.medium();\n\n    const doRecycle = async () => {\n      await HapticsService.success();\n      await LeadsRepository.recycleUnansweredLeads();\n      loadLeads();\n    };\n\n    if (Platform.OS === 'web') {\n      const confirmed = typeof window !== 'undefined' && window.confirm('Recycle all unanswered/voicemail leads back to the active dialing queue?');\n      if (confirmed) {\n        await doRecycle();\n      }\n      return;\n    }\n\n    Alert.alert(\n      'Recycle Unanswered Calls',\n      'Reset all leads with Voicemail or No Answer so you can run another call pass?',\n      [\n        { text: 'Cancel', style: 'cancel' },\n        { text: 'Recycle Leads', onPress: doRecycle },\n      ]\n    );\n  };\n\n  const getStatusBadge = (lead: Lead) => {\n    const disp = lead.last_disposition;\n    if (disp === 'connected') {\n      return { label: 'Sit-Down Set', bg: '#064E3B', color: '#34D399' };\n    }\n    if (disp === 'callback_requested' || lead.follow_up_at) {\n      return { label: 'Callback Scheduled', bg: '#451A03', color: '#FBBF24' };\n    }\n    if (disp === 'voicemail') {\n      return { label: `Voicemail (${lead.attempts_count})`, bg: '#1E293B', color: '#94A3B8' };\n    }\n    if (disp === 'no_answer') {\n      return { label: `No Answer (${lead.attempts_count})`, bg: '#1E293B', color: '#94A3B8' };\n    }\n    if (disp === 'do_not_call') {\n      return { label: 'Do Not Call', bg: '#7F1D1D', color: '#FCA5A5' };\n    }\n    return { label: 'Ready to Call', bg: '#1E3A8A', color: '#60A5FA' };\n  };\n\n  // Stats calculation\n  const totalCount = leads.length;\n  const pendingCount = leads.filter(\n    (l) => !l.last_disposition || ['pending', 'no_answer', 'voicemail'].includes(l.last_disposition)\n  ).length;\n  const connectedCount = leads.filter((l) => l.last_disposition === 'connected').length;\n  const callbackCount = leads.filter((l) => l.last_disposition === 'callback_requested' || !!l.follow_up_at).length;\n  const unansweredCount = leads.filter((l) => ['no_answer', 'voicemail'].includes(l.last_disposition || '')).length;\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* App Header */}\n      <View style={styles.header}>\n        <View style={styles.titleArea}>\n          <Text style={styles.appTitle}>SnapDialer</Text>\n          <Text style={styles.appSubtitle}>ValuTeachers • Florida FRS</Text>\n        </View>\n        <View style={styles.headerIcons}>\n          <TouchableOpacity\n            style={styles.snapHeaderButton}\n            onPress={() => {\n              HapticsService.medium();\n              navigation.navigate('ScanSheet');\n            }}\n          >\n            <Camera size={18} color=\"#FFFFFF\" />\n            <Text style={styles.snapHeaderButtonText}>Snap Sheet</Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={styles.iconButton}\n            onPress={() => navigation.navigate('Settings')}\n          >\n            <Settings size={22} color=\"#94A3B8\" />\n          </TouchableOpacity>\n        </View>\n      </View>\n\n      {/* KPI Stats Strip */}\n      <View style={styles.statsRow}>\n        <View style={styles.statCard}>\n          <Text style={styles.statNumber}>{totalCount}</Text>\n          <Text style={styles.statLabel}>Educators</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: '#334155' }]}>\n          <Text style={[styles.statNumber, { color: '#38BDF8' }]}>{pendingCount}</Text>\n          <Text style={styles.statLabel}>To Call</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: '#334155' }]}>\n          <Text style={[styles.statNumber, { color: '#34D399' }]}>{connectedCount}</Text>\n          <Text style={styles.statLabel}>Sit-Downs</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: '#334155' }]}>\n          <Text style={[styles.statNumber, { color: '#FBBF24' }]}>{callbackCount}</Text>\n          <Text style={styles.statLabel}>Follow-Ups</Text>\n        </View>\n      </View>\n\n      {/* Main Start Power Dialer CTA */}\n      <View style={styles.ctaContainer}>\n        <TouchableOpacity\n          style={[styles.startQueueButton, pendingCount === 0 && { backgroundColor: '#334155' }]}\n          onPress={handleStartMasterQueue}\n          activeOpacity={0.8}\n        >\n          <PhoneCall size={22} color=\"#FFFFFF\" />\n          <View style={{ flex: 1 }}>\n            <Text style={styles.startQueueTitle}>\n              {pendingCount > 0 ? 'Start Power Dialing Queue' : 'Queue Complete'}\n            </Text>\n            <Text style={styles.startQueueSubtitle}>\n              {pendingCount > 0\n                ? `${pendingCount} educator${pendingCount > 1 ? 's' : ''} queued for planning session sit-downs`\n                : 'All current leads called. Snap another card to add more.'}\n            </Text>\n          </View>\n          <ChevronRight size={22} color=\"#FFFFFF\" />\n        </TouchableOpacity>\n\n        {unansweredCount > 0 && (\n          <TouchableOpacity style={styles.recycleButton} onPress={handleRecycleUnanswered}>\n            <RotateCcw size={16} color=\"#FBBF24\" />\n            <Text style={styles.recycleText}>\n              Recycle {unansweredCount} Unanswered / Voicemail Lead{unansweredCount > 1 ? 's' : ''}\n            </Text>\n          </TouchableOpacity>\n        )}\n      </View>\n\n      {/* Search Bar */}\n      <View style={styles.searchContainer}>\n        <Search size={18} color=\"#64748B\" />\n        <TextInput\n          style={styles.searchInput}\n          placeholder=\"Search by teacher name, school (VOL), or room...\"\n          placeholderTextColor=\"#64748B\"\n          value={searchQuery}\n          onChangeText={setSearchQuery}\n        />\n        {searchQuery.length > 0 && (\n          <TouchableOpacity onPress={() => setSearchQuery('')}>\n            <X size={18} color=\"#64748B\" />\n          </TouchableOpacity>\n        )}\n      </View>\n\n      {/* Filter Tabs */}\n      <View style={styles.tabsContainer}>\n        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.tabsContent}>\n          <TouchableOpacity\n            style={[styles.tabChip, filterTab === 'all' && styles.tabChipActive]}\n            onPress={() => setFilterTab('all')}\n          >\n            <Text style={[styles.tabChipText, filterTab === 'all' && styles.tabChipTextActive]}>\n              All ({totalCount})\n            </Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={[styles.tabChip, filterTab === 'pending' && styles.tabChipActive]}\n            onPress={() => setFilterTab('pending')}\n          >\n            <Text style={[styles.tabChipText, filterTab === 'pending' && styles.tabChipTextActive]}>\n              To Call ({pendingCount})\n            </Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={[styles.tabChip, filterTab === 'connected' && styles.tabChipActive]}\n            onPress={() => setFilterTab('connected')}\n          >\n            <Text style={[styles.tabChipText, filterTab === 'connected' && styles.tabChipTextActive]}>\n              Sit-Downs ({connectedCount})\n            </Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={[styles.tabChip, filterTab === 'callback' && styles.tabChipActive]}\n            onPress={() => setFilterTab('callback')}\n          >\n            <Text style={[styles.tabChipText, filterTab === 'callback' && styles.tabChipTextActive]}>\n              Callbacks ({callbackCount})\n            </Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={[styles.tabChip, filterTab === 'unanswered' && styles.tabChipActive]}\n            onPress={() => setFilterTab('unanswered')}\n          >\n            <Text style={[styles.tabChipText, filterTab === 'unanswered' && styles.tabChipTextActive]}>\n              Unanswered ({unansweredCount})\n            </Text>\n          </TouchableOpacity>\n        </ScrollView>\n      </View>\n\n      {/* Lead Cards List */}\n      {loading ? (\n        <View style={styles.centerContainer}>\n          <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n          <Text style={styles.loadingText}>Loading educator leads...</Text>\n        </View>\n      ) : filteredLeads.length === 0 ? (\n        <View style={styles.emptyContainer}>\n          <GraduationCap size={48} color=\"#475569\" />\n          <Text style={styles.emptyTitle}>\n            {searchQuery ? 'No matching educators' : 'No educator leads yet'}\n          </Text>\n          <Text style={styles.emptyDesc}>\n            {searchQuery\n              ? 'Try adjusting your search terms or filter.'\n              : 'Tap \"Snap Sheet\" above to take a photo of a ValuTeachers Report Card.'}\n          </Text>\n          <TouchableOpacity\n            style={styles.emptyButton}\n            onPress={() => navigation.navigate('ScanSheet')}\n          >\n            <Camera size={20} color=\"#FFFFFF\" />\n            <Text style={styles.emptyButtonText}>Snap First Report Card</Text>\n          </TouchableOpacity>\n        </View>\n      ) : (\n        <FlatList\n          data={filteredLeads}\n          keyExtractor={(item) => item.id}\n          contentContainerStyle={{ padding: 16, paddingBottom: 60 }}\n          renderItem={({ item }) => {\n            const badge = getStatusBadge(item);\n            const dateAdded = item.created_at\n              ? new Date(item.created_at).toLocaleDateString(undefined, {\n                  month: 'short',\n                  day: 'numeric',\n                })\n              : '';\n\n            return (\n              <TouchableOpacity\n                style={styles.leadCard}\n                activeOpacity={0.7}\n                onPress={() => handleDialSingle(item)}\n              >\n                {/* Top Row: Name + Status */}\n                <View style={styles.cardHeaderRow}>\n                  <View style={{ flex: 1 }}>\n                    <Text style={styles.leadName}>{item.name}</Text>\n                    <View style={styles.metaRow}>\n                      <Building size={13} color=\"#94A3B8\" />\n                      <Text style={styles.leadSchool}>\n                        {item.school || 'VOL'}\n                        {item.room_number ? ` • Room ${item.room_number}` : ''}\n                      </Text>\n                      {dateAdded ? (\n                        <Text style={styles.dateAddedText}>• Added {dateAdded}</Text>\n                      ) : null}\n                    </View>\n                  </View>\n\n                  <View style={[styles.statusBadge, { backgroundColor: badge.bg }]}>\n                    <Text style={[styles.statusBadgeText, { color: badge.color }]}>\n                      {badge.label}\n                    </Text>\n                  </View>\n                </View>\n\n                {/* Details Section */}\n                <View style={styles.detailsBox}>\n                  {item.planning_period ? (\n                    <View style={styles.detailRow}>\n                      <Clock size={13} color=\"#38BDF8\" />\n                      <Text style={styles.detailText}>\n                        Planning: <Text style={{ color: '#F8FAFC' }}>{item.planning_period}</Text>\n                      </Text>\n                    </View>\n                  ) : null}\n\n                  {item.years_in_frs ? (\n                    <View style={styles.detailRow}>\n                      <FileCheck size={13} color=\"#34D399\" />\n                      <Text style={styles.detailText}>\n                        FRS Service: <Text style={{ color: '#F8FAFC' }}>{item.years_in_frs} Years</Text>\n                        {item.frs_knowledge ? ` (${item.frs_knowledge})` : ''}\n                      </Text>\n                    </View>\n                  ) : null}\n\n                  {item.meeting_preferences && item.meeting_preferences.length > 0 ? (\n                    <View style={styles.detailRow}>\n                      <Calendar size={13} color=\"#FBBF24\" />\n                      <Text style={styles.detailText} numberOfLines={1}>\n                        Preferred: <Text style={{ color: '#F8FAFC' }}>{item.meeting_preferences.join(', ')}</Text>\n                      </Text>\n                    </View>\n                  ) : null}\n\n                  {item.notes ? (\n                    <Text style={styles.notesText} numberOfLines={1}>\n                      Note: {item.notes}\n                    </Text>\n                  ) : null}\n                </View>\n\n                {/* Action Buttons Row */}\n                <View style={styles.cardActionsRow}>\n                  {item.source_image_uri ? (\n                    <TouchableOpacity\n                      style={styles.cardActionBtn}\n                      onPress={() => setPreviewImageUri(item.source_image_uri || null)}\n                    >\n                      <Eye size={15} color=\"#38BDF8\" />\n                      <Text style={[styles.cardActionBtnText, { color: '#38BDF8' }]}>Card</Text>\n                    </TouchableOpacity>\n                  ) : null}\n\n                  <TouchableOpacity\n                    style={styles.cardActionBtn}\n                    onPress={() => handleDialSingle(item)}\n                  >\n                    <MessageSquare size={15} color=\"#A78BFA\" />\n                    <Text style={[styles.cardActionBtnText, { color: '#A78BFA' }]}>AI Text</Text>\n                  </TouchableOpacity>\n\n                  <TouchableOpacity\n                    style={[styles.cardActionBtn, styles.callActionBtn]}\n                    onPress={() => handleDialSingle(item)}\n                  >\n                    <PhoneCall size={15} color=\"#FFFFFF\" />\n                    <Text style={[styles.cardActionBtnText, { color: '#FFFFFF', fontWeight: '700' }]}>\n                      Call ({item.phone})\n                    </Text>\n                  </TouchableOpacity>\n\n                  <TouchableOpacity\n                    style={styles.deleteLeadBtn}\n                    onPress={() => handleDeleteLead(item.id, item.name)}\n                  >\n                    <Trash2 size={16} color=\"#EF4444\" />\n                  </TouchableOpacity>\n                </View>\n              </TouchableOpacity>\n            );\n          }}\n        />\n      )}\n\n      {/* Original Report Card Photo Modal */}\n      <Modal visible={!!previewImageUri} transparent animationType=\"fade\">\n        <View style={styles.modalBackdrop}>\n          <SafeAreaView style={styles.modalSafeContainer}>\n            <View style={styles.modalHeader}>\n              <Text style={styles.modalTitle}>Original ValuTeachers Card</Text>\n              <TouchableOpacity\n                style={styles.modalCloseBtn}\n                onPress={() => setPreviewImageUri(null)}\n              >\n                <X size={24} color=\"#F8FAFC\" />\n              </TouchableOpacity>\n            </View>\n            <View style={styles.modalImageContainer}>\n              {previewImageUri && (\n                <Image\n                  source={{ uri: previewImageUri }}\n                  style={styles.modalImage}\n                  resizeMode=\"contain\"\n                />\n              )}\n            </View>\n          </SafeAreaView>\n        </View>\n      </Modal>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 12,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  titleArea: {\n    flex: 1,\n  },\n  appTitle: {\n    fontSize: 22,\n    fontWeight: '800',\n    color: '#F8FAFC',\n    letterSpacing: -0.5,\n  },\n  appSubtitle: {\n    fontSize: 12,\n    fontWeight: '600',\n    color: '#38BDF8',\n  },\n  headerIcons: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 10,\n  },\n  snapHeaderButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#2563EB',\n    paddingVertical: 8,\n    paddingHorizontal: 14,\n    borderRadius: 20,\n    gap: 6,\n  },\n  snapHeaderButtonText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 13,\n  },\n  iconButton: {\n    padding: 6,\n  },\n  statsRow: {\n    flexDirection: 'row',\n    backgroundColor: '#1E293B',\n    marginHorizontal: 16,\n    marginTop: 12,\n    borderRadius: 12,\n    paddingVertical: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  statCard: {\n    flex: 1,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  statNumber: {\n    fontSize: 18,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  statLabel: {\n    fontSize: 11,\n    color: '#94A3B8',\n    fontWeight: '600',\n    marginTop: 2,\n  },\n  ctaContainer: {\n    paddingHorizontal: 16,\n    marginTop: 12,\n    gap: 8,\n  },\n  startQueueButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#10B981',\n    paddingVertical: 14,\n    paddingHorizontal: 16,\n    borderRadius: 14,\n    gap: 12,\n    shadowColor: '#10B981',\n    shadowOpacity: 0.25,\n    shadowRadius: 8,\n  },\n  startQueueTitle: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '800',\n  },\n  startQueueSubtitle: {\n    color: 'rgba(255, 255, 255, 0.85)',\n    fontSize: 12,\n    marginTop: 2,\n  },\n  recycleButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: 'rgba(245, 158, 11, 0.1)',\n    borderWidth: 1,\n    borderColor: '#F59E0B',\n    borderRadius: 10,\n    paddingVertical: 8,\n    gap: 6,\n  },\n  recycleText: {\n    color: '#FBBF24',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  searchContainer: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#1E293B',\n    marginHorizontal: 16,\n    marginTop: 12,\n    paddingHorizontal: 12,\n    paddingVertical: 10,\n    borderRadius: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 8,\n  },\n  searchInput: {\n    flex: 1,\n    color: '#F8FAFC',\n    fontSize: 14,\n  },\n  tabsContainer: {\n    marginTop: 10,\n  },\n  tabsContent: {\n    paddingHorizontal: 16,\n    gap: 8,\n  },\n  tabChip: {\n    paddingVertical: 6,\n    paddingHorizontal: 14,\n    borderRadius: 20,\n    backgroundColor: '#1E293B',\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  tabChipActive: {\n    backgroundColor: '#2563EB',\n    borderColor: '#3B82F6',\n  },\n  tabChipText: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: '#94A3B8',\n  },\n  tabChipTextActive: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n  },\n  leadCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 14,\n    padding: 14,\n    marginBottom: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  cardHeaderRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'flex-start',\n  },\n  leadName: {\n    fontSize: 17,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  metaRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n    marginTop: 3,\n  },\n  leadSchool: {\n    fontSize: 13,\n    color: '#94A3B8',\n    fontWeight: '600',\n  },\n  dateAddedText: {\n    fontSize: 12,\n    color: '#64748B',\n  },\n  statusBadge: {\n    paddingVertical: 4,\n    paddingHorizontal: 10,\n    borderRadius: 12,\n  },\n  statusBadgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n  },\n  detailsBox: {\n    backgroundColor: '#0F172A',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 10,\n    gap: 4,\n  },\n  detailRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n  },\n  detailText: {\n    fontSize: 12,\n    color: '#94A3B8',\n  },\n  notesText: {\n    fontSize: 12,\n    color: '#64748B',\n    fontStyle: 'italic',\n    marginTop: 2,\n  },\n  cardActionsRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginTop: 12,\n    gap: 8,\n  },\n  cardActionBtn: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#0F172A',\n    paddingVertical: 8,\n    paddingHorizontal: 12,\n    borderRadius: 8,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 5,\n  },\n  cardActionBtnText: {\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  callActionBtn: {\n    flex: 1,\n    backgroundColor: '#2563EB',\n    borderColor: '#3B82F6',\n    justifyContent: 'center',\n  },\n  deleteLeadBtn: {\n    padding: 8,\n    borderRadius: 8,\n    backgroundColor: 'rgba(239, 68, 68, 0.1)',\n  },\n  centerContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    padding: 32,\n  },\n  loadingText: {\n    color: '#94A3B8',\n    marginTop: 12,\n    fontSize: 14,\n  },\n  emptyContainer: {\n    flex: 1,\n    alignItems: 'center',\n    justifyContent: 'center',\n    paddingHorizontal: 32,\n    marginTop: 40,\n  },\n  emptyTitle: {\n    color: '#F8FAFC',\n    fontSize: 18,\n    fontWeight: '700',\n    marginTop: 16,\n  },\n  emptyDesc: {\n    color: '#94A3B8',\n    fontSize: 13,\n    textAlign: 'center',\n    marginTop: 6,\n    lineHeight: 18,\n  },\n  emptyButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#2563EB',\n    paddingVertical: 12,\n    paddingHorizontal: 20,\n    borderRadius: 10,\n    marginTop: 20,\n    gap: 8,\n  },\n  emptyButtonText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 15,\n  },\n  modalBackdrop: {\n    flex: 1,\n    backgroundColor: 'rgba(0, 0, 0, 0.92)',\n  },\n  modalSafeContainer: {\n    flex: 1,\n  },\n  modalHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    paddingHorizontal: 20,\n    paddingVertical: 14,\n  },\n  modalTitle: {\n    color: '#F8FAFC',\n    fontSize: 18,\n    fontWeight: '700',\n  },\n  modalCloseBtn: {\n    padding: 6,\n  },\n  modalImageContainer: {\n    flex: 1,\n    justifyContent: 'center',\n   