{"step_index":537,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T17:51:38Z","content":"Created At: 2026-08-20T13:51:38-04:00\nCompleted At: 2026-08-20T13:51:38-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/documentScannerService.ts`\nTotal Lines: 121\nTotal Bytes: 3885\nShowing lines 1 to 121\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Platform } from 'react-native';\n2: import * as ImagePicker from 'expo-image-picker';\n3: \n4: export interface ScannedDocumentResult {\n5:   uri: string;\n6:   width?: number;\n7:   height?: number;\n8:   sizeBytes?: number;\n9: }\n10: \n11: export class DocumentScannerService {\n12:   /**\n13:    * Scans a paper document with native edge-detection, perspective correction, and shadow removal.\n14:    * - In Native Dev Builds: Uses Apple VisionKit / Google MLKit Document Scanner.\n15:    * - In Expo Go / Web: Uses Camera with interactive boundary cropping (allowsEditing).\n16:    */\n17:   static async scanDocument(): Promise<string | null> {\n18:     // 1. Try Native Document Scanner plugin (VisionKit on iOS / MLKit on Android)\n19:     if (Platform.OS !== 'web') {\n20:       try {\n21:         const DocumentScanner = await import('react-native-document-scanner-plugin');\n22:         if (DocumentScanner && DocumentScanner.default && DocumentScanner.default.scanDocument) {\n23:           const { scannedImages } = await DocumentScanner.default.scanDocument({\n24:             maxNumDocuments: 1,\n25:             letUserAdjustCrop: true,\n26:           });\n27:           if (scannedImages && scannedImages.length > 0) {\n28:             return await this.downsampleAndCompress(scannedImages[0]);\n29:           }\n30:         }\n31:       } catch (e) {\n32:         // Fall through to interactive camera cropper\n33:       }\n34:     }\n35: \n36:     // 2. Interactive Camera Cropper Fallback (Works in Expo Go & Standard Mobile)\n37:     const permission = await ImagePicker.requestCameraPermissionsAsync();\n38:     if (!permission.granted) {\n39:       throw new Error('Camera permission is required to scan lead sheets.');\n40:     }\n41: \n42:     const result = await ImagePicker.launchCameraAsync({\n43:       mediaTypes: ImagePicker.MediaTypeOptions.Images,\n44:       allowsEditing: true,\n45:       quality: 0.85,\n46:     });\n47: \n48:     if (!result.canceled && result.assets[0]) {\n49:       return await this.downsampleAndCompress(result.assets[0].uri);\n50:     }\n51: \n52:     return null;\n53:   }\n54: \n55:   /**\n56:    * Universal On-Device Downsampling & Compression Pipeline:\n57:    * Resizes raw 48MP iPhone photos (8MB–12MB) down to 1600px width JPEG (quality 0.75, <250KB)\n58:    * on-device before any API or OCR processing.\n59:    */\n60:   static async downsampleAndCompress(imageUri: string): Promise<string> {\n61:     if (Platform.OS === 'web') {\n62:       return await this.downsampleWebImage(imageUri, 1600, 0.75);\n63:     }\n64: \n65:     try {\n66:       const ImageManipulator = await import('expo-image-manipulator');\n67:       const manipulated = await ImageManipulator.manipulateAsync(\n68:         imageUri,\n69:         [{ resize: { width: 1600 } }],\n70:         { compress: 0.75, format: ImageManipulator.SaveFormat.JPEG }\n71:       );\n72:       return manipulated.uri;\n73:     } catch (e) {\n74:       console.warn('Native downsampling fallback to raw URI:', e);\n75:       return imageUri;\n76:     }\n77:   }\n78: \n79:   /**\n80:    * HTML5 Canvas based downsampling and compression for Web browser preview (<250KB)\n81:    */\n82:   private static async downsampleWebImage(\n83:     dataUri: string,\n84:     maxWidth: number = 1600,\n85:     quality: number = 0.75\n86:   ): Promise<string> {\n87:     return new Promise((resolve) => {\n88:       try {\n89:         const img = new Image();\n90:         img.crossOrigin = 'anonymous';\n91:         img.onload = () => {\n92:           let width = img.width;\n93:           let height = img.height;\n94: \n95:           if (width > maxWidth) {\n96:             height = Math.round((height * maxWidth) / width);\n97:             width = maxWidth;\n98:           }\n99: \n100:           const canvas = document.createElement('canvas');\n101:           canvas.width = width;\n102:           canvas.height = height;\n103: \n104:           const ctx = canvas.getContext('2d');\n105:           if (ctx) {\n106:             ctx.drawImage(img, 0, 0, width, height);\n107:             const compressed = canvas.toDataURL('image/jpeg', quality);\n108:             resolve(compressed);\n109:           } else {\n110:             resolve(dataUri);\n111:           }\n112:         };\n113:         img.onerror = () => resolve(dataUri);\n114:         img.src = dataUri;\n115:       } catch {\n116:         resolve(dataUri);\n117:       }\n118:     });\n119:   }\n120: }\n121: \nThe above content shows the entire, complete file contents of the requested file.\n"}
