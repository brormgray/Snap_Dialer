{"step_index":874,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T21:05:27Z","content":"Created At: 2026-08-20T17:05:27-04:00\nCompleted At: 2026-08-20T17:05:27-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/backupService.ts`\nTotal Lines: 114\nTotal Bytes: 3848\nShowing lines 1 to 114\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Share, Alert, Platform } from 'react-native';\n2: import { getDatabase } from '../db/database';\n3: import { LeadsRepository } from '../db/leadsRepository';\n4: import { SettingsRepository } from '../db/settingsRepository';\n5: import { CadenceRepository } from '../db/cadenceRepository';\n6: \n7: export class BackupService {\n8:   /**\n9:    * Generates a full snapshot of the local database and opens the OS Share Sheet\n10:    * to save to iCloud Drive, Google Drive, or local storage.\n11:    */\n12:   static async exportFullBackup(): Promise<boolean> {\n13:     try {\n14:       const db = await getDatabase();\n15:       const lists = await LeadsRepository.getAllLists();\n16:       const leads = await db.getAllAsync('SELECT * FROM leads');\n17:       const callLogs = await db.getAllAsync('SELECT * FROM call_logs');\n18:       const cadenceRules = await CadenceRepository.getAllRules();\n19:       const smsTemplates = await CadenceRepository.getAllTemplates();\n20:       const settings = await SettingsRepository.getSettings();\n21: \n22:       const backupPayload = {\n23:         version: '1.0.0',\n24:         exportedAt: new Date().toISOString(),\n25:         data: {\n26:           lists,\n27:           leads,\n28:           callLogs,\n29:           cadenceRules,\n30:           smsTemplates,\n31:           settings,\n32:         },\n33:       };\n34: \n35:       const jsonString = JSON.stringify(backupPayload, null, 2);\n36: \n37:       if (Platform.OS === 'web') {\n38:         // In web, download as a .json file\n39:         const blob = new Blob([jsonString], { type: 'application/json' });\n40:         const url = URL.createObjectURL(blob);\n41:         const a = document.createElement('a');\n42:         a.href = url;\n43:         a.download = `SnapDialer_Backup_${new Date().toISOString().slice(0, 10)}.json`;\n44:         a.click();\n45:         URL.revokeObjectURL(url);\n46:         return true;\n47:       }\n48: \n49:       await Share.share({\n50:         title: `SnapDialer_Backup_${new Date().toISOString().slice(0, 10)}.json`,\n51:         message: jsonString,\n52:       });\n53: \n54:       return true;\n55:     } catch (e) {\n56:       console.error('Backup export failed:', e);\n57:       Alert.alert('Backup Error', 'Failed to generate cloud backup snapshot.');\n58:       return false;\n59:     }\n60:   }\n61: \n62:   /**\n63:    * Restores a backup from JSON text\n64:    */\n65:   static async restoreBackupFromJson(jsonString: string): Promise<boolean> {\n66:     try {\n67:       const parsed = JSON.parse(jsonString);\n68:       if (!parsed?.data?.lists || !parsed?.data?.leads) {\n69:         throw new Error('Invalid backup schema');\n70:       }\n71: \n72:       const db = await getDatabase();\n73:       await db.withTransactionAsync(async () => {\n74:         // Import lists\n75:         for (const l of parsed.data.lists) {\n76:           await db.runAsync(\n77:             `INSERT INTO lists (id, title, source_image_uri, total_leads, completed_leads, connected_leads, created_at, updated_at)\n78:              VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n79:              ON CONFLICT(id) DO UPDATE SET title = excluded.title`,\n80:             [l.id, l.title, l.source_image_uri, l.total_leads, l.completed_leads, l.connected_leads, l.created_at, l.updated_at]\n81:           );\n82:         }\n83: \n84:         // Import leads\n85:         for (const lead of parsed.data.leads) {\n86:           await db.runAsync(\n87:             `INSERT INTO leads (id, list_id, name, phone, company, notes, cadence_step, last_disposition, attempts_count, created_at, updated_at)\n88:              VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n89:              ON CONFLICT(id) DO UPDATE SET last_disposition = excluded.last_disposition`,\n90:             [\n91:               lead.id,\n92:               lead.list_id,\n93:               lead.name,\n94:               lead.phone,\n95:               lead.company,\n96:               lead.notes,\n97:               lead.cadence_step,\n98:               lead.last_disposition,\n99:               lead.attempts_count,\n100:               lead.created_at,\n101:               lead.updated_at,\n102:             ]\n103:           );\n104:         }\n105:       });\n106: \n107:       return true;\n108:     } catch (e) {\n109:       console.error('Restore failed:', e);\n110:       return false;\n111:     }\n112:   }\n113: }\n114: \nThe above content shows the entire, complete file contents of the requested file.\n"}
