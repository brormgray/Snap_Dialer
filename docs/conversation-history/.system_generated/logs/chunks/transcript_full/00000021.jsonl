|| '');\n45:     setUserName(s.user_name || 'Alex');\n46:     setAutoAdvanceEnabled(s.auto_advance_enabled);\n47:     setAutoAdvanceSeconds(String(s.auto_advance_seconds || 3));\n48:   };\n49: \n50:   const [savedBanner, setSavedBanner] = useState<boolean>(false);\n51: \n52:   const handleSaveAll = async () => {\n53:     await HapticsService.success();\n54:     await SettingsRepository.saveSetting('gemini_api_key', apiKey.trim());\n55:     await SettingsRepository.saveSetting('user_name', userName.trim() || 'Alex');\n56:     await SettingsRepository.saveSetting('auto_advance_enabled', autoAdvanceEnabled ? '1' : '0');\n57:     await SettingsRepository.saveSetting(\n58:       'auto_advance_seconds',\n59:       parseInt(autoAdvanceSeconds, 10) || 3\n60:     );\n61:     setSavedBanner(true);\n62:     setTimeout(() => setSavedBanner(false), 3000);\n63:     Alert.alert('Settings Saved', `Caller name updated to \"${userName.trim() || 'Alex'}\" and preferences saved.`);\n64:   };\n65: \n66:   const handleExportBackup = async () => {\n67:     await HapticsService.medium();\n68:     const success = await BackupService.exportFullBackup();\n69:     if (success) {\n70:       await HapticsService.success();\n71:     }\n72:   };\n73: \n74:   const handleClearAllData = async () => {\n75:     const doClear = async () => {\n76:       await HapticsService.heavy();\n77:       if (typeof window !== 'undefined' && window.localStorage) {\n78:         localStorage.removeItem('snap_dialer_valuteachers_data');\n79:       }\n80:       const db = await import('../db/database').then((m) => m.getDatabase());\n81:       await db.runAsync('DELETE FROM leads');\n82:       await db.runAsync('DELETE FROM lists');\n83:       await db.runAsync('DELETE FROM call_logs');\n84:       Alert.alert('Data Cleared', 'All test contacts, lists, and logs have been wiped.');\n85:     };\n86: \n87:     if (Platform.OS === 'web') {\n88:       const confirmed = typeof window !== 'undefined' && window.confirm('Are you sure you want to permanently clear all leads and history?');\n89:       if (confirmed) {\n90:         await doClear();\n91:       }\n92:       return;\n93:     }\n94: \n95:     Alert.alert(\n96:       'Clear All Pipeline Data',\n97:       'This will permanently delete all leads, notes, and call records from your device.',\n98:       [\n99:         { text: 'Cancel', style: 'cancel' },\n100:         { text: 'Clear Everything', style: 'destructive', onPress: doClear },\n101:       ]\n102:     );\n103:   };\n104: \n105:   return (\n106:     <SafeAreaView style={styles.container}>\n107:       <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n108: \n109:       {/* Header */}\n110:       <View style={styles.header}>\n111:         <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n112:           <ArrowLeft size={22} color=\"#F8FAFC\" />\n113:         </TouchableOpacity>\n114:         <Text style={styles.headerTitle}>Global Settings</Text>\n115:         <TouchableOpacity onPress={handleSaveAll}>\n116:           <Text style={styles.saveLink}>Save</Text>\n117:         </TouchableOpacity>\n118:       </View>\n119: \n120:       {savedBanner && (\n121:         <View style={{ backgroundColor: '#10B981', paddingVertical: 10, paddingHorizontal: 16, alignItems: 'center' }}>\n122:           <Text style={{ color: '#FFFFFF', fontWeight: '700', fontSize: 13 }}>\n123:             ✓ Settings & Name Saved Successfully!\n124:           </Text>\n125:         </View>\n126:       )}\n127: \n128:       <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n129:         {/* Gemini Vision API Key */}\n130:         <Text style={styles.sectionHeader}>VISION AI PARSER CONFIGURATION</Text>\n131:         <View style={styles.card}>\n132:           <View style={styles.cardHeaderRow}>\n133:             <Key size={18} color=\"#3B82F6\" />\n134:             <Text style={styles.cardTitle}>Google Gemini API Key</Text>\n135:           </View>\n136:           <Text style={styles.cardDesc}>\n137:             Used to extract contacts from photos of paper lead sheets with 99%+ accuracy (free tier from Google AI Studio).\n138:           </Text>\n139:           <TextInput\n140:             style={styles.input}\n141:             placeholder=\"AIzaSy...\"\n142:             placeholderTextColor=\"#64748B\"\n143:             value={apiKey}\n144:             onChangeText={setApiKey}\n145:             secureTextEntry\n146:           />\n147:         </View>\n148: \n149:         {/* User Profile for SMS Tokens */}\n150:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>CALLER PROFILE (SMS TEMPLATES)</Text>\n151:         <View style={styles.card}>\n152:           <View style={styles.cardHeaderRow}>\n153:             <User size={18} color=\"#10B981\" />\n154:             <Text style={styles.cardTitle}>Your Name / Signature</Text>\n155:           </View>\n156:           <Text style={styles.cardDesc}>\n157:             Automatically replaces <Text style={styles.tokenTag}>{'{{my_name}}'}</Text> in follow-up SMS templates.\n158:           </Text>\n159:           <TextInput\n160:             style={styles.input}\n161:             placeholder=\"e.g. Alex\"\n162:             placeholderTextColor=\"#64748B\"\n163:             value={userName}\n164:             onChangeText={setUserName}\n165:           />\n166:         </View>\n167: \n168:         {/* Power Dialer Pacing Controls */}\n169:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>POWER DIALER PACING CONTROLS</Text>\n170:         <View style={styles.card}>\n171:           <View style={styles.switchRow}>\n172:             <View style={{ flex: 1 }}>\n173:               <Text style={styles.cardTitle}>Auto-Advance Countdown</Text>\n174:               <Text style={styles.cardDesc}>\n175:                 Automatically queue next lead after call outcome is logged\n176:               </Text>\n177:             </View>\n178:             <Switch\n179:               value={autoAdvanceEnabled}\n180:               onValueChange={(val) => {\n181:                 HapticsService.tick();\n182:                 setAutoAdvanceEnabled(val);\n183:               }}\n184:               trackColor={{ false: '#334155', true: '#2563EB' }}\n185:             />\n186:           </View>\n187: \n188:           {autoAdvanceEnabled && (\n189:             <View style={[styles.inputRow, { marginTop: 12 }]}>\n190:               <Timer size={18} color=\"#94A3B8\" />\n191:               <Text style={styles.inlineLabel}>Countdown Buffer (seconds):</Text>\n192:               <TextInput\n193:                 style={[styles.input, { width: 60, textAlign: 'center' }]}\n194:                 value={autoAdvanceSeconds}\n195:                 onChangeText={setAutoAdvanceSeconds}\n196:                 keyboardType=\"numeric\"\n197:               />\n198:             </View>\n199:           )}\n200:         </View>\n201: \n202:         {/* Cloud & Drive Backup */}\n203:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DATA BACKUP & CLOUD STORAGE</Text>\n204:         <View style={styles.card}>\n205:           <View style={styles.cardHeaderRow}>\n206:             <Cloud size={18} color=\"#38BDF8\" />\n207:             <Text style={styles.cardTitle}>Database Snapshot Backup</Text>\n208:           </View>\n209:           <Text style={styles.cardDesc}>\n210:             Export your entire lead database, call history, and templates to iCloud Drive, Google Drive, or your Files app.\n211:           </Text>\n212:           <TouchableOpacity style={styles.backupButton} onPress={handleExportBackup}>\n213:             <Share2 size={18} color=\"#FFFFFF\" />\n214:             <Text style={styles.backupButtonText}>Export Backup Snapshot</Text>\n215:           </TouchableOpacity>\n216:         </View>\n217: \n218:         {/* Data Management */}\n219:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DATA MANAGEMENT</Text>\n220:         <TouchableOpacity style={[styles.demoResetButton, { backgroundColor: 'rgba(239, 68, 68, 0.1)', borderColor: '#EF4444' }]} onPress={handleClearAllData}>\n221:           <Trash2 size={18} color=\"#EF4444\" />\n222:           <Text style={[styles.demoResetText, { color: '#EF4444' }]}>Wipe All Leads & Start Fresh</Text>\n223:         </TouchableOpacity>\n224:       </ScrollView>\n225:     </SafeAreaView>\n226:   );\n227: }\n228: \n229: const styles = StyleSheet.create({\n230:   container: {\n231:     flex: 1,\n232:     backgroundColor: '#0F172A',\n233:   },\n234:   header: {\n235:     flexDirection: 'row',\n236:     alignItems: 'center',\n237:     justifyContent: 'space-between',\n238:     paddingHorizontal: 16,\n239:     paddingVertical: 14,\n240:     borderBottomWidth: 1,\n241:     borderBottomColor: '#1E293B',\n242:   },\n243:   backButton: {\n244:     padding: 8,\n245:   },\n246:   headerTitle: {\n247:     fontSize: 18,\n248:     fontWeight: '700',\n249:     color: '#F8FAFC',\n250:   },\n251:   saveLink: {\n252:     color: '#10B981',\n253:     fontWeight: '700',\n254:     fontSize: 15,\n255:   },\n256:   content: {\n257:     flex: 1,\n258:     padding: 16,\n259:   },\n260:   sectionHeader: {\n261:     color: '#64748B',\n262:     fontSize: 12,\n263:     fontWeight: '700',\n264:     letterSpacing: 1,\n265:     marginBottom: 8,\n266:   },\n267:   card: {\n268:     backgroundColor: '#1E293B',\n269:     borderRadius: 14,\n270:     padding: 16,\n271:     borderWidth: 1,\n272:     borderColor: '#334155',\n273:   },\n274:   cardHeaderRow: {\n275:     flexDirection: 'row',\n276:     alignItems: 'center',\n277:     gap: 8,\n278:     marginBottom: 6,\n279:   },\n280:   cardTitle: {\n281:     fontSize: 16,\n282:     fontWeight: '700',\n283:     color: '#F8FAFC',\n284:   },\n285:   cardDesc: {\n286:     fontSize: 13,\n287:     color: '#94A3B8',\n288:     lineHeight: 18,\n289:     marginBottom: 10,\n290:   },\n291:   tokenTag: {\n292:     color: '#38BDF8',\n293:     fontWeight: '600',\n294:   },\n295:   input: {\n296:     backgroundColor: '#0F172A',\n297:     color: '#F8FAFC',\n298:     borderRadius: 8,\n299:     padding: 12,\n300:     borderWidth: 1,\n301:     borderColor: '#334155',\n302:     fontSize: 14,\n303:   },\n304:   switchRow: {\n305:     flexDirection: 'row',\n306:     justifyContent: 'space-between',\n307:     alignItems: 'center',\n308:   },\n309:   inputRow: {\n310:     flexDirection: 'row',\n311:     alignItems: 'center',\n312:     gap: 10,\n313:   },\n314:   inlineLabel: {\n315:     color: '#CBD5E1',\n316:     fontSize: 14,\n317:     flex: 1,\n318:   },\n319:   backupButton: {\n320:     flexDirection: 'row',\n321:     alignItems: 'center',\n322:     justifyContent: 'center',\n323:     backgroundColor: '#2563EB',\n324:     paddingVertical: 14,\n325:     borderRadius: 10,\n326:     marginTop: 6,\n327:     gap: 8,\n328:   },\n329:   backupButtonText: {\n330:     color: '#FFFFFF',\n331:     fontWeight: '700',\n332:     fontSize: 15,\n333:   },\n334:   demoResetButton: {\n335:     flexDirection: 'row',\n336:     alignItems: 'center',\n337:     justifyContent: 'center',\n338:     backgroundColor: '#1E293B',\n339:     borderWidth: 1,\n340:     borderColor: '#38BDF8',\n341:     paddingVertical: 14,\n342:     borderRadius: 12,\n343:     gap: 8,\n344:   },\n345:   demoResetText: {\n346:     color: '#38BDF8',\n347:     fontSize: 15,\n348:     fontWeight: '700',\n349:   },\n350: });\n351: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":883,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-20T21:05:45Z","thinking":"**Considering Backup Functionality**\n\nI'm currently focused on enhancing the SettingsScreen.tsx file. I'm aiming to add robust backup, export, and import features using files and JSON. I've also begun reviewing the icons I'll be implementing: ArrowLeft, Key, User, Timer, Sparkles, Cloud, and Download.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  SafeAreaView,\n  StatusBar,\n  ScrollView,\n  TouchableOpacity,\n  TextInput,\n  Switch,\n  Alert,\n  Modal,\n  Platform,\n} from 'react-native';\nimport {\n  ArrowLeft,\n  Key,\n  User,\n  Timer,\n  Cloud,\n  Download,\n  Share2,\n  Trash2,\n  Upload,\n  Copy,\n  Check,\n  Database,\n  X,\n} from 'lucide-react-native';\nimport { SettingsRepository } from '../db/settingsRepository';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { BackupService, RestoreResult } from '../services/backupService';\nimport { HapticsService } from '../services/hapticsService';\n\nexport default function SettingsScreen({ navigation }: any) {\n  const [apiKey, setApiKey] = useState<string>('');\n  const [userName, setUserName] = useState<string>('Alex');\n  const [autoAdvanceEnabled, setAutoAdvanceEnabled] = useState<boolean>(true);\n  const [autoAdvanceSeconds, setAutoAdvanceSeconds] = useState<string>('3');\n\n  // Status Banners\n  const [savedBanner, setSavedBanner] = useState<string | null>(null);\n\n  // Paste JSON Modal\n  const [pasteModalVisible, setPasteModalVisible] = useState<boolean>(false);\n  const [pastedJson, setPastedJson] = useState<string>('');\n  const [isRestoring, setIsRestoring] = useState<boolean>(false);\n\n  useEffect(() => {\n    loadSettings();\n  }, []);\n\n  const loadSettings = async () => {\n    const s = await SettingsRepository.getSettings();\n    setApiKey(s.gemini_api_key || '');\n    setUserName(s.user_name || 'Alex');\n    setAutoAdvanceEnabled(s.auto_advance_enabled);\n    setAutoAdvanceSeconds(String(s.auto_advance_seconds || 3));\n  };\n\n  const showBanner = (msg: string) => {\n    setSavedBanner(msg);\n    setTimeout(() => setSavedBanner(null), 3500);\n  };\n\n  const handleSaveAll = async () => {\n    await HapticsService.success();\n    await SettingsRepository.saveSetting('gemini_api_key', apiKey.trim());\n    await SettingsRepository.saveSetting('user_name', userName.trim() || 'Alex');\n    await SettingsRepository.saveSetting('auto_advance_enabled', autoAdvanceEnabled ? '1' : '0');\n    await SettingsRepository.saveSetting(\n      'auto_advance_seconds',\n      parseInt(autoAdvanceSeconds, 10) || 3\n    );\n    showBanner('✓ Settings & Caller Name Saved!');\n    Alert.alert('Settings Saved', `Caller name updated to \"${userName.trim() || 'Alex'}\" and preferences saved.`);\n  };\n\n  // 1. Export Backup to iCloud / Google Drive / Files / Share\n  const handleExportBackup = async () => {\n    await HapticsService.medium();\n    const success = await BackupService.exportFullBackup();\n    if (success) {\n      await HapticsService.success();\n      showBanner('✓ Database Backup Exported Successfully!');\n    }\n  };\n\n  // 2. Copy Backup JSON to Clipboard\n  const handleCopyBackupToClipboard = async () => {\n    try {\n      await HapticsService.tick();\n      const payload = await BackupService.generateBackupPayload();\n      const jsonStr = JSON.stringify(payload, null, 2);\n\n      if (typeof navigator !== 'undefined' && navigator.clipboard) {\n        await navigator.clipboard.writeText(jsonStr);\n        await HapticsService.success();\n        showBanner(`✓ Copied full backup JSON (${payload.leadCount} leads) to clipboard!`);\n        Alert.alert('Copied to Clipboard', 'You can now paste this backup text into an email, OneDrive doc, or Google Keep.');\n      } else {\n        Alert.alert('Backup JSON', jsonStr.slice(0, 500) + '...');\n      }\n    } catch (e: any) {\n      Alert.alert('Copy Error', e?.message || 'Could not copy to clipboard.');\n    }\n  };\n\n  // 3. Import Backup from File (iCloud / Google Drive / Files / Local)\n  const handleImportFromFile = async () => {\n    await HapticsService.tick();\n\n    const doImport = async (overwrite: boolean) => {\n      setIsRestoring(true);\n      try {\n        const res: RestoreResult = await BackupService.importBackupFromFile(overwrite);\n        setIsRestoring(false);\n        if (res.success) {\n          await HapticsService.success();\n          showBanner(`✓ ${res.message}`);\n          Alert.alert('Restore Complete', res.message);\n        } else if (res.message !== 'No file selected.') {\n          Alert.alert('Import Failed', res.message);\n        }\n      } catch (err: any) {\n        setIsRestoring(false);\n        Alert.alert('Import Error', err?.message || 'Failed to import backup file.');\n      }\n    };\n\n    if (Platform.OS === 'web') {\n      const choice = typeof window !== 'undefined' && window.confirm(\n        'Click OK to MERGE imported leads with existing database, or Cancel to replace your entire database.'\n      );\n      await doImport(!choice);\n      return;\n    }\n\n    Alert.alert(\n      'Import Backup File',\n      'Choose how you want to restore this backup:',\n      [\n        { text: 'Cancel', style: 'cancel' },\n        { text: 'Merge with Existing', onPress: () => doImport(false) },\n        { text: 'Clean Replace (Overwrite)', style: 'destructive', onPress: () => doImport(true) },\n      ]\n    );\n  };\n\n  // 4. Import Backup from Pasted Text\n  const handleRestorePastedJson = async (overwrite: boolean) => {\n    if (!pastedJson.trim()) {\n      Alert.alert('Empty Input', 'Please paste valid backup JSON text.');\n      return;\n    }\n\n    setIsRestoring(true);\n    try {\n      const res = await BackupService.restoreBackupFromJson(pastedJson.trim(), overwrite);\n      setIsRestoring(false);\n      if (res.success) {\n        setPasteModalVisible(false);\n        setPastedJson('');\n        awa