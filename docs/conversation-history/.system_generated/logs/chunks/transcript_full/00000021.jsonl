odalVisible] = useState<boolean>(false);\n34:   const [pastedText, setPastedText] = useState<string>('');\n35: \n36:   const takePhoto = async () => {\n37:     await HapticsService.tick();\n38:     try {\n39:       const scannedUri = await DocumentScannerService.scanDocument();\n40:       if (scannedUri) {\n41:         handleImageCaptured(scannedUri);\n42:       }\n43:     } catch (e: any) {\n44:       Alert.alert('Scanner Error', e?.message || 'Failed to scan document.');\n45:     }\n46:   };\n47: \n48:   const pickImage = async () => {\n49:     await HapticsService.tick();\n50:     const result = await ImagePicker.launchImageLibraryAsync({\n51:       mediaTypes: ImagePicker.MediaTypeOptions.Images,\n52:       allowsEditing: true,\n53:       quality: 0.85,\n54:     });\n55: \n56:     if (!result.canceled && result.assets[0]) {\n57:       const optimizedUri = await DocumentScannerService.downsampleAndCompress(result.assets[0].uri);\n58:       handleImageCaptured(optimizedUri);\n59:     }\n60:   };\n61: \n62:   const handleImageCaptured = async (uri: string) => {\n63:     setImageUri(uri);\n64:     setIsProcessing(true);\n65:     try {\n66:       const leads = await VisionService.extractLeadsFromImage(uri, apiKey);\n67:       await HapticsService.success();\n68:       setExtractedLeads(leads);\n69:       setHasScanned(true);\n70:     } catch (e: any) {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
