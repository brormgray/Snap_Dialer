his.cadence_rules = Array.isArray(parsed.cadence_rules) ? parsed.cadence_rules : [];\n34:           this.sms_templates = Array.isArray(parsed.sms_templates) ? parsed.sms_templates : [];\n35:           this.settings = Array.isArray(parsed.settings) ? parsed.settings : [];\n36:         }\n37:       }\n38:     } catch (e) {\n39:       console.warn('Web localStorage load failed, initializing clean database:', e);\n40:       this.lists = [];\n41:       this.leads = [];\n42:       this.call_logs = [];\n43:       this.cadence_rules = [];\n44:       this.sms_templates = [];\n45:       this.settings = [];\n46:     }\n47:   }\n48: \n49:   private saveToStorage() {\n50:     try {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
