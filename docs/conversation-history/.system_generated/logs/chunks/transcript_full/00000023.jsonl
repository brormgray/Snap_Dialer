oicemail or No Answer so you can run another call pass?',\n176:       [\n177:         { text: 'Cancel', style: 'cancel' },\n178:         { text: 'Recycle Leads', onPress: doRecycle },\n179:       ]\n180:     );\n181:   };\n182: \n183:   const getStatusBadge = (lead: Lead) => {\n184:     const disp = lead.last_disposition;\n185:     if (disp === 'connected') {\n186:       return { label: 'Sit-Down Set', bg: '#064E3B', color: '#34D399' };\n187:     }\n188:     if (disp === 'callback_requested' || lead.follow_up_at) {\n189:       return { label: 'Callback Scheduled', bg: '#451A03', color: '#FBBF24' };\n190:     }\n191:     if (disp === 'voicemail') {\n192:       return { label: `Voicemail (${lead.attempts_count})`, bg: '#1E293B', color: '#94A3B8' };\n193:     }\n194:     if (disp === 'no_answer') {\n195:       return { label: `No Answer (${lead.attempts_count})`, bg: '#1E293B', color: '#94A3B8' };\n196:     }\n197:     if (disp === 'do_not_call') {\n198:       return { label: 'Do Not Call', bg: '#7F1D1D', color: '#FCA5A5' };\n199:     }\n200:     return { label: 'Ready to Call', bg: '#1E3A8A', color: '#60A5FA' };\n201:   };\n202: \n203:   // Stats calculation\n204:   const totalCount = leads.length;\n205:   const pendingCount = leads.filter(\n206:     (l) => !l.last_disposition || ['pending', 'no_answer', 'voicemail'].includes(l.last_disposition)\n207:   ).length;\n208:   const connectedCount = leads.filter((l) => l.last_disposition === 'connected').length;\n209:   const callbackCount = leads.filter((l) => l.last_disposition === 'callback_requested' || !!l.follow_up_at).length;\n210:   const unansweredCount = leads.filter((l) => ['no_answer', 'voicemail'].includes(l.last_disposition || '')).length;\n211: \n212:   return (\n213:     <SafeAreaView style={styles.container}>\n214:       <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n215: \n216:       {/* App Header */}\n217:       <View style={styles.header}>\n218:         <View style={styles.titleArea}>\n219:           <Text style={styles.appTitle}>SnapDialer</Text>\n220:           <Text style={styles.appSubtitle}>ValuTeachers • Florida FRS</Text>\n221:         </View>\n222:         <View style={styles.headerIcons}>\n223:           <TouchableOpacity\n224:             style={styles.snapHeaderButton}\n225:             onPress={() => {\n226:               HapticsService.medium();\n227:               navigation.navigate('ScanSheet');\n228:             }}\n229:           >\n230:             <Camera size={18} color=\"#FFFFFF\" />\n231:             <Text style={styles.snapHeaderButtonText}>Snap Sheet</Text>\n232:           </TouchableOpacity>\n233:           <TouchableOpacity\n234:             style={styles.iconButton}\n235:             onPress={() => navigation.navigate('Settings')}\n236:           >\n237:             <Settings size={22} color=\"#94A3B8\" />\n238:           </TouchableOpacity>\n239:         </View>\n240:       </View>\n241: \n242:       {/* KPI Stats Strip */}\n243:       <View style={styles.statsRow}>\n244:         <View style={styles.statCard}>\n245:           <Text style={styles.statNumber}>{totalCount}</Text>\n246:           <Text style={styles.statLabel}>Educators</Text>\n247:         </View>\n248:         <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: '#334155' }]}>\n249:           <Text style={[styles.statNumber, { color: '#38BDF8' }]}>{pendingCount}</Text>\n250:           <Text style={styles.statLabel}>To Call</Text>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
