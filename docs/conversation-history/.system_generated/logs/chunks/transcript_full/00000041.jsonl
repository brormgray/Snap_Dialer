   imageUri: string,\n35:     providedApiKey?: string\n36:   ): Promise<ExtractedLeadItem[]> {\n37:     let key = providedApiKey;\n38:     if (!key || key.trim().length === 0) {\n39:       const settings = await SettingsRepository.getSettings();\n40:       key = settings.gemini_api_key;\n41:     }\n42: \n43:     if (!key || key.trim().length === 0) {\n44:       throw new Error(\n45:         'Gemini API Key missing. Please go to Settings (gear icon in the top right) and enter your free Gemini API Key from Google AI Studio to extract lead sheets.'\n46:       );\n47:     }\n48: \n49:     return await this.extractWithGemini(imageUri, key.trim());\n50:   }\n51: \n52:   /**\n53:    * Specialized ValuTeachers & Florida Retirement System (FRS) Vision AI Pipeline\n54:    */\n55:   private static async extractWithGemini(\n56:     rawImageUri: string,\n57:     apiKey: string\n58:   ): Promise<ExtractedLeadItem[]> {\n59:     const optimizedUri = await this.optimizeImageForOCR(rawImageUri);\n60:     let base64Image = '';\n61: \n62:     if (optimizedUri.startsWith('data:')) {\n63:       base64Image = optimizedUri.split(',')[1] || '';\n64:     } else if (Platform.OS === 'web') {\n65:       const response = await fetch(optimizedUri);\n66:       const blob = await response.blob();\n67:       base64Image = await new Promise<string>((resolve, reject) => {\n68:         const reader = new FileReader();\n69:         reader.onloadend = () => {\n70:           const res = reader.result as string;\n71:           resolve(res.split(',')[1] || '');\n72:         };\n73:         reader.onerror = reject;\n74:   