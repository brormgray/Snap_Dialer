moExtractedLeads());\n      setHasScanned(true);\n    } finally {\n      setIsProcessing(false);\n    }\n  };\n\n  const handleUpdateLead = (index: number, field: keyof ExtractedLeadItem, value: string) => {\n    const updated = [...extractedLeads];\n    updated[index] = { ...updated[index], [field]: value };\n    setExtractedLeads(updated);\n  };\n\n  const handleDeleteRow = (index: number) => {\n    setExtractedLeads(extractedLeads.filter((_, i) => i !== index));\n  };\n\n  const handleAddRow = () => {\n    setExtractedLeads([\n      ...extractedLeads,\n      {\n        id: `manual_${Date.now()}`,\n        name: '',\n        phone: '',\n        company: '',\n        notes: '',\n        isValid: true,\n      },\n    ]);\n  };\n\n  const handleSaveAndDial = async () => {\n    const validLeads = extractedLeads.filter((l) => l.name.trim() && l.phone.trim());\n    if (validLeads.length === 0) {\n      Alert.alert('No valid leads', 'Please provide at least one contact with a valid name and phone number.');\n      return;\n    }\n\n    try {\n      const newList = await LeadsRepository.createListWithLeads(\n        listTitle.trim() || 'Scanned Lead Sheet',\n        imageUri,\n        validLeads\n      );\n\n      Alert.alert(\n        'List Saved!',\n        `Successfully imported ${validLeads.length} leads into local SQLite.`,\n        [\n          {\n            text: 'Start Power Dialing Now',\n            onPress: () =>\n              navigation.replace('DialerHUD', {\n                listId: newList.id,\n                listTitle: newList.title,\n              }),\n          },\n          {\n            text: 'Go to Lists',\n            onPress: () => navigation.navigate('Lists'),\n            style: 'cancel',\n          },\n        ]\n      );\n    } catch (e) {\n      console.error(e);\n      Alert.alert('Error', 'Failed to save leads to local database.');\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>\n          {!hasScanned ? 'Snap Lead Sheet' : 'Verify & Clean Leads'}\n        </Text>\n        <View style={{ width: 40 }} />\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {!hasScanned ? (\n          <View style={styles.captureSection}>\n            <View style={styles.instructionsBox}>\n              <Sparkles size={20} color=\"#3B82F6\" />\n              <Text style={styles.instructionText}>\n                Take a photo of any printed call list, sign-in sheet, or handwritten log. Antigravity will extract names and phone numbers automatically.\n              </Text>\n            </View>\n\n            {/* Camera Options */}\n            <View style={styles.buttonGroup}>\n              <TouchableOpacity style={styles.captureButton} onPress={takePhoto} activeOpacity={0.8}>\n                <Camera size={32} color=\"#FFFFFF\" />\n                <Text style={styles.captureButtonText}>Take Photo of Sheet</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity style={styles.secondaryCaptureButton} onPress={pickImage}>\n                <ImageIcon size={24} color=\"#94A3B8\" />\n                <Text style={styles.secondaryCaptureButtonText}>Pick from Photo Library</Text>\n              </TouchableOpacity>\n            </View>\n\n            {/* Optional API Key Input */}\n            <View style={styles.apiKeyContainer}>\n              <Text style={styles.apiKeyLabel}>Gemini Vision API Key (Optional)</Text>\n              <TextInput\n                style={styles.input}\n                placeholder=\"Leave blank to use smart offline demo extractor\"\n                placeholderTextColor=\"#64748B\"\n                value={apiKey}\n                onChangeText={setApiKey}\n                secureTextEntry\n              />\n              <Text style={styles.apiKeyHint}>\n                If left blank, pre-loaded sample leads will be extracted for immediate testing.\n              </Text>\n            </View>\n          </View>\n        ) : isProcessing ? (\n          <View style={styles.loadingContainer}>\n            <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n            <Text style={styles.loadingText}>Extracting contacts from sheet...</Text>\n          </View>\n        ) : (\n          <View style={styles.reviewSection}>\n            {/* List Title Input */}\n            <Text style={styles.fieldLabel}>List Name</Text>\n            <TextInput\n              style={styles.input}\n              value={listTitle}\n              onChangeText={setListTitle}\n              placeholder=\"e.g. Open House Leads - June 2026\"\n              placeholderTextColor=\"#64748B\"\n            />\n\n            {/* Extracted Leads Header */}\n            <View style={styles.tableHeader}>\n              <Text style={styles.tableTitle}>\n                Detected Contacts ({extractedLeads.length})\n              </Text>\n              <TouchableOpacity style={styles.addRowButton} onPress={handleAddRow}>\n                <Plus size={16} color=\"#3B82F6\" />\n                <Text style={styles.addRowText}>Add Lead</Text>\n              </TouchableOpacity>\n            </View>\n\n            {/* Editable Rows */}\n            {extractedLeads.map((item, index) => (\n              <View key={item.id || index} style={styles.leadRowCard}>\n                <View style={styles.rowHeader}>\n                  <Text style={styles.rowNumber}>#{index + 1}</Text>\n                  <TouchableOpacity onPress={() => handleDeleteRow(index)}>\n                    <Trash2 size={16} color=\"#EF4444\" />\n                  </TouchableOpacity>\n                </View>\n\n                <View style={styles.inputRow}>\n                  <View style={{ flex: 1, marginRight: 8 }}>\n                    <Text style={styles.smallLabel}>Name</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.name}\n                      onChangeText={(val) => handleUpdateLead(index, 'name', val)}\n                      placeholder=\"Contact Name\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                  <View style={{ flex: 1 }}>\n                    <Text style={styles.smallLabel}>Phone</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.phone}\n                      onChangeText={(val) => handleUpdateLead(index, 'phone', val)}\n                      placeholder=\"(555) 000-0000\"\n                      placeholderTextColor=\"#64748B\"\n                      keyboardType=\"phone-pad\"\n                    />\n                  </View>\n                </View>\n\n                <View style={[styles.inputRow, { marginTop: 8 }]}>\n                  <View style={{ flex: 1, marginRight: 8 }}>\n                    <Text style={styles.smallLabel}>Company / Org</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.company || ''}\n                      onChangeText={(val) => handleUpdateLead(index, 'company', val)}\n                      placeholder=\"Company\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                  <View style={{ flex: 1 }}>\n                    <Text style={styles.smallLabel}>Notes</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.notes || ''}\n                      onChangeText={(val) => handleUpdateLead(index, 'notes', val)}\n                      placeholder=\"Notes\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                </View>\n              </View>\n            ))}\n\n            {/* Save & Start Dialing */}\n            <TouchableOpacity style={styles.saveButton} onPress={handleSaveAndDial}>\n              <Check size={20} color=\"#FFFFFF\" />\n              <Text style={styles.saveButtonText}>Save List & Launch Power Dialer</Text>\n            </TouchableOpacity>\n          </View>\n        )}\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 14,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  headerTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  content: {\n    flex: 1,\n    padding: 16,\n  },\n  captureSection: {\n    alignItems: 'center',\n    paddingTop: 16,\n  },\n  instructionsBox: {\n    flexDirection: 'row',\n    backgroundColor: '#1E293B',\n    padding: 16,\n    borderRadius: 12,\n    borderWidth: 1,\n    borderColor: '#3B82F6',\n    gap: 12,\n    marginBottom: 32,\n    alignItems: 'center',\n  },\n  instructionText: {\n    flex: 1,\n    color: '#CBD5E1',\n    fontSize: 14,\n    lineHeight: 20,\n  },\n  buttonGroup: {\n    width: '100%',\n    gap: 14,\n  },\n  captureButton: {\n    backgroundColor: '#2563EB',\n    paddingVertical: 20,\n    borderRadius: 16,\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 10,\n  },\n  captureButtonText: {\n    color: '#FFFFFF',\n    fontSize: 18,\n    fontWeight: '700',\n  },\n  secondaryCaptureButton: {\n    backgroundColor: '#1E293B',\n    borderWidth: 1,\n    borderColor: '#334155',\n    paddingVertical: 16,\n    borderRadius: 16,\n    alignItems: 'center',\n    flexDirection: 'row',\n    justifyContent: 'center',\n    gap: 10,\n  },\n  secondaryCaptureButtonText: {\n    color: '#CBD5E1',\n    fontSize: 16,\n    fontWeight: '600',\n  },\n  apiKeyContainer: {\n    width: '100%',\n    marginTop: 40,\n    padding: 16,\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  apiKeyLabel: {\n    color: '#F8FAFC',\n    fontSize: 14,\n    fontWeight: '600',\n    marginBottom: 8,\n  },\n  input: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 8,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    fontSize: 14,\n  },\n  apiKeyHint: {\n    color: '#64748B',\n    fontSize: 12,\n    marginTop: 6,\n  },\n  loadingContainer: {\n    paddingVertical: 60,\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 16,\n  },\n  loadingText: {\n    color: '#94A3B8',\n    fontSize: 16,\n    fontWeight: '500',\n  },\n  reviewSection: {\n    paddingTop: 8,\n  },\n  fieldLabel: {\n    color: '#94A3B8',\n    fontSize: 13,\n    fontWeight: '600',\n    marginBottom: 6,\n  },\n  tableHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginTop: 20,\n    marginBottom: 12,\n  },\n  tableTitle: {\n    color: '#F8FAFC',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  addRowButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 4,\n    padding: 6,\n  },\n  addRowText: {\n    color: '#3B82F6',\n    fontSize: 14,\n    fontWeight: '600',\n  },\n  leadRowCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    padding: 14,\n    marginBottom: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  rowHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    marginBottom: 8,\n  },\n  rowNumber: {\n    color: '#3B82F6',\n    fontWeight: '700',\n    fontSize: 12,\n  },\n  inputRow: {\n    flexDirection: 'row',\n  },\n  smallLabel: {\n    color: '#64748B',\n    fontSize: 11,\n    marginBottom: 4,\n  },\n  rowInput: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 6,\n    paddingHorizontal: 10,\n    paddingVertical: 8,\n    borderWidth: 1,\n    borderColor: '#334155',\n    fontSize: 13,\n  },\n  saveButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#10B981',\n    paddingVertical: 16,\n    borderRadius: 14,\n    marginTop: 20,\n    gap: 8,\n  },\n  saveButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n});\n","Description":"ScanSheetScreen for photo capture, vision extraction, and interactive tabular lead editing","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\ScanSheetScreen.tsx","toolAction":"Writing scan sheet screen","toolSummary":"Write ScanSheetScreen"}}]}
