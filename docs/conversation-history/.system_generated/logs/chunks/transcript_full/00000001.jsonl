{"step_index":52,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-18T13:08:49Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  SafeAreaView,\n  StatusBar,\n  ScrollView,\n  TouchableOpacity,\n  Share,\n  Alert,\n} from 'react-native';\nimport { ArrowLeft, BarChart3, Download, PhoneCall, CheckCircle2, PhoneOff, MessageSquare, XCircle } from 'lucide-react-native';\nimport { CallLogsRepository } from '../db/callLogsRepository';\nimport { LeadsRepository } from '../db/leadsRepository';\n\nexport default function AnalyticsScreen({ navigation }: any) {\n  const [stats, setStats] = useState({\n    totalDials: 0,\n    connectedCount: 0,\n    noAnswerCount: 0,\n    voicemailCount: 0,\n    badNumberCount: 0,\n    smsSentCount: 0,\n  });\n\n  useEffect(() => {\n    loadStats();\n  }, []);\n\n  const loadStats = async () => {\n    const summary = await CallLogsRepository.getAnalyticsSummary();\n    setStats(summary);\n  };\n\n  const connectRate =\n    stats.totalDials > 0\n      ? Math.round((stats.connectedCount / stats.totalDials) * 100)\n      : 0;\n\n  const handleExportData = async () => {\n    try {\n      const lists = await LeadsRepository.getAllLists();\n      const exportJson = JSON.stringify({ lists, stats, exportedAt: new Date().toISOString() }, null, 2);\n      await Share.share({\n        title: 'SnapDialer_Export.json',\n        message: exportJson,\n      });\n    } catch (e) {\n      Alert.alert('Export Error', 'Could not export lead records.');\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>Calling Analytics</Text>\n        <TouchableOpacity style={styles.exportButton} onPress={handleExportData}>\n          <Download size={20} color=\"#3B82F6\" />\n        </TouchableOpacity>\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {/* Main Connect Rate Card */}\n        <View style={styles.heroCard}>\n          <Text style={styles.heroLabel}>OVERALL CONNECT RATE</Text>\n          <Text style={styles.heroValue}>{connectRate}%</Text>\n          <Text style={styles.heroSubtext}>\n            {stats.connectedCount} connected conversations out of {stats.totalDials} total dials\n          </Text>\n        </View>\n\n        {/* Metrics Grid */}\n        <Text style={styles.sectionHeader}>CALL DISPOSITION BREAKDOWN</Text>\n        <View style={styles.grid}>\n          {/* Total Dials */}\n          <View style={styles.statCard}>\n            <View style={styles.statIconBox}>\n              <PhoneCall size={20} color=\"#3B82F6\" />\n            </View>\n            <Text style={styles.statNumber}>{stats.totalDials}</Text>\n            <Text style={styles.statTitle}>Total Dials</Text>\n          </View>\n\n          {/* Connects */}\n          <View style={styles.statCard}>\n            <View style={[styles.statIconBox, { backgroundColor: 'rgba(16, 185, 129, 0.15)' }]}>\n              <CheckCircle2 size={20} color=\"#10B981\" />\n            </View>\n            <Text style={[styles.statNumber, { color: '#10B981' }]}>{stats.connectedCount}</Text>\n            <Text style={styles.statTitle}>Connected</Text>\n          </View>\n\n          {/* No Answers */}\n          <View style={styles.statCard}>\n            <View style={[styles.statIconBox, { backgroundColor: 'rgba(245, 158, 11, 0.15)' }]}>\n              <PhoneOff size={20} color=\"#F59E0B\" />\n            </View>\n            <Text style={[styles.statNumber, { color: '#F59E0B' }]}>{stats.noAnswerCount}</Text>\n            <Text style={styles.statTitle}>No Answer / VM</Text>\n          </View>\n\n          {/* Bad Numbers */}\n          <View style={styles.statCard}>\n            <View style={[styles.statIconBox, { backgroundColor: 'rgba(239, 68, 68, 0.15)' }]}>\n              <XCircle size={20} color=\"#EF4444\" />\n            </View>\n            <Text style={[styles.statNumber, { color: '#EF4444' }]}>{stats.badNumberCount}</Text>\n            <Text style={styles.statTitle}>Bad Numbers</Text>\n          </View>\n        </View>\n\n        {/* SMS Stats */}\n        <View style={styles.smsBanner}>\n          <MessageSquare size={24} color=\"#38BDF8\" />\n          <View style={{ flex: 1, marginLeft: 12 }}>\n            <Text style={styles.smsBannerTitle}>{stats.smsSentCount} Follow-up Texts Sent</Text>\n            <Text style={styles.smsBannerSub}>\n              Automated cadence touches sent via Native SIM bridge\n            </Text>\n          </View>\n        </View>\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 14,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  headerTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  exportButton: {\n    padding: 8,\n  },\n  content: {\n    flex: 1,\n    padding: 16,\n  },\n  heroCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 20,\n    padding: 24,\n    alignItems: 'center',\n    borderWidth: 1,\n    borderColor: '#334155',\n    marginBottom: 24,\n  },\n  heroLabel: {\n    color: '#94A3B8',\n    fontSize: 12,\n    fontWeight: '700',\n    letterSpacing: 1,\n  },\n  heroValue: {\n    fontSize: 48,\n    fontWeight: '900',\n    color: '#10B981',\n    marginTop: 6,\n  },\n  heroSubtext: {\n    color: '#CBD5E1',\n    fontSize: 13,\n    marginTop: 6,\n    textAlign: 'center',\n  },\n  sectionHeader: {\n    color: '#64748B',\n    fontSize: 12,\n    fontWeight: '700',\n    letterSpacing: 1,\n    marginBottom: 12,\n  },\n  grid: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: 12,\n  },\n  statCard: {\n    width: '48%',\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  statIconBox: {\n    width: 40,\n    height: 40,\n    borderRadius: 10,\n    backgroundColor: 'rgba(59, 130, 246, 0.15)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginBottom: 12,\n  },\n  statNumber: {\n    fontSize: 24,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  statTitle: {\n    fontSize: 12,\n    color: '#94A3B8',\n    marginTop: 2,\n  },\n  smsBanner: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    padding: 18,\n    marginTop: 20,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  smsBannerTitle: {\n    color: '#F8FAFC',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  smsBannerSub: {\n    color: '#94A3B8',\n    fontSize: 12,\n    marginTop: 2,\n  },\n});\n","Description":"AnalyticsScreen for tracking dial sessions, connect rate percentages, and data export","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\AnalyticsScreen.tsx","toolAction":"Writing analytics screen","toolSummary":"Write AnalyticsScreen"}}]}
