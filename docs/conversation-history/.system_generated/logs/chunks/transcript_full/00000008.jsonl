     notes TEXT,\n323:       cadence_step INTEGER DEFAULT 1,\n324:       last_attempt_at TEXT,\n325:       last_disposition TEXT DEFAULT 'pending',\n326:       attempts_count INTEGER DEFAULT 0,\n327:       created_at TEXT NOT NULL,\n328:       updated_at TEXT NOT NULL,\n329:       FOREIGN KEY (list_id) REFERENCES lists(id) ON DELETE CASCADE\n330:     );\n331: \n332:     CREATE TABLE IF NOT EXISTS call_logs (\n333:       id TEXT PRIMARY KEY NOT NULL,\n334:       lead_id TEXT NOT NULL,\n335:       list_id TEXT NOT NULL,\n336:       timestamp TEXT NOT NULL,\n337:       duration_seconds INTEGER DEFAULT 0,\n338:       disposition TEXT NOT NULL,\n339:       note TEXT,\n340:       sms_sent INTEGER DEFAULT 0,\n341:       sms_body TEXT,\n342:       FOREIGN KEY (lead_id) REFERENCES leads(id) ON DELETE CASCADE,\n343:       FOREIGN KEY (list_id) REFERENCES lists(id) ON DELETE CASCADE\n344:     );\n345: \n346:     CREATE TABLE IF NOT EXISTS cadence_rules (\n347:       id TEXT PRIMARY KEY NOT NULL,\n348:       step_number INTEGER NOT NULL,\n349:       condition_disposition TEXT NOT NULL,\n350:       action_type TEXT NOT NULL,\n351:       sms_template_id TEXT,\n352:       delay_hours INTEGER DEFAULT 24\n353:     );\n354: \n355:     CREATE TABLE IF NOT EXISTS sms_templates (\n356:       id TEXT PRIMARY KEY NOT NULL,\n357:       title TEXT NOT NULL,\n358:       body TEXT NOT NULL\n359:     );\n360: \n361:     CREATE TABLE IF NOT EXISTS settings (\n362:       key TEXT PRIMARY KEY NOT NULL,\n363:       value TEXT NOT NULL\n364:     );\n365: \n366:     CREATE INDEX IF NOT EXISTS idx_leads_list_id ON leads(list_id);\n367:     CREATE INDEX IF NOT EXISTS idx_leads_status ON leads(last_disposition);\n368:     CREATE INDEX IF NOT EXISTS idx_call_logs_lead ON call_logs(lead_id);\n369:   `);\n370: \n371:   const templateCount = await db.getFirstAsync('SELECT COUNT(*) as count FROM sms_templates');\n372:   if (!templateCount || templateCount.count === 0) {\n373:     await db.runAsync(\n374:   