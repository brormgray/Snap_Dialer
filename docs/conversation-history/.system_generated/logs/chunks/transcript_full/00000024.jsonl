nces.join(' • ')}</Text>\n327:                   </View>\n328:                 )}\n329: \n330:                 {item.frs_interests && item.frs_interests.length > 0 && (\n331:                   <View style={{ marginTop: 10 }}>\n332:                     <Text style={styles.smallLabel}>Checked Interests / Needs</Text>\n333:                     <Text style={styles.interestsText}>{item.frs_interests.join(', ')}</Text>\n334:                   </View>\n335:                 )}\n336: \n337:                 {item.custom_questions ? (\n338:                   <View style={{ marginTop: 10 }}>\n339:                     <Text style={styles.smallLabel}>Teacher's Written Question</Text>\n340:                     <Text style={styles.questionText}>\"{item.custom_questions}\"</Text>\n341:                   </View>\n342:                 ) : null}\n343:               </View>\n344:             ))}\n345: \n346:             {/* Action Buttons */}\n347:             <View style={styles.actionButtonsContainer}>\n348:               <TouchableOpacity\n349:                 style={styles.saveAndDialBtn}\n350:                 onPress={() => handleSaveLead(true)}\n351:                 activeOpacity={0.8}\n352:               >\n353:                 <PhoneCall size={20} color=\"#FFFFFF\" />\n354:                 <Text style={styles.saveAndDialBtnText}>Save & Open Call HUD</Text>\n355:               </TouchableOpacity>\n356: \n357:               <TouchableOpacity\n358:                 style={styles.saveOnlyBtn}\n359:                 onPress={() => handleSaveLead(false)}\n360:                 activeOpacity={0.8}\n361:               >\n362:                 <Check size={20} color=\"#FFFFFF\" />\n363:                 <Text style={styles.saveOnlyBtnText}>Save Educator to Pipeline</Text>\n364:               </TouchableOpacity>\n365:             </View>\n366:           </View>\n367:         )}\n368:       </ScrollView>\n369:     </SafeAreaView>\n370:   );\n371: }\n372: \n373: const styles = StyleSheet.create({\n374:   container: {\n375:     flex: 1,\n376:     backgroundColor: '#0F172A',\n377:   },\n378:   header: {\n379:     flexDirection: 'row',\n380:     alignItems: 'center',\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
