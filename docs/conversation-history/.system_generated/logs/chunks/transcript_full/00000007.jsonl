{"step_index":244,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-20T15:23:34Z","thinking":"**Developing Offline Features**\n\nI'm focusing on enhancing `src/screens/ScanSheetScreen.tsx`. My current task is to implement an offline text and document scanner modal, complete with a paste box. I'll also add `FileText` and `Clipboard` icons for better user interaction. Finally, I'll integrate full offline regex parsing to enable robust functionality. I am now writing the upgraded screen.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  TouchableOpacity,\n  SafeAreaView,\n  StatusBar,\n  ScrollView,\n  TextInput,\n  Image,\n  ActivityIndicator,\n  Alert,\n  Modal,\n} from 'react-native';\nimport * as ImagePicker from 'expo-image-picker';\nimport { Camera, Image as ImageIcon, Check, Trash2, Plus, Sparkles, ArrowLeft, FileText, Clipboard } from 'lucide-react-native';\nimport { VisionService } from '../services/visionService';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { HapticsService } from '../services/hapticsService';\nimport { ExtractedLeadItem } from '../types';\n\nexport default function ScanSheetScreen({ navigation }: any) {\n  const [imageUri, setImageUri] = useState<string | null>(null);\n  const [isProcessing, setIsProcessing] = useState<boolean>(false);\n  const [listTitle, setListTitle] = useState<string>('Lead Sheet ' + new Date().toLocaleDateString());\n  const [extractedLeads, setExtractedLeads] = useState<ExtractedLeadItem[]>([]);\n  const [apiKey, setApiKey] = useState<string>('');\n  const [hasScanned, setHasScanned] = useState<boolean>(false);\n\n  // Offline text paste modal state\n  const [pasteModalVisible, setPasteModalVisible] = useState<boolean>(false);\n  const [pastedText, setPastedText] = useState<string>('');\n\n  const takePhoto = async () => {\n    await HapticsService.tick();\n    const permission = await ImagePicker.requestCameraPermissionsAsync();\n    if (!permission.granted) {\n      Alert.alert('Permission required', 'Camera permission is required to snap lead sheets.');\n      return;\n    }\n\n    const result = await ImagePicker.launchCameraAsync({\n      mediaTypes: ImagePicker.MediaTypeOptions.Images,\n      quality: 0.85,\n    });\n\n    if (!result.canceled && result.assets[0]) {\n      handleImageCaptured(result.assets[0].uri);\n    }\n  };\n\n  const pickImage = async () => {\n    await HapticsService.tick();\n    const result = await ImagePicker.launchImageLibraryAsync({\n      mediaTypes: ImagePicker.MediaTypeOptions.Images,\n      quality: 0.85,\n    });\n\n    if (!result.canceled && result.assets[0]) {\n      handleImageCaptured(result.assets[0].uri);\n    }\n  };\n\n  const handleImageCaptured = async (uri: string) => {\n    setImageUri(uri);\n    setIsProcessing(true);\n    try {\n      const leads = await VisionService.extractLeadsFromImage(uri, apiKey);\n      await HapticsService.success();\n      setExtractedLeads(leads);\n      setHasScanned(true);\n    } catch (e) {\n      Alert.alert('Extraction Error', 'Could not parse leads from image. You can add them manually or use offline parsing.');\n      setExtractedLeads(VisionService.getDemoExtractedLeads());\n      setHasScanned(true);\n    } finally {\n      setIsProcessing(false);\n    }\n  };\n\n  const handleParsePastedText = async () => {\n    if (!pastedText.trim()) return;\n    await HapticsService.success();\n    setPasteModalVisible(false);\n    setIsProcessing(true);\n\n    setTimeout(() => {\n      const leads = VisionService.parseUnstructuredText(pastedText);\n      setExtractedLeads(leads);\n      setHasScanned(true);\n      setIsProcessing(false);\n    }, 300);\n  };\n\n  const handleUpdateLead = (index: number, field: keyof ExtractedLeadItem, value: string) => {\n    const updated = [...extractedLeads];\n    updated[index] = { ...updated[index], [field]: value };\n    setExtractedLeads(updated);\n  };\n\n  const handleDeleteRow = (index: number) => {\n    HapticsService.tick();\n    setExtractedLeads(extractedLeads.filter((_, i) => i !== index));\n  };\n\n  const handleAddRow = () => {\n    HapticsService.tick();\n    setExtractedLeads([\n      ...extractedLeads,\n      {\n        id: `manual_${Date.now()}`,\n        name: '',\n        phone: '',\n        company: '',\n        notes: '',\n        isValid: true,\n      },\n    ]);\n  };\n\n  const handleSaveAndDial = async () => {\n    const validLeads = extractedLeads.filter((l) => l.name.trim() && l.phone.trim());\n    if (validLeads.length === 0) {\n      Alert.alert('No valid leads', 'Please provide at least one contact with a valid name and phone number.');\n      return;\n    }\n\n    try {\n      await HapticsService.success();\n      const newList = await LeadsRepository.createListWithLeads(\n        listTitle.trim() || 'Scanned Lead Sheet',\n        imageUri,\n        validLeads\n      );\n\n      Alert.alert(\n        'List Saved!',\n        `Successfully imported ${validLeads.length} leads into local SQLite.`,\n        [\n          {\n            text: 'Start Power Dialing Now',\n            onPress: () =>\n              navigation.replace('DialerHUD', {\n                listId: newList.id,\n                listTitle: newList.title,\n              }),\n          },\n          {\n            text: 'Go to Lists',\n            onPress: () => navigation.navigate('Lists'),\n            style: 'cancel',\n          },\n        ]\n      );\n    } catch (e) {\n      console.error(e);\n      Alert.alert('Error', 'Failed to save leads to local database.');\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>\n          {!hasScanned ? 'Snap Lead Sheet' : 'Verify & Clean Leads'}\n        </Text>\n        <View style={{ width: 40 }} />\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {!hasScanned ? (\n          <View style={styles.captureSection}>\n            <View style={styles.instructionsBox}>\n              <Sparkles size={20} color=\"#3B82F6\" />\n              <Text style={styles.instructionText}>\n                Snap a photo of any printed call list, sign-in sheet, or roster. Antigravity extracts structured contacts automatically.\n              </Text>\n            </View>\n\n            {/* Camera & Ingestion Options */}\n            <View style={styles.buttonGroup}>\n              <TouchableOpacity style={styles.captureButton} onPress={takePhoto} activeOpacity={0.8}>\n                <Camera size={28} color=\"#FFFFFF\" />\n                <Text style={styles.captureButtonText}>\n                  {ImagePicker.launchCameraAsync ? 'Take Photo of Sheet' : 'Upload Sheet Photo'}\n                </Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity style={styles.secondaryCaptureButton} onPress={pickImage}>\n                <ImageIcon size={22} color=\"#94A3B8\" />\n                <Text style={styles.secondaryCaptureButtonText}>Pick from Photo Library</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity\n                style={styles.secondaryCaptureButton}\n                onPress={() => setPasteModalVisible(true)}\n              >\n                <Clipboard size={22} color=\"#94A3B8\" />\n                <Text style={styles.secondaryCaptureButtonText}>Paste Text / CSV (100% Offline)</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity\n                style={[styles.secondaryCaptureButton, { borderColor: '#3B82F6', backgroundColor: 'rgba(59, 130, 246, 0.1)' }]}\n                onPress={() => {\n                  HapticsService.success();\n                  setExtractedLeads(VisionService.getDemoExtractedLeads());\n                  setHasScanned(true);\n                }}\n              >\n                <Sparkles size={20} color=\"#38BDF8\" />\n                <Text style={[styles.secondaryCaptureButtonText, { color: '#38BDF8', fontWeight: '700' }]}>\n                  Load Sample Lead Sheet (Instant)\n                </Text>\n              </TouchableOpacity>\n            </View>\n\n            {/* Optional API Key Input */}\n            <View style={styles.apiKeyContainer}>\n              <Text style={styles.apiKeyLabel}>Gemini Vision API Key (Optional)</Text>\n              <TextInput\n                style={styles.input}\n                placeholder=\"Leave blank to use smart offline demo extractor\"\n                placeholderTextColor=\"#64748B\"\n                value={apiKey}\n                onChangeText={setApiKey}\n                secureTextEntry\n              />\n              <Text style={styles.apiKeyHint}>\n                If left blank, pre-loaded sample leads or offline pattern matching will be used.\n              </Text>\n            </View>\n          </View>\n        ) : isProcessing ? (\n          <View style={styles.loadingContainer}>\n            <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n            <Text style={styles.loadingText}>Extracting contacts from sheet...</Text>\n          </View>\n        ) : (\n          <View style={styles.reviewSection}>\n            {/* List Title Input */}\n            <Text style={styles.fieldLabel}>List Name</Text>\n            <TextInput\n              style={styles.input}\n              value={listTitle}\n              onChangeText={setListTitle}\n              placeholder=\"e.g. Open House Leads - June 2026\"\n              placeholderTextColor=\"#64748B\"\n            />\n\n            {/* Extracted Leads Header */}\n            <View style={styles.tableHeader}>\n              <Text style={styles.tableTitle}>\n                Detected Contacts ({extractedLeads.length})\n              </Text>\n              <TouchableOpacity style={styles.addRowButton} onPress={handleAddRow}>\n                <Plus size={16} color=\"#3B82F6\" />\n                <Text style={styles.addRowText}>Add Lead</Text>\n              </TouchableOpacity>\n            </View>\n\n            {/* Editable Rows */}\n            {extractedLeads.map((item, index) => (\n              <View key={item.id || index} style={styles.leadRowCard}>\n                <View style={styles.rowHeader}>\n                  <Text style={styles.rowNumber}>#{index + 1}</Text>\n                  <TouchableOpacity onPress={() => handleDeleteRow(index)}>\n                    <Trash2 size={16} color=\"#EF4444\" />\n                  </TouchableOpacity>\n                </View>\n\n                <View style={styles.inputRow}>\n                  <View style={{ flex: 1, marginRight: 8 }}>\n                    <Text style={styles.smallLabel}>Name</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.name}\n                      onChangeText={(val) => handleUpdateLead(index, 'name', val)}\n                      placeholder=\"Contact Name\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                  <View style={{ flex: 1 }}>\n                    <Text style={styles.smallLabel}>Phone</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.phone}\n                      onChangeText={(val) => handleUpdateLead(index, 'phone', val)}\n                      placeholder=\"(555) 000-0000\"\n                      placeholderTextColor=\"#64748B\"\n                      keyboardType=\"phone-pad\"\n                    />\n                  </View>\n                </View>\n\n                <View style={[styles.inputRow, { marginTop: 8 }]}>\n                  <View style={{ flex: 1, marginRight: 8 }}>\n                    <Text style={styles.smallLabel}>Company / Org</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.company || ''}\n                      onChangeText={(val) => handleUpdateLead(index, 'company', val)}\n                      placeholder=\"Company\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                  <View style={{ flex: 1 }}>\n                    <Text style={styles.smallLabel}>Notes</Text>\n                    <TextInput\n                      style={styles.rowInput}\n                      value={item.notes || ''}\n                      onChangeText={(val) => handleUpdateLead(index, 'notes', val)}\n                      placeholder=\"Notes\"\n                      placeholderTextColor=\"#64748B\"\n                    />\n                  </View>\n                </View>\n              </View>\n            ))}\n\n            {/* Save & Start Dialing */}\n            <TouchableOpacity style={styles.saveButton} onPress={handleSaveAndDial}>\n              <Check size={20} color=\"#FFFFFF\" />\n              <Text style={styles.saveButtonText}>Save List & Launch Power Dialer</Text>\n            </TouchableOpacity>\n          </View>\n        )}\n      </ScrollView>\n\n      {/* Offline Text Paste Modal */}\n      <Modal visible={pasteModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.modalOverlay}>\n          <View style={styles.modalContent}>\n            <Text style={styles.modalTitle}>Paste Text or CSV (Offline)</Text>\n            <Text style={{ color: '#94A3B8', fontSize: 13, marginBottom: 10 }}>\n              Paste any unstructured text, email roster, or CSV data. Antigravity will detect phone numbers and names locally.