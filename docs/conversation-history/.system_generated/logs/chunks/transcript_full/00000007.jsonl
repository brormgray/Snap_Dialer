{"step_index":252,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-20T15:23:53Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect, useCallback } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  FlatList,\n  TouchableOpacity,\n  SafeAreaView,\n  StatusBar,\n  ActivityIndicator,\n  Alert,\n  TextInput,\n  ScrollView,\n} from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport {\n  Camera,\n  PhoneCall,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  ChevronRight,\n  ChevronDown,\n  BarChart3,\n  Settings,\n  RotateCcw,\n  Search,\n  User,\n  Calendar,\n  Clock,\n} from 'lucide-react-native';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { HapticsService } from '../services/hapticsService';\nimport { LeadList, Lead, CallDisposition } from '../types';\n\nexport default function ListsScreen({ navigation }: any) {\n  const [lists, setLists] = useState<LeadList[]>([]);\n  const [expandedListId, setExpandedListId] = useState<string | null>(null);\n  const [listLeads, setListLeads] = useState<{ [listId: string]: Lead[] }>({});\n  const [upcomingFollowUps, setUpcomingFollowUps] = useState<Lead[]>([]);\n  const [filterDisposition, setFilterDisposition] = useState<string>('all');\n  const [searchQuery, setSearchQuery] = useState<string>('');\n  const [loading, setLoading] = useState<boolean>(true);\n\n  const loadLists = async () => {\n    try {\n      const data = await LeadsRepository.getAllLists();\n      setLists(data);\n      const followUps = await LeadsRepository.getUpcomingFollowUps();\n      setUpcomingFollowUps(followUps);\n\n      if (expandedListId) {\n        const leads = await LeadsRepository.getLeadsForList(expandedListId);\n        setListLeads((prev) => ({ ...prev, [expandedListId]: leads }));\n      }\n    } catch (e) {\n      console.error(e);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useFocusEffect(\n    useCallback(() => {\n      loadLists();\n    }, [expandedListId])\n  );\n\n  const toggleExpand = async (listId: string) => {\n    await HapticsService.tick();\n    if (expandedListId === listId) {\n      setExpandedListId(null);\n    } else {\n      setExpandedListId(listId);\n      const leads = await LeadsRepository.getLeadsForList(listId);\n      setListLeads((prev) => ({ ...prev, [listId]: leads }));\n    }\n  };\n\n  const handleDelete = (id: string, title: string) => {\n    Alert.alert('Delete List', `Are you sure you want to delete \"${title}\"?`, [\n      { text: 'Cancel', style: 'cancel' },\n      {\n        text: 'Delete',\n        style: 'destructive',\n        onPress: async () => {\n          await HapticsService.heavy();\n          await LeadsRepository.deleteList(id);\n          loadLists();\n        },\n      },\n    ]);\n  };\n\n  const handleRecycleList = async (listId: string, title: string) => {\n    await HapticsService.medium();\n    Alert.alert(\n      'Recycle Unanswered Leads for Next Attempt?',\n      `This will reset leads in \"${title}\" that did not connect so you can run the next call cadence attempt.`,\n      [\n        { text: 'Cancel', style: 'cancel' },\n        {\n          text: 'Recycle for Attempt',\n          onPress: async () => {\n            await HapticsService.success();\n            const db = await import('../db/database').then((m) => m.getDatabase());\n            await db.runAsync(\n              `UPDATE leads \n               SET last_disposition = 'pending' \n               WHERE list_id = ? AND last_disposition IN ('no_answer', 'voicemail')`,\n              [listId]\n            );\n            loadLists();\n            Alert.alert('Queue Ready', 'Unanswered leads recycled back to active dialing queue.');\n          },\n        },\n      ]\n    );\n  };\n\n  const getStatusColor = (disp?: CallDisposition | null) => {\n    switch (disp) {\n      case 'connected':\n        return '#10B981';\n      case 'no_answer':\n      case 'voicemail':\n        return '#F59E0B';\n      case 'bad_number':\n      case 'do_not_call':\n        return '#EF4444';\n      default:\n        return '#94A3B8';\n    }\n  };\n\n  const renderItem = ({ item }: { item: LeadList }) => {\n    const progress = item.total_leads > 0 ? (item.completed_leads / item.total_leads) * 100 : 0;\n    const isExpanded = expandedListId === item.id;\n    const leads = listLeads[item.id] || [];\n\n    const filteredLeads = leads.filter((l) => {\n      const matchSearch =\n        !searchQuery ||\n        l.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        l.phone.includes(searchQuery);\n\n      if (!matchSearch) return false;\n      if (filterDisposition === 'all') return true;\n      if (filterDisposition === 'pending') return l.last_disposition === 'pending' || !l.last_disposition;\n      if (filterDisposition === 'connected') return l.last_disposition === 'connected';\n      if (filterDisposition === 'no_answer') return l.last_disposition === 'no_answer' || l.last_disposition === 'voicemail';\n      return true;\n    });\n\n    return (\n      <View style={styles.card}>\n        <TouchableOpacity\n          style={styles.cardHeader}\n          onPress={() => toggleExpand(item.id)}\n          activeOpacity={0.7}\n        >\n          <View style={{ flex: 1 }}>\n            <Text style={styles.cardTitle}>{item.title}</Text>\n            <Text style={styles.cardSubtitle}>\n              {new Date(item.created_at).toLocaleDateString()} • {item.total_leads} Leads\n            </Text>\n          </View>\n          <View style={styles.headerIcons}>\n            <TouchableOpacity\n              onPress={() => handleRecycleList(item.id, item.title)}\n              hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}\n              style={{ marginRight: 12 }}\n            >\n              <RotateCcw size={18} color=\"#38BDF8\" />\n            </TouchableOpacity>\n            <TouchableOpacity\n              onPress={() => handleDelete(item.id, item.title)}\n              hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}\n              style={{ marginRight: 8 }}\n            >\n              <Trash2 size={18} color=\"#94A3B8\" />\n            </TouchableOpacity>\n            {isExpanded ? (\n              <ChevronDown size={20} color=\"#3B82F6\" />\n            ) : (\n              <ChevronRight size={20} color=\"#64748B\" />\n            )}\n          </View>\n        </TouchableOpacity>\n\n        {/* Progress Bar */}\n        <View style={styles.progressContainer}>\n          <View style={[styles.progressBar, { width: `${progress}%` }]} />\n        </View>\n\n        <View style={styles.statsRow}>\n          <View style={styles.statItem}>\n            <Text style={styles.statLabel}>Completed</Text>\n            <Text style={styles.statValue}>\n              {item.completed_leads}/{item.total_leads}\n            </Text>\n          </View>\n          <View style={styles.statItem}>\n            <Text style={styles.statLabel}>Connected</Text>\n            <Text style={[styles.statValue, { color: '#10B981' }]}>\n              {item.connected_leads}\n            </Text>\n          </View>\n          <View style={styles.statItem}>\n            <Text style={styles.statLabel}>Remaining</Text>\n            <Text style={styles.statValue}>\n              {item.total_leads - item.completed_leads}\n            </Text>\n          </View>\n        </View>\n\n        {/* Action Button */}\n        <TouchableOpacity\n          style={styles.dialButton}\n          onPress={() => navigation.navigate('DialerHUD', { listId: item.id, listTitle: item.title })}\n        >\n          <PhoneCall size={18} color=\"#FFFFFF\" />\n          <Text style={styles.dialButtonText}>Launch Power Dialer</Text>\n          <ChevronRight size={18} color=\"#FFFFFF\" />\n        </TouchableOpacity>\n\n        {/* Expanded Leads Viewer */}\n        {isExpanded && (\n          <View style={styles.expandedSection}>\n            <View style={styles.searchBar}>\n              <Search size={16} color=\"#64748B\" />\n              <TextInput\n                style={styles.searchInput}\n                placeholder=\"Search leads by name or phone...\"\n                placeholderTextColor=\"#64748B\"\n                value={searchQuery}\n                onChangeText={setSearchQuery}\n              />\n            </View>\n\n            {/* Filter Chips */}\n            <View style={styles.chipRow}>\n              {['all', 'pending', 'no_answer', 'connected'].map((disp) => (\n                <TouchableOpacity\n                  key={disp}\n                  style={[\n                    styles.chip,\n                    filterDisposition === disp && styles.activeChip,\n                  ]}\n                  onPress={() => setFilterDisposition(disp)}\n                >\n                  <Text\n                    style={[\n                      styles.chipText,\n                      filterDisposition === disp && styles.activeChipText,\n                    ]}\n                  >\n                    {disp.replace('_', ' ').toUpperCase()}\n                  </Text>\n                </TouchableOpacity>\n              ))}\n            </View>\n\n            {/* Leads List */}\n            {filteredLeads.map((lead) => (\n              <TouchableOpacity\n                key={lead.id}\n                style={styles.leadItemRow}\n                onPress={() => navigation.navigate('LeadDetail', { leadId: lead.id })}\n              >\n                <View style={{ flex: 1 }}>\n                  <Text style={styles.leadName}>{lead.name}</Text>\n                  <Text style={styles.leadPhone}>{lead.phone}</Text>\n                </View>\n                <View\n                  style={[\n                    styles.leadBadge,\n                    { backgroundColor: `${getStatusColor(lead.last_disposition)}20` },\n                  ]}\n                >\n                  <Text\n                    style={[\n                      styles.leadBadgeText,\n                      { color: getStatusColor(lead.last_disposition) },\n                    ]}\n                  >\n                    {(lead.last_disposition || 'Pending').toUpperCase()}\n                  </Text>\n                </View>\n                <ChevronRight size={16} color=\"#64748B\" style={{ marginLeft: 8 }} />\n              </TouchableOpacity>\n            ))}\n          </View>\n        )}\n      </View>\n    );\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Top Header */}\n      <View style={styles.header}>\n        <View>\n          <Text style={styles.appTitle}>SnapDialer</Text>\n          <Text style={styles.appSubtitle}>Physical Sheet to Power Dialer</Text>\n        </View>\n        <View style={styles.headerActions}>\n          <TouchableOpacity\n            style={styles.iconButton}\n            onPress={() => navigation.navigate('Analytics')}\n          >\n            <BarChart3 size={20} color=\"#F8FAFC\" />\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={styles.iconButton}\n            onPress={() => navigation.navigate('Settings')}\n          >\n            <Settings size={20} color=\"#F8FAFC\" />\n          </TouchableOpacity>\n        </View>\n      </View>\n\n      {/* Upcoming Scheduled Callbacks Banner */}\n      {upcomingFollowUps.length > 0 && (\n        <View style={styles.followUpsBanner}>\n          <View style={styles.followUpsHeader}>\n            <Calendar size={16} color=\"#8B5CF6\" />\n            <Text style={styles.followUpsTitle}>\n              Scheduled Callbacks ({upcomingFollowUps.length})\n            </Text>\n          </View>\n          <ScrollView horizontal showsHorizontalScrollIndicator={false} style={{ marginTop: 8 }}>\n            {upcomingFollowUps.map((lead) => (\n              <TouchableOpacity\n                key={lead.id}\n                style={styles.followUpChip}\n                onPress={() => navigation.navigate('LeadDetail', { leadId: lead.id })}\n              >\n                <Clock size={12} color=\"#8B5CF6\" />\n                <Text style={styles.followUpName}>{lead.name}</Text>\n                <Text style={styles.followUpTime}>\n                  {lead.follow_up_at\n                    ? new Date(lead.follow_up_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n                    : 'Today'}\n                </Text>\n              </TouchableOpacity>\n            ))}\n          </ScrollView>\n        </View>\n      )}\n\n      {/* Main Content */}\n      {loading ? (\n        <View style={styles.centerContainer}>\n          <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n        </View>\n      ) : lists.length === 0 ? (\n        <View style={styles.emptyContainer}>\n          <Camera size={56} color=\"#475569\" />\n          <Text style={styles.emptyTitle}>No Lead Lists Yet</Text>\n          <Text style={styles.emptyDesc}>\n            Take a photo of any paper lead sheet, sign-in roster, or data sheet to start your first power dialing session.\n          </Text>\n          <TouchableOpacity\n            style={styles.primaryButton}\n            onPress={() => navigation.navigate('ScanSheet')}\n          >\n            <Camera size={20} color=\"#FFFFFF\" />\n            <Text style={styles.primaryButtonText}>Snap Lead Sheet</Text>\n          </TouchableOpacity>\n        </View>\n      ) : (\n        <FlatList\n          data={lists}\n          keyExtractor={(item) => item.id}\n          renderItem={renderItem}\n          contentContainerStyle={styles.listContent}\n        />\n      )}\n\n      {/* Floating Action Button */}\n      {lists.length > 0 && (\n        <TouchableOpacity\n          style={styles.fab}\n          onPress={() => navigation.navigate('ScanSheet')}\n          activeOpacity={0.8}\n        >\n          <Plus size={24} color=\"#FFFFFF\" />\n          <Text style={styles.fabText}>Snap Sheet</Text>\n        </TouchableOpacity>\n      )}\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    paddingHorizontal: 20,\n    paddingVertical: 16,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  appTitle: {\n    fontSize: 24,\n    fontWeight: '800',\n    color: '#F8FAFC',\n    letterSpacing: -0.5,\n  },\n  appSubtitle: {\n    fontSize: 13,\n    color: '#94A3B8',\n    marginTop: 2,\n  },\n  headerActions: {\n    flexDirection: 'row',\n    gap: 10,\n  },\n  iconButton: {\n    padding: 8,\n    backgroundColor: '#1E293B',\n    borderRadius: 10,\n  },\n  followUpsBanner: {\n    backgroundColor: '#1E293B',\n    marginHorizontal: 16,\n    marginTop: 12,\n    padding: 12,\n    borderRadius: 14,\n    borderWidth: 1,\n    borderColor: '#8B5CF6',\n  },\n  followUpsHeader: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n  },\n  followUpsTitle: {\n    color: '#F8FAFC',\n    fontSize: 13,\n    fontWeight: '700',\n  },\n  followUpChip: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#0F172A',\n    paddingHorizontal: 10,\n    paddingVertical: 6,\n    borderRadius: 8,\n    marginRight: 8,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 6,\n  },\n  followUpName: {\n    color: '#F8FAFC',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  followUpTime: {\n    color: '#8B5CF6',\n    fontSize: 11,\n    fontWeight: '700',\n  },\n  centerContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n  },\n  emptyContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    paddingHorizontal: 36,\n  },\n  emptyTitle: {\n    fontSize: 20,\n    fontWeight: '700',\n    color: '#F8FAFC',\n    marginTop: 16,\n  },\n  emptyDesc: {\n    fontSize: 14,\n    color: '#94A3B8',\n    textAlign: 'center',\n    marginTop: 8,\n    lineHeight: 20,\n  },\n  primaryButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 8,\n    backgroundColor: '#2563EB',\n    paddingHorizontal: 20,\n    paddingVertical: 14,\n    borderRadius: 12,\n    marginTop: 24,\n  },\n  primaryButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '600',\n  },\n  listContent: {\n    padding: 16,\n    paddingBottom: 90,\n  },\n  card: {\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    padding: 18,\n    marginBottom: 16,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  cardHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n  },\n  headerIcons: {\n    flexDirection: 'row',\n    alignItems: 'center',\n  },\n  cardTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  cardSubtitle: {\n    fontSize: 13,\n    color: '#94A3B8',\n    marginTop: 3,\n  },\n  progressContainer: {\n    height: 6,\n    backgroundColor: '#334155',\n    borderRadius: 3,\n    marginTop: 14,\n    overflow: 'hidden',\n  },\n  progressBar: {\n    height: '100%',\n    backgroundColor: '#3B82F6',\n  },\n  statsRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    marginTop: 14,\n    paddingTop: 12,\n    borderTopWidth: 1,\n    borderTopColor: '#334155',\n  },\n  statItem: {\n    alignItems: 'center',\n  },\n  statLabel: {\n    fontSize: 12,\n    color: '#94A3B8',\n  },\n  statValue: {\n    fontSize: 15,\n    fontWeight: '700',\n    color: '#F8FAFC',\n    marginTop: 2,\n  },\n  dialButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    backgroundColor: '#2563EB',\n    paddingVertical: 12,\n    paddingHorizontal: 16,\n    borderRadius: 10,\n    marginTop: 16,\n  },\n  dialButtonText: {\n    color: '#FFFFFF',\n    fontSize: 15,\n    fontWeight: '600',\n  },\n  expandedSection: {\n    marginTop: 16,\n    paddingTop: 14,\n    borderTopWidth: 1,\n    borderTopColor: '#334155',\n  },\n  searchBar: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#0F172A',\n    borderRadius: 8,\n    paddingHorizontal: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 8,\n  },\n  searchInput: {\n    flex: 1,\n    color: '#F8FAFC',\n    paddingVertical: 8,\n    fontSize: 13,\n  },\n  chipRow: {\n    flexDirection: 'row',\n    gap: 6,\n    marginTop: 10,\n    marginBottom: 10,\n  },\n  chip: {\n    paddingHorizontal: 8,\n    paddingVertical: 4,\n    borderRadius: 6,\n    backgroundColor: '#0F172A',\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  activeChip: {\n    borderColor: '#3B82F6',\n    backgroundColor: '#2563EB',\n  },\n  chipText: {\n    color: '#94A3B8',\n    fontSize: 10,\n    fontWeight: '700',\n  },\n  activeChipText: {\n    color: '#FFFFFF',\n  },\n  leadItemRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#0F172A',\n    padding: 10,\n    borderRadius: 8,\n    marginBottom: 6,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  leadName: {\n    color: '#F8FAFC',\n    fontSize: 14,\n    fontWeight: '600',\n  },\n  leadPhone: {\n    color: '#94A3B8',\n    fontSize: 12,\n    marginTop: 1,\n  },\n  leadBadge: {\n    paddingHorizontal: 6,\n    paddingVertical: 3,\n    borderRadius: 4,\n  },\n  leadBadgeText: {\n    fontSize: 10,\n    fontWeight: '700',\n  },\n  fab: {\n    position: 'absolute',\n    bottom: 24,\n    right: 20,\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 8,\n    backgroundColor: '#2563EB',\n    paddingVertical: 14,\n    paddingHorizontal: 20,\n    borderRadius: 28,\n    shadowColor: '#000',\n    shadowOffset: { width: 0, height: 4 },\n    shadowOpacity: 0.3,\n    shadowRadius: 6,\n    elevation: 8,\n  },\n  fabText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n});\n","Description":"Upgraded ListsScreen with scheduled callback reminders carousel and quick lead access","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\ListsScreen.tsx","toolAction":"Updating ListsScreen.tsx with scheduled callbacks","toolSummary":"Update ListsScreen.tsx with follow-up carousel"}}]}
