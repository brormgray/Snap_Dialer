\n    gap: 10,\n  },\n  dispositionButton: {\n    width: '48%',\n    paddingVertical: 16,\n    borderRadius: 14,\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 4,\n  },\n  dispositionButtonText: {\n    color: '#FFFFFF',\n    fontSize: 15,\n    fontWeight: '700',\n  },\n  dispositionSubtext: {\n    color: 'rgba(255, 255, 255, 0.8)',\n    fontSize: 11,\n  },\n  bottomActionsRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginTop: 12,\n  },\n  dncLinkButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n    padding: 8,\n  },\n  dncLinkText: {\n    color: '#EF4444',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  skipButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n    padding: 8,\n  },\n  skipButtonText: {\n    color: '#94A3B8',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  centerContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    gap: 14,\n  },\n  loadingText: {\n    color: '#94A3B8',\n    fontSize: 15,\n  },\n  finishedContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    paddingHorizontal: 32,\n  },\n  finishedTitle: {\n    fontSize: 26,\n    fontWeight: '800',\n    color: '#F8FAFC',\n    marginTop: 18,\n  },\n  finishedSubtitle: {\n    fontSize: 14,\n    color: '#94A3B8',\n    textAlign: 'center',\n    marginTop: 8,\n    lineHeight: 20,\n  },\n  sessionSummaryBox: {\n    flexDirection: 'row',\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    paddingVertical: 20,\n    paddingHorizontal: 36,\n    marginTop: 32,\n    alignItems: 'center',\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  summaryItem: {\n    alignItems: 'center',\n  },\n  summaryVal: {\n    fontSize: 28,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  summaryLabel: {\n    fontSize: 12,\n    color: '#94A3B8',\n    marginTop: 4,\n  },\n  summaryDivider: {\n    width: 1,\n    height: 40,\n    backgroundColor: '#334155',\n    marginHorizontal: 30,\n  },\n  returnButton: {\n    backgroundColor: '#2563EB',\n    paddingVertical: 16,\n    paddingHorizontal: 28,\n    borderRadius: 14,\n    marginTop: 36,\n  },\n  returnButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  modalOverlay: {\n    flex: 1,\n    backgroundColor: 'rgba(0,0,0,0.7)',\n    justifyContent: 'center',\n    padding: 20,\n  },\n  modalContent: {\n    backgroundColor: '#1E293B',\n    borderRadius: 20,\n    padding: 20,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  modalTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n    marginBottom: 14,\n  },\n  presetButtonsGrid: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: 8,\n  },\n  presetBtn: {\n    width: '48%',\n    backgroundColor: '#0F172A',\n    paddingVertical: 12,\n    paddingHorizontal: 10,\n    borderRadius: 8,\n    borderWidth: 1,\n    borderColor: '#334155',\n    alignItems: 'center',\n  },\n  presetBtnText: {\n    color: '#F8FAFC',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  templateScroll: {\n    flexDirection: 'row',\n    gap: 8,\n    marginBottom: 8,\n  },\n  templateChip: {\n    paddingHorizontal: 10,\n    paddingVertical: 6,\n    borderRadius: 8,\n    backgroundColor: '#0F172A',\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  activeChip: {\n    borderColor: '#3B82F6',\n    backgroundColor: 'rgba(59, 130, 246, 0.2)',\n  },\n  templateChipText: {\n    color: '#94A3B8',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  activeChipText: {\n    color: '#38BDF8',\n  },\n  modalInput: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 10,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    textAlignVertical: 'top',\n    height: 100,\n    fontSize: 14,\n  },\n  modalButtons: {\n    flexDirection: 'row',\n    justifyContent: 'flex-end',\n    marginTop: 16,\n    gap: 12,\n  },\n  modalCancelButton: {\n    paddingVertical: 10,\n    paddingHorizontal: 16,\n  },\n  modalCancelText: {\n    color: '#94A3B8',\n    fontSize: 15,\n    fontWeight: '600',\n  },\n  modalSaveButton: {\n    backgroundColor: '#10B981',\n    paddingVertical: 10,\n    paddingHorizontal: 20,\n    borderRadius: 10,\n  },\n  modalSaveText: {\n    color: '#FFFFFF',\n    fontSize: 15,\n    fontWeight: '700',\n  },\n});\n","Description":"Upgraded DialerHudScreen with PanResponder Swipe gestures and smart Callback Follow-up scheduler","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\DialerHudScreen.tsx","toolAction":"Updating DialerHudScreen.tsx with swipe gestures and callback scheduling","toolSummary":"Update DialerHudScreen.tsx with swipe & followups"}}]}
