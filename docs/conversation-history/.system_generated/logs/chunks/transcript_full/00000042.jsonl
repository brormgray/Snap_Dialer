{"step_index":1840,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-23T13:27:33Z","content":"Created At: 2026-08-23T09:27:33-04:00\nCompleted At: 2026-08-23T09:27:33-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/backupService.ts`\nTotal Lines: 303\nTotal Bytes: 11552\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Share, Alert, Platform } from 'react-native';\n2: import { getDatabase } from '../db/database';\n3: import { LeadsRepository } from '../db/leadsRepository';\n4: import { SettingsRepository } from '../db/settingsRepository';\n5: import { CadenceRepository } from '../db/cadenceRepository';\n6: \n7: export interface RestoreResult {\n8:   success: boolean;\n9:   leadCount: number;\n10:   message: string;\n11: }\n12: \n13: export class BackupService {\n14:   /**\n15:    * Generates a complete database snapshot payload.\n16:    */\n17:   static async generateBackupPayload(): Promise<any> {\n18:     const db = await getDatabase();\n19:     const lists = await LeadsRepository.getAllLists();\n20:     const leads = await db.getAllAsync('SELECT * FROM leads');\n21:     const callLogs = await db.getAllAsync('SELECT * FROM call_logs');\n22:     const cadenceRules = await CadenceRepository.getAllRules();\n23:     const smsTemplates = await CadenceRepository.getAllTemplates();\n24:     const settings = await SettingsRepository.getSettings();\n25: \n26:     return {\n27:       appName: 'SnapDialer',\n28:       target: 'ValuTeachers FRS Pipeline',\n29:       version: '2.0.0',\n30:       exportedAt: new Date().toISOString(),\n31:       leadCount: leads.length,\n32:       data: {\n33:         lists,\n34:         leads,\n35:         callLogs,\n36:         cadenceRules,\n37:         smsTemplates,\n38:         settings,\n39:       },\n40:     };\n41:   }\n42: \n43:   /**\n44:    * Exports full backup to local storage, Files app, iCloud Drive, Google Drive, or email share.\n45:    */\n46:   static async exportFullBackup(): Promise<boolean> {\n47:     try {\n48:       const payload = await this.generateBackupPayload();\n49:       const jsonString = JSON.stringify(payload, null, 2);\n50:       const dateStr = new Date().toISOString().slice(0, 10);\n51:       const filename = `SnapDialer_ValuTeachers_Backup_${dateStr}.json`;\n52: \n53:       if (Platform.OS === 'web' && typeof window !== 'undefined') {\n54:         const blob = new Blob([jsonString], { type: 'application/json' });\n55:         const file = new File([blob], filename, { type: 'application/json' });\n56: \n57:         // If Web Share API with files is supported (e.g. mobile Safari / Chrome)\n58:         if (navigator.canShare && navigator.canShare({ files: [file] })) {\n59:           try {\n60:             await navigator.share({\n61:               title: 'SnapDialer Backup',\n62:               text: `SnapDialer ValuTeachers Database Backup (${payload.leadCount} leads) - ${dateStr}`,\n63:               files: [file],\n64:             });\n65:             return true;\n66:           } catch (shareErr: any) {\n67:             if (shareErr?.name === 'AbortError') return true; // User cancelled share modal\n68:           }\n69:         }\n70: \n71:         // Fallback: Trigger direct file download\n72:         const url = URL.createObjectURL(blob);\n73:         const a = document.createElement('a');\n74:         a.href = url;\n75:         a.download = filename;\n76:         document.body.appendChild(a);\n77:         a.click();\n78:         document.body.removeChild(a);\n79:         URL.revokeObjectURL(url);\n80:         return true;\n81:       }\n82: \n83:       await Share.share({\n84:         title: filename,\n85:         message: jsonString,\n86:       });\n87: \n88:       return true;\n89:     } catch (e) {\n90:       console.error('Backup export failed:', e);\n91:       Alert.alert('Backup Error', 'Failed to generate cloud backup snapshot.');\n92:       return false;\n93:     }\n94:   }\n95: \n96:   /**\n97:    * Triggers a file browser picker (iCloud Drive, Google Drive, OneDrive, Files app, or local filesystem)\n98:    * to select and restore a .json backup file.\n99:    */\n100:   static async importBackupFromFile(overwrite: boolean = false): Promise<RestoreResult> {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":1841,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-23T13:27:33Z","thinking":"**Considering IndexedDB Implementation**\n\nI'm evaluating the `BackupService`, which currently exports/imports data. The main focus is upgrading the web's database layer to IndexedDB, switching from `localStorage`. I'm starting to think about building a dedicated **IndexedDB Storage Adapter**, which seems like a sound approach.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Creates high-capacity, robust IndexedDB storage driver with automatic migration and persistent storage for Web browsers.","UserFacing":false},"CodeContent":"/**\n * High-Capacity IndexedDB Storage Driver for Web Browsers\n * Solves the 5MB browser localStorage limit and provides multi-gigabyte, crash-proof persistence\n * for ValuTeachers leads, photos, call records, and notes.\n */\n\nconst DB_NAME = 'SnapDialerValuTeachersDB';\nconst DB_VERSION = 1;\nconst STORE_NAME = 'app_state';\nconst LEGACY_STORAGE_KEY = 'snap_dialer_valuteachers_data';\n\nexport interface DatabaseState {\n  lists: any[];\n  leads: any[];\n  call_logs: any[];\n  cadence_rules: any[];\n  sms_templates: any[];\n  settings: { key: string; value: string }[];\n}\n\nexport class IndexedDbStorage {\n  private static dbPromise: Promise<IDBDatabase> | null = null;\n\n  /**\n   * Opens or initializes the IndexedDB database connection\n   */\n  private static async getDb(): Promise<IDBDatabase> {\n    if (typeof window === 'undefined' || !window.indexedDB) {\n      throw new Error('IndexedDB not supported in current environment.');\n    }\n\n    if (!this.dbPromise) {\n      this.dbPromise = new Promise((resolve, reject) => {\n        const request = window.indexedDB.open(DB_NAME, DB_VERSION);\n\n        request.onupgradeneeded = (event: any) => {\n          const db = event.target.result as IDBDatabase;\n          if (!db.objectStoreNames.contains(STORE_NAME)) {\n            db.createObjectStore(STORE_NAME);\n          }\n        };\n\n        request.onsuccess = (event: any) => {\n          const db = event.target.result as IDBDatabase;\n\n          // Request persistent storage if supported by browser\n          if (navigator.storage && navigator.storage.persist) {\n            navigator.storage.persist().catch(() => {});\n          }\n\n          resolve(db);\n        };\n\n        request.onerror = (event: any) => {\n          console.error('IndexedDB open error:', event.target.error);\n          reject(event.target.error);\n        };\n      });\n    }\n\n    return this.dbPromise;\n  }\n\n  /**\n   * Loads the full database state from IndexedDB (with automatic migration from legacy localStorage)\n   */\n  static async loadState(): Promise<DatabaseState> {\n    try {\n      if (typeof window === 'undefined' || !window.indexedDB) {\n        return this.loadFromLocalStorageFallback();\n      }\n\n      const db = await this.getDb();\n      const stored = await new Promise<DatabaseState | null>((resolve, reject) => {\n        try {\n          const tx = db.transaction(STORE_NAME, 'readonly');\n          const store = tx.objectStore(STORE_NAME);\n          const request = store.get('root_state');\n\n          request.onsuccess = () => {\n            resolve(request.result || null);\n          };\n\n          request.onerror = () => {\n            reject(request.error);\n          };\n        } catch (e) {\n          reject(e);\n        }\n      });\n\n      if (stored) {\n        return this.normalizeState(stored);\n      }\n\n      // Check if we have legacy data in localStorage to migrate\n      const legacyState = this.loadFromLocalStorageFallback();\n      if (legacyState.leads.length > 0 || legacyState.lists.length > 0) {\n        await this.saveState(legacyState);\n        return legacyState;\n      }\n\n      return {\n        lists: [],\n        leads: [],\n        call_logs: [],\n        cadence_rules: [],\n        sms_templates: [],\n        settings: [],\n      };\n    } catch (e) {\n      console.warn('IndexedDB load failed, using localStorage fallback:', e);\n      return this.loadFromLocalStorageFallback();\n    }\n  }\n\n  /**\n   * Persists the entire database state to IndexedDB\n   */\n  static async saveState(state: DatabaseState): Promise<void> {\n    try {\n      if (typeof window === 'undefined' || !window.indexedDB) {\n        this.saveToLocalStorageFallback(state);\n        return;\n      }\n\n      const db = await this.getDb();\n      await new Promise<void>((resolve, reject) => {\n        try {\n          const tx = db.transaction(STORE_NAME, 'readwrite');\n          const store = tx.objectStore(STORE_NAME);\n          const request = store.put(state, 'root_state');\n\n          request.onsuccess = () => {\n            resolve();\n          };\n\n          request.onerror = () => {\n            reject(request.error);\n          };\n        } catch (e) {\n          reject(e);\n        }\n      });\n\n      // Also keep a lightweight mirror in localStorage (without large base64 images) as a secondary backup\n      this.saveToLocalStorageFallback(state, true);\n    } catch (e) {\n      console.error('IndexedDB save failed:', e);\n      this.saveToLocalStorageFallback(state, true);\n    }\n  }\n\n  /**\n   * Normalizes fields for backwards compatibility\n   */\n  private static normalizeState(raw: any): DatabaseState {\n    const leads = (Array.isArray(raw?.leads) ? raw.leads : []).map((l: any) => ({\n      ...l,\n      priority_tier: l.priority_tier !== undefined && l.priority_tier !== null ? Number(l.priority_tier) : 1,\n      list_id: l.list_id || 'master_queue',\n      attempts_count: l.attempts_count || 0,\n      cadence_step: l.cadence_step || 1,\n      last_disposition: l.last_disposition || 'pending',\n    }));\n\n    return {\n      lists: Array.isArray(raw?.lists) ? raw.lists : [],\n      leads,\n      call_logs: Array.isArray(raw?.call_logs) ? raw.call_logs : [],\n      cadence_rules: Array.isArray(raw?.cadence_rules) ? raw.cadence_rules : [],\n      sms_templates: Array.isArray(raw?.sms_templates) ? raw.sms_templates : [],\n      settings: Array.isArray(raw?.settings) ? raw.settings : [],\n    };\n  }\n\n  private static loadFromLocalStorageFallback(): DatabaseState {\n    try {\n      if (typeof window !== 'undefined' && window.localStorage) {\n        const saved = localStorage.getItem(LEGACY_STORAGE_KEY);\n        if (saved) {\n          const parsed = JSON.parse(saved);\n          return this.normalizeState(parsed);\n        }\n      }\n    } catch (e) {\n      console.warn('localStorage fallback load failed:', e);\n    }\n\n    return {\n      lists: [],\n      leads: [],\n      call_logs: [],\n      cadence_rules: [],\n      sms_templates: [],\n      settings: [],\n    };\n  }\n\n  private static saveToLocalStorageFallback(state: DatabaseState, stripHeavyImages: boolean = false) {\n    try {\n      if (typeof window !== 'undefined' && window.localStorage) {\n        let payload = state;\n        if (stripHeavyImages) {\n          // Strip massive base64 strings so localStorage never exceeds 5MB\n          payload = {\n            ...state,\n            leads: state.leads.map((l) => ({\n              ...l,\n              source_image_uri: (l.source_image_uri && l.source_image_uri.length > 200) ? 'stored_in_indexeddb' : l.source_image_uri,\n            })),\n          };\n        }\n        localStorage.setItem(LEGACY_STORAGE_KEY, JSON.stringify(payload));\n      }\n    } catch (e) {\n      // If localStorage is full, IndexedDB has already saved the complete dataset.\n    }\n  }\n}\n","Description":"IndexedDB storage manager for web browsers with unlimited capacity","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\db\\indexedDbStorage.ts","toolAction":"Creating indexedDbStorage.ts","toolSummary":"Create indexedDbStorage.ts"}}]}
