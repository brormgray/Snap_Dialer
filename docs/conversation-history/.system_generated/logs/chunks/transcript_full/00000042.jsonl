2:       } catch (e) {\n33:         // Fall through to interactive camera cropper\n34:       }\n35:     }\n36: \n37:     // 2. Interactive Camera Cropper Fallback (Works in Expo Go & Standard Mobile)\n38:     const permission = await ImagePicker.requestCameraPermissionsAsync();\n39:     if (!permission.granted) {\n40:       throw new Error('Camera permission is required to scan lead sheets.');\n41:     }\n42: \n43:     const result = await ImagePicker.launchCameraAsync({\n44:       mediaTypes: ImagePicker.MediaTypeOptions.Images,\n45:       allowsEditing: true,\n46:       quality: 0.85,\n47:     });\n48: \n49:     if (!result.canceled && result.assets[0]) {\n50:       return await this.downsampleAndCompress(result.assets[0].uri);\n51:     }\n52: \n53:     return null;\n54:   }\n55: \n56:   /**\n57:    * Universal On-Device Downsampling & Compression Pipeline:\n58:    * Resizes raw 48MP iPhone photos (8MB–12MB) down to 1600px width JPEG (quality 0.75, <250KB)\n59:    * on-device before any API or OCR processing.\n60:    */\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
