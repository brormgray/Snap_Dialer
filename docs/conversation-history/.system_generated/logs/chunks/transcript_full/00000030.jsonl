_disposition;\n    if (disp === 'connected') {\n      return { label: 'Sit-Down Set', bg: Colors.statusSitDownBg, color: Colors.statusSitDownText };\n    }\n    if (disp === 'callback_requested' || lead.follow_up_at) {\n      return { label: 'Callback Scheduled', bg: Colors.statusCallbackBg, color: Colors.statusCallbackText };\n    }\n    if (disp === 'voicemail') {\n      return { label: `Voicemail (${lead.attempts_count})`, bg: Colors.statusUnansweredBg, color: Colors.statusUnansweredText };\n    }\n    if (disp === 'no_answer') {\n      return { label: `No Answer (${lead.attempts_count})`, bg: Colors.statusUnansweredBg, color: Colors.statusUnansweredText };\n    }\n    if (disp === 'do_not_call') {\n      return { label: 'Do Not Call', bg: Colors.statusDangerBg, color: Colors.statusDangerText };\n    }\n    return { label: 'Ready to Call', bg: Colors.statusPendingBg, color: Colors.statusPendingText };\n  };\n\n  // Stats calculation\n  const totalCount = leads.length;\n  const pendingCount = leads.filter(\n    (l) => !l.last_disposition || ['pending', 'no_answer', 'voicemail'].includes(l.last_disposition)\n  ).length;\n  const connectedCount = leads.filter((l) => l.last_disposition === 'connected').length;\n  const callbackCount = leads.filter((l) => l.last_disposition === 'callback_requested' || !!l.follow_up_at).length;\n  const unansweredCount = leads.filter((l) => ['no_answer', 'voicemail'].includes(l.last_disposition || '')).length;\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor={Colors.sacredGreenDeep} />\n\n      {/* App Header */}\n      <View style={styles.header}>\n        <View style={styles.titleArea}>\n          <Text style={styles.appTitle}>SnapDialer</Text>\n          <Text style={styles.appSubtitle}>ValuTeachers • Florida FRS Pipeline</Text>\n        </View>\n        <View style={styles.headerIcons}>\n          <TouchableOpacity\n            style={styles.snapHeaderButton}\n            onPress={() => {\n              HapticsService.medium();\n              navigation.navigate('ScanSheet');\n            }}\n          >\n            <Camera size={18} color={Colors.livingWhite} />\n            <Text style={styles.snapHeaderButtonText}>Snap Card</Text>\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={styles.iconButton}\n            onPress={() => navigation.navigate('Analytics')}\n          >\n            <BarChart3 size={22} color={Colors.heavenlyGold} />\n          </TouchableOpacity>\n          <TouchableOpacity\n            style={styles.iconButton}\n            onPress={() => navigation.navigate('Settings')}\n          >\n            <Settings size={22} color={Colors.heavenlyGold} />\n          </TouchableOpacity>\n        </View>\n      </View>\n\n      {/* KPI Stats Strip */}\n      <View style={styles.statsRow}>\n        <View style={styles.statCard}>\n          <Text style={styles.statNumber}>{totalCount}</Text>\n          <Text style={styles.statLabel}>Educators</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: Colors.borderSubtle }]}>\n          <Text style={[styles.statNumber, { color: Colors.deepSkyBlueLight }]}>{pendingCount}</Text>\n          <Text style={styles.statLabel}>To Call</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: Colors.borderSubtle }]}>\n          <Text style={[styles.statNumber, { color: Colors.statusSitDownText }]}>{connectedCount}</Text>\n          <Text style={styles.statLabel}>Sit-Downs</Text>\n        </View>\n        <View style={[styles.statCard, { borderLeftWidth: 1, borderLeftColor: Colors.borderSubtle }]}>\n          <Text style={[styles.statNumber, { color: Colors.heavenlyGold }]}>{callbackCount}</Text>\n          <Text style={styles.statLabel}>Follow-Ups</Text>\n        </View>\n      </View>","TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-