sService.success();\n    const db = await import('../db/database').then((m) => m.getDatabase());\n    await db.runAsync(\n      `UPDATE leads \n       SET name = ?, phone = ?, school = ?, email = ?, planning_period = ?, years_in_frs = ?, notes = ?, priority_tier = ?, list_id = ?, updated_at = ? \n       WHERE id = ?`,\n      [name, phone, school, email.trim() || null, planningPeriod, yearsInFrs, notes, priorityTier, listIdVal, new Date().toISOString(), lead.id]\n    );\n\n    setIsEditing(false);\n    loadLeadData();\n    Alert.alert('Saved', 'Educator details updated.');\n  };","StartLine":67,"TargetContent":"  // Edit form state\n  const [name, setName] = useState<string>('');\n  const [phone, setPhone] = useState<string>('');\n  const [school, setSchool] = useState<string>('');\n  const [planningPeriod, setPlanningPeriod] = useState<string>('');\n  const [yearsInFrs, setYearsInFrs] = useState<string>('');\n  const [notes, setNotes] = useState<string>('');\n  const [priorityTier, setPriorityTier] = useState<number>(1);\n  const [listIdVal, setListIdVal] = useState<string>('master_queue');\n\n  useEffect(() => {\n    loadLeadData();\n  }, [leadId]);\n\n  const loadLeadData = async () => {\n    const [l, lists] = await Promise.all([\n      LeadsRepository.getLeadById(leadId),\n      LeadsRepository.getAllLists(),\n    ]);\n\n    if (l) {\n      setLead(l);\n      setName(l.name);\n      setPhone(l.phone);\n      setSchool(l.school || '');\n      setPlanningPeriod(l.planning_period || '');\n      setYearsInFrs(l.years_in_frs || '');\n      setNotes(l.notes || '');\n      setPriorityTier(l.priority_tier || 1);\n      setListIdVal(l.list_id || 'master_queue');\n    }\n    setAvailableLists(lists);\n\n    const history = await CallLogsRepository.getLogsForLead(leadId);\n    setLogs(history);\n  };\n\n  const handleTogglePriority = async () => {\n    if (!lead) return;\n    await HapticsService.medium();\n    const newTier = (lead.priority_tier === 3) ? 1 : 3;\n    await