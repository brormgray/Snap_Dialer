ncing to next contact in {autoAdvanceCountdown}s...\n          </Text>\n          <TouchableOpacity\n            onPress={() => {\n              if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n              setAutoAdvanceCountdown(null);\n            }}\n          >\n            <Text style={styles.countdownCancel}>Pause</Text>\n          </TouchableOpacity>\n        </View>\n      )}\n\n      {/* Main Swipeable Educator Contact Card */}\n      <Animated.View\n        style={[\n          styles.contactCard,\n          {\n            transform: [{ translateX: pan.x }],\n          },\n        ]}\n        {...panResponder.panHandlers}\n      >\n        {/* Swipe Feedback Banner */}\n        {swipeActionText && (\n          <View style={styles.swipeIndicator}>\n            <Text style={styles.swipeIndicatorText}>{swipeActionText}</Text>\n          </View>\n        )}\n\n        {/* Educator Header & School */}\n        <View style={styles.contactTopRow}>\n          <View style={styles.avatarCircle}>\n            <GraduationCap size={28} color=\"#38BDF8\" />\n          </View>\n          <View style={{ flex: 1, marginLeft: 12 }}>\n            <Text style={styles.contactName}>{currentLead.name}</Text>\n            <Text style={styles.contactPhone}>{currentLead.phone}</Text>\n            {currentLead.email ? (\n              <Text style={styles.contactEmail}>{currentLead.email}</Text>\n            ) : null}\n          </View>\n          <View style={styles.attemptBadge}>\n            <Text style={styles.attemptText}>\n              Call #{currentLead.attempts_count + 1}\n            </Text>\n          </View>\n        </View>\n\n        {/* School & FRS Profile Ribbon */}\n        <View style={styles.frsRibbon}>\n          <View style={styles.ribbonItem}>\n            <School size={14} color=\"#38BDF8\" />\n            <Text style={styles.ribbonText}>\n              {currentLead.school || 'School District'}\n              {currentLead.room_number ? ` • Rm ${currentLead.room_number}` : ''}\n              {currentLead.planning_period ? ` • ${currentLead.planning_period}` : ''}\n            </Text>\n          </View>\n          <View style={styles.ribbonRow}>\n            {currentLead.years_in_frs ? (\n              <View style={styles.tagBadge}>\n                <Text style={styles.tagText}>🎓 {currentLead.years_in_frs} Yrs in FRS</Text>\n              </View>\n            ) : null}\n            {currentLead.age ? (\n              <View style={styles.tagBadge}>\n                <Text style={styles.tagText}>Age: {currentLead.age}</Text>\n              </View>\n            ) : null}\n            {currentLead.frs_knowledge ? (\n              <View style={[styles.tagBadge, { backgroundColor: 'rgba(245, 158, 11, 0.15)', borderColor: '#F59E0B' }]}>\n                <Text style={[styles.tagText, { color: '#F59E0B' }]}>\n                  FRS: \"{currentLead.frs_knowledge}\"\n                </Text>\n              </View>\n            ) : null}\n          </View>\n        </View>\n\n        {/* FRS Report Card Checkboxes / Hot-Buttons */}\n        {currentLead.frs_interests && currentLead.frs_interests.length > 0 && (\n          <View style={styles.interestsBox}>\n            <Text style={styles.interestsHeader}>REPORT CARD NEEDS & QUESTIONS:</Text>\n            {currentLead.frs_interests.map((interest, idx) => (\n              <View key={idx} style={styles.interestRow}>\n                <Check size={14} color=\"#10B981\" />\n                <Text style={styles.interestText}>{interest}</Text>\n              </View>\n            ))}\n          </View>\n        )}\n\n        {/* Custom Written Questions */}\n        {currentLead.custom_questions ? (\n          <View style={styles.customQuestionBox}>\n            <HelpCircle size={14} color=\"#F59E0B\" />\n            <Text style={styles.customQuestionText}>\n              Q: \"{currentLead.custom_questions}\"\n            </Text>\n          </View>\n        ) : null}\n\n        {/* Preferred Meeting Availability Callout */}\n        {currentLead.meeting_preferences && currentLead.meeting_preferences.length > 0 && (\n          <View style={styles.meetingPrefsBox}>\n            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6, marginBottom: 4 }}>\n              <Calendar size={14} color=\"#8B5CF6\" />\n              <Text style={styles.meetingPrefsTitle}>REQUESTED MEETING AVAILABILITY:</Text>\n            </View>\n            <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6 }}>\n              {currentLead.meeting_preferences.map((pref, idx) => (\n                <View key={idx} style={styles.prefChip}>\n                  <Text style={styles.prefChipText}>{pref}</Text>\n                </View>\n              ))}\n            </View>\n          </View>\n        )}\n\n        {/* Proof of Contact / View Scanned Sheet Button */}\n        <TouchableOpacity\n          style={styles.proofButton}\n          onPress={() => {\n            HapticsService.tick();\n            setImageModalVisible(true);\n          }}\n          activeOpacity={0.7}\n        >\n          <FileCheck size={16} color=\"#38BDF8\" />\n          <Text style={styles.proofButtonText}>View Original Report Card (Proof of Request)</Text>\n          <Eye size={16} color=\"#38BDF8\" />\n        </TouchableOpacity>\n\n        {/* Live Call Duration Meter */}\n        {isOnCall && (\n          <View style={styles.callDurationBox}>\n            <Clock size={16} color=\"#10B981\" />\n            <Text style={styles.callDurationText}>\n              Call in progress: {Math.floor(callDuration / 60)}:\n              {(callDuration % 60).toString().padStart(2, '0')}\n            </Text>\n          </View>\n        )}\n\n        {/* Big Dial Trigger Button */}\n        <TouchableOpacity\n          style={[styles.mainDialButton, isOnCall && { backgroundColor: '#059669' }]}\n          onPress={handleDial}\n          activeOpacity={0.8}\n        >\n          <PhoneCall size={24} color=\"#FFFFFF\" />\n          <Text style={styles.mainDialButtonText}>\n            {isOnCall ? 'Redial ' + currentLead.phone : 'Dial ' + currentLead.phone}\n          </Text>\n        </TouchableOpacity>\n\n        {/* Gesture Hint */}\n        <Text style={styles.gestureHint}>👉 Swipe right to Dial • Swipe left to Skip 👈</Text>\n      </Animated.View>\n\n      {/* Giant 1-Tap Disposition Controls */}\n      <View style={styles.dispositionContainer}>\n        <Text style={styles.dispositionHeading}>LOG CALL OUTCOME (1-TAP)</Text>\n\n        <View style={styles.buttonGrid}>\n          {/* No Answer / VM Drop */}\n          <TouchableOpacity\n            style={[styles.dispositionButton, { backgroundColor: '#F59E0B' }]}\n            onPress={() => handleDisposition('no_answer')}\n            activeOpacity={0.7}\n          >\n            <PhoneOff size={22} color=\"#FFFFFF\" />\n            <Text style={styles.dispositionButtonText}>No Answer / VM</Text>\n            <Text style={styles.dispositionSubtext}>Advance & check SMS</Text>\n          </TouchableOpacity>\n\n          {/* Connected / Qualified */}\n          <TouchableOpacity\n            style={[styles.dispositionButton, { backgroundColor: '#10B981' }]}\n            onPress={() => {\n              setCallNote('');\n              setNoteModalVisible(true);\n            }}\n            activeOpacity={0.7}\n          >\n            <CheckCircle2 size={22} color=\"#FFFFFF\" />\n            <Text style={styles.dispositionButtonText}>Connected</Text>\n            <Text style={styles.dispositionSubtext}>Record meeting date</Text>\n          </TouchableOpacity>\n\n          {/* Quick SMS */}\n          <TouchableOpacity\n            style={[styles.dispositionButton, { backgroundColor: '#3B82F6' }]}\n            onPress={openSmsModal}\n            activeOpacity={0.7}\n          >\n            <MessageSquare size={22} color=\"#FFFFFF\" />\n            <Text style={styles.dispositionButtonText}>ValuTeachers SMS</Text>\n            <Text style={styles.dispositionSubtext}>AI compose & send</Text>\n          </TouchableOpacity>\n\n          {/* Schedule Follow-up */}\n          <TouchableOpacity\n            style={[styles.dispositionButton, { backgroundColor: '#8B5CF6' }]}\n            onPress={() => setFollowUpModalVisible(true)}\n            activeOpacity={0.7}\n          >\n            <Calendar size={22} color=\"#FFFFFF\" />\n            <Text style={styles.dispositionButtonText}>Callback</Text>\n            <Text style={styles.dispositionSubtext}>Schedule reminder</Text>\n          </TouchableOpacity>\n        </View>\n\n        {/* Bottom Actions Row */}\n        <View style={styles.bottomActionsRow}>\n          <TouchableOpacity style={styles.dncLinkButton} onPress={handleMarkDNC}>\n            <ShieldAlert size={16} color=\"#EF4444\" />\n            <Text style={styles.dncLinkText}>Block / DNC</Text>\n          </TouchableOpacity>\n\n          <TouchableOpacity style={styles.skipButton} onPress={advanceNextLead}>\n            <SkipForward size={16} color=\"#94A3B8\" />\n            <Text style={styles.skipButtonText}>Skip Contact</Text>\n          </TouchableOpacity>\n        </View>\n      </View>\n\n      {/* Proof of Request / Original Image Modal */}\n      <Modal visible={imageModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.imageModalOverlay}>\n          <View style={styles.imageModalContent}>\n            <View style={styles.imageModalHeader}>\n              <View style={{ flex: 1 }}>\n                <Text style={styles.imageModalTitle}>Proof of Contact Request</Text>\n                <Text style={styles.imageModalSubtitle}>\n                  {currentLead.name} • {currentLead.school || 'ValuTeachers'}\n                </Text>\n              </View>\n              <TouchableOpacity\n                style={styles.imageModalCloseBtn}\n                onPress={() => setImageModalVisible(false)}\n              >\n                <X size={22} color=\"#F8FAFC\" />\n              </TouchableOpacity>\n            </View>\n\n            <View style={styles.imageFrame}>\n              <Image\n                source={\n                  currentLead.source_image_uri\n                    ? { uri: currentLead.source_image_uri }\n                    : require('../assets/sample_report_card.png')\n                }\n                style={styles.proofImage}\n                resizeMode=\"contain\"\n              />\n            </View>\n\n            <View style={styles.complianceFooter}>\n              <FileCheck size={16} color=\"#10B981\" />\n              <Text style={styles.complianceText}>\n                Verified Written Consent & Report Card Submission on Record\n              </Text>\n            </View>\n          </View>\n        </View>\n      </Modal>\n\n      {/* Connected Call Notes Modal */}\n      <Modal visible={noteModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.modalOverlay}>\n          <View style={styles.modalContent}>\n            <Text style={styles.modalTitle}>Meeting Notes: {currentLead.name}</Text>\n            <TextInput\n              style={styles.modalInput}\n              placeholder=\"Enter scheduled meeting time, retirement goals, or follow-up details...\"\n              placeholderTextColor=\"#64748B\"\n              multiline\n              numberOfLines={4}\n              value={callNote}\n              onChangeText={setCallNote}\n              autoFocus\n            />\n            <View style={styles.modalButtons}>\n              <TouchableOpacity\n                style={styles.modalCancelButton}\n                onPress={() => setNoteModalVisible(false)}\n              >\n                <Text style={styles.modalCancelText}>Cancel</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={styles.modalSaveButton}\n                onPress={() => {\n                  setNoteModalVisible(false);\n                  handleDisposition('connected', callNote);\n                }}\n              >\n                <Text style={styles.modalSaveText}>Save & Next</Text>\n              </TouchableOpacity>\n            </View>\n          </View>\n        </View>\n      </Modal>\n\n      {/* Schedule Follow-up Modal */}\n      <Modal visible={followUpModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.modalOverlay}>\n          <View style={styles.modalContent}>\n            <Text style={styles.modalTitle}>Schedule Callback: {currentLead.name}</Text>\n            <Text style={{ color: '#94A3B8', fontSize: 13, marginBottom: 12 }}>\n              Choose a quick callback window based on educator availability:\n            </Text>\n\n            <View style={styles.presetButtonsGrid}>\n              <TouchableOpacity\n                style={styles.presetBtn}\n                onPress={() => handleScheduleFollowUp(2)}\n              >\n                <Text style={styles.presetBtnText}>⏱️ In 2 Hours</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity\n                style={styles.presetBtn}\n                onPress={() => handleScheduleFollowUp(24)}\n              >\n                <Text style={styles.presetBtnText}>🌅 Tomorrow 10 AM</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity\n                style={styles.presetBtn}\n                onPress={() => handleScheduleFollowUp(48)}\n              >\n                <Text style={styles.presetBtnText}>📅 In 2 Days</Text>\n              </TouchableOpacity>\n\n              <TouchableOpacity\n                style={styles.presetBtn}\n                onPress={() => handleScheduleFollowUp(168)}\n              >\n                <Text style={styles.presetBtnText}>📆 Next Week</Text>\n              </TouchableOpacity>\n            </View>\n\n            <TextInput\n              style={[styles.modalInput, { height: 60, marginTop: 12 }]}\n              placeholder=\"Add reminder note (e.g. Call back during 4th period planning)...\"\n              placeholderTextColor=\"#64748B\"\n              value={followUpNote}\n              onChangeText={setFollowUpNote}\n            />\n\n            <View style={styles.modalButtons}>\n              <TouchableOpacity\n                style={styles.modalCancelButton}\n                onPress={() => setFollowUpModalVisible(false)}\n              >\n                <Text style={styles.modalCancelText}>Cancel</Text>\n              </TouchableOpacity>\n            </View>\n          </View>\n        </View>\n      </Modal>\n\n      {/* AI-Powered Multi-template SMS Modal */}\n      <Modal visible={smsModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.modalOverlay}>\n          <View style={styles.modalContent}>\n            <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>\n              <Text style={styles.modalTitle}>Draft Text Message</Text>\n              <TouchableOpacity\n                style={styles.aiGenerateBtn}\n                onPress={() => handleGenerateAiSms()}\n                disabled={isGeneratingAi}\n              >\n                {isGeneratingAi ? (\n                  <ActivityIndicator size=\"small\" color=\"#38BDF8\" />\n                ) : (\n                  <>\n                    <Sparkles size={14} color=\"#38BDF8\" />\n                    <Text style={styles.aiGenerateBtnText}>AI Re-Draft</Text>\n                  </>\n                )}\n              </TouchableOpacity>\n            </View>\n\n            <Text style={{ color: '#94A3B8', fontSize: 12, marginBottom: 8 }}>\n              Preview & edit before sending. Gemini crafts personalized copy based on call notes and FRS needs:\n            </Text>\n\n            {/* Quick Focus Chips */}\n            <View style={styles.focusChipRow}>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('meeting_confirmation')}\n              >\n                <Text style={styles.focusChipText}>🎯 Meeting Slot</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('drop_bonus_focus')}\n              >\n                <Text style={styles.focusChipText}>💰 5% Bonus & DROP</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('planning_period')}\n              >\n                <Text style={styles.focusChipText}>🏫 Planning Period</Text>\n              </TouchableOpacity>\n            </View>\n\n            <TextInput\n              style={[styles.modalInput, { height: 120, marginTop: 8 }]}\n              value={customSmsBody}\n              onChangeText={setCustomSmsBody}\n              multiline\n              placeholder=\"Drafting persuasive SMS...\"\n              placeholderTextColor=\"#64748B\"\n            />\n\n            <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 4 }}>\n              <Text style={{ color: '#64748B', fontSize: 11 }}>\n                {customSmsBody.length} characters • Editable\n              </Text>\n            </View>\n\n            <View style={styles.modalButtons}>\n              <TouchableOpacity\n                style={styles.modalCancelButton}\n                onPress={() => setSmsModalVisible(false)}\n              >\n                <Text style={styles.modalCancelText}>Cancel</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={[styles.modalSaveButton, { backgroundColor: '#2563EB' }]}\n                onPress={handleSendCustomSms}\n              >\n                <Text style={styles.modalSaveText}>Open in SMS App</Text>\n              </TouchableOpacity>\n            </View>\n          </View>\n        </View>\n      </Modal>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 12,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  queueCounter: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  listSubheading: {\n    fontSize: 12,\n    color: '#94A3B8',\n  },\n  pauseButton: {\n    padding: 8,\n  },\n  countdownBanner: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    backgroundColor: '#1E3A8A',\n    paddingVertical: 10,\n    paddingHorizontal: 20,\n  },\n  countdownText: {\n    color: '#93C5FD',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  countdownCancel: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 13,\n  },\n  contactCard: {\n    backgroundColor: '#1E293B',\n    margin: 14,\n    borderRadius: 20,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  swipeIndicator: {\n    backgroundColor: '#2563EB',\n    paddingVertical: 4,\n    borderRadius: 6,\n    alignItems: 'center',\n    marginBottom: 8,\n  },\n  swipeIndicatorText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 12,\n  },\n  contactTopRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n  },\n  avatarCircle: {\n    width: 48,\n    height: 48,\n    borderRadius: 24,\n    backgroundColor: '#0F172A',\n    alignItems: 'center',\n    justifyContent: 'center',\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n  },\n  contactName: {\n    fontSize: 19,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  contactPhone: {\n    fontSize: 15,\n    color: '#38BDF8',\n    fontWeight: '600',\n    marginTop: 1,\n  },\n  contactEmail: {\n    fontSize: 12,\n    color: '#94A3B8',\n    marginTop: 1,\n  },\n  attemptBadge: {\n    backgroundColor: '#334155',\n    paddingHorizontal: 8,\n    paddingVertical: 4,\n    borderRadius: 8,\n  },\n  attemptText: {\n    color: '#38BDF8',\n    fontSize: 11,\n    fontWeight: '700',\n  },\n  frsRibbon: {\n    backgroundColor: '#0F172A',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 6,\n  },\n  ribbonItem: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n  },\n  ribbonText: {\n    color: '#CBD5E1',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  ribbonRow: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: 6,\n    marginTop: 2,\n  },\n  tagBadge: {\n    backgroundColor: '#1E293B',\n    paddingHorizontal: 8,\n    paddingVertical: 3,\n    borderRadius: 6,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  tagText: {\n    color: '#38BDF8',\n    fontSize: 11,\n    fontWeight: '600',\n  },\n  interestsBox: {\n    backgroundColor: 'rgba(16, 185, 129, 0.08)',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 10,\n    borderWidth: 1,\n    borderColor: 'rgba(16, 185, 129, 0.3)',\n    gap: 4,\n  },\n  interestsHeader: {\n    color: '#10B981',\n    fontSize: 10,\n    fontWeight: '800',\n    letterSpacing: 0.5,\n    marginBottom: 2,\n  },\n  interestRow: {\n    flexDirection: 'row',\n    alignItems: 'flex-start',\n    gap: 6,\n  },\n  interestText: {\n    color: '#F8FAFC',\n    fontSize: 12,\n    fontWeight: '500',\n    flex: 1,\n    lineHeight: 16,\n  },\n  customQuestionBox: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(245, 158, 11, 0.1)',\n    borderRadius: 8,\n    padding: 8,\n    marginTop: 8,\n    borderWidth: 1,\n    borderColor: '#F59E0B',\n    gap: 6,\n  },\n  customQuestionText: {\n    color: '#F59E0B',\n    fontSize: 12,\n    fontWeight: '600',\n    flex: 1,\n  },\n  meetingPrefsBox: {\n    backgroundColor: 'rgba(139, 92, 246, 0.12)',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 8,\n    borderWidth: 1,\n    borderColor: '#8B5CF6',\n  },\n  meetingPrefsTitle: {\n    color: '#A78BFA',\n    fontSize: 10,\n    fontWeight: '800',\n    letterSpacing: 0.5,\n  },\n  prefChip: {\n    backgroundColor: '#0F172A',\n    paddingHorizontal: 8,\n    paddingVertical: 4,\n    borderRadius: 6,\n    borderWidth: 1,\n    borderColor: '#8B5CF6',\n  },\n  prefChipText: {\n    color: '#F8FAFC',\n    fontSize: 11,\n    fontWeight: '700',\n  },\n  proofButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    backgroundColor: 'rgba(56, 189, 248, 0.1)',\n    paddingVertical: 8,\n    paddingHorizontal: 12,\n    borderRadius: 8,\n    marginTop: 10,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n  },\n  proofButtonText: {\n    color: '#38BDF8',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  callDurationBox: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: 'rgba(16, 185, 129, 0.15)',\n    paddingVertical: 6,\n    borderRadius: 8,\n    marginTop: 10,\n    gap: 6,\n  },\n  callDurationText: {\n    color: '#10B981',\n    fontWeight: '700',\n    fontSize: 13,\n  },\n  mainDialButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#10B981',\n    paddingVertical: 14,\n    borderRadius: 14,\n    marginTop: 12,\n    gap: 8,\n    shadowColor: '#10B981',\n    shadowOffset: { width: 0, height: 4 },\n    shadowOpacity: 0.3,\n    shadowRadius: 8,\n    elevation: 6,\n  },\n  mainDialButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '800',\n  },\n  gestureHint: {\n    color: '#64748B',\n    fontSize: 10,\n    textAlign: 'center',\n    marginTop: 8,\n    fontWeight: '600',\n  },\n  dispositionContainer: {\n    flex: 1,\n    paddingHorizontal: 14,\n    justifyContent: 'flex-end',\n    paddingBottom: 14,\n  },\n  dispositionHeading: {\n    color: '#64748B',\n    fontSize: 11,\n    fontWeight: '700',\n    letterSpacing: 1,\n    marginBottom: 8,\n    textAlign: 'center',\n  },\n  buttonGrid: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: 8,\n  },\n  dispositionButton: {\n    width: '48.5%',\n    paddingVertical: 14,\n    borderRadius: 14,\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 3,\n  },\n  dispositionButtonText: {\n    color: '#FFFFFF',\n    fontSize: 14,\n    fontWeight: '700',\n  },\n  dispositionSubtext: {\n    color: 'rgba(255, 255, 255, 0.8)',\n    fontSize: 11,\n  },\n  bottomActionsRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginTop: 10,\n  },\n  dncLinkButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n    padding: 6,\n  },\n  dncLinkText: {\n    color: '#EF4444',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  skipButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n    padding: 6,\n  },\n  skipButtonText: {\n    color: '#94A3B8',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  centerContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    gap: 14,\n  },\n  loadingText: {\n    color: '#94A3B8',\n    fontSize: 15,\n  },\n  finishedContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    paddingHorizontal: 32,\n  },\n  finishedTitle: {\n    fontSize: 26,\n    fontWeight: '800',\n    color: '#F8FAFC',\n    marginTop: 18,\n  },\n  finishedSubtitle: {\n    fontSize: 14,\n    color: '#94A3B8',\n    textAlign: 'center',\n    marginTop: 8,\n    lineHeight: 20,\n  },\n  sessionSummaryBox: {\n    flexDirection: 'row',\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    paddingVertical: 20,\n    paddingHorizontal: 36,\n    marginTop: 32,\n    alignItems: 'center',\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  summaryItem: {\n    alignItems: 'center',\n  },\n  summaryVal: {\n    fontSize: 28,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  summaryLabel: {\n    fontSize: 12,\n    color: '#94A3B8',\n    marginTop: 4,\n  },\n  summaryDivider: {\n    width: 1,\n    height: 40,\n    backgroundColor: '#334155',\n    marginHorizontal: 30,\n  },\n  returnButton: {\n    backgroundColor: '#2563EB',\n    paddingVertical: 16,\n    paddingHorizontal: 28,\n    borderRadius: 14,\n    marginTop: 36,\n  },\n  returnButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  modalOverlay: {\n    flex: 1,\n    backgroundColor: 'rgba(0,0,0,0.7)',\n    justifyContent: 'center',\n    padding: 20,\n  },\n  modalContent: {\n    backgroundColor: '#1E293B',\n    borderRadius: 20,\n    padding: 20,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  modalTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  aiGenerateBtn: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(56, 189, 248, 0.15)',\n    paddingHorizontal: 10,\n    paddingVertical: 6,\n    borderRadius: 8,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n    gap: 4,\n  },\n  aiGenerateBtnText: {\n    color: '#38BDF8',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  focusChipRow: {\n    flexDirection: 'row',\n    gap: 6,\n    marginBottom: 6,\n  },\n  focusChip: {\n    backgroundColor: '#0F172A',\n    paddingHorizontal: 8,\n    paddingVertical: 4,\n    borderRadius: 6,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  focusChipText: {\n    color: '#CBD5E1',\n    fontSize: 11,\n    fontWeight: '600',\n  },\n  imageModalOverlay: {\n    flex: 1,\n    backgroundColor: 'rgba(0,0,0,0.85)',\n    justifyContent: 'center',\n    padding: 16,\n  },\n  imageModalContent: {\n    backgroundColor: '#0F172A',\n    borderRadius: 20,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n    maxHeight: '90%',\n  },\n  imageModalHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginBottom: 12,\n  },\n  imageModalTitle: {\n    fontSize: 17,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  imageModalSubtitle: {\n    fontSize: 12,\n    color: '#38BDF8',\n    marginTop: 2,\n    fontWeight: '600',\n  },\n  imageModalCloseBtn: {\n    padding: 6,\n    backgroundColor: '#1E293B',\n    borderRadius: 10,\n  },\n  imageFrame: {\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    overflow: 'hidden',\n    height: 400,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  proofImage: {\n    width: '100%',\n    height: '100%',\n  },\n  complianceFooter: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(16, 185, 129, 0.15)',\n    padding: 10,\n    borderRadius: 10,\n    marginTop: 12,\n    gap: 8,\n  },\n  complianceText: {\n    color: '#10B981',\n    fontSize: 12,\n    fontWeight: '700',\n    flex: 1,\n  },\n  presetButtonsGrid: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: 8,\n  },\n  presetBtn: {\n    width: '48%',\n    backgroundColor: '#0F172A',\n    paddingVertical: 12,\n    paddingHorizontal: 10,\n    borderRadius: 8,\n    borderWidth: 1,\n    borderColor: '#334155',\n    alignItems: 'center',\n  },\n  presetBtnText: {\n    color: '#F8FAFC',\n    fontSize: 13,\n    fontWeight: '600',\n  },\n  modalInput: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 10,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    textAlignVertical: 'top',\n    fontSize: 14,\n  },\n  modalButtons: {\n    flexDirection: 'row',\n    justifyContent: 'flex-end',\n    marginTop: 16,\n    gap: 12,\n  },\n  modalCancelButton: {\n    paddingVertical: 10,\n    paddingHorizontal: 16,\n  },\n  modalCancelText: {\n    color: '#94A3B8',\n    fontSize: 15,\n    fontWeight: '600',\n  },\n  modalSaveButton: {\n    backgroundColor: '#10B981',\n    paddingVertical: 10,\n    paddingHorizontal: 20,\n    borderRadius: 10,\n  },\n  modalSaveText: {\n    color: '#FFFFFF',\n    fontSize: 15,\n    fontWeight: '700',\n  },\n});\n","Description":"Upgraded DialerHudScreen with Gemini AI subtly persuasive SMS drafting, context synthesis, and full live editing","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\DialerHudScreen.tsx","toolAction":"Updating DialerHudScreen with AI SMS drafting","toolSummary":"Update DialerHudScreen.tsx with AI SMS compose"}}]}
