{"step_index":389,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-20T16:14:49Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  SafeAreaView,\n  StatusBar,\n  ScrollView,\n  TouchableOpacity,\n  TextInput,\n  Alert,\n  Modal,\n  Image,\n  ActivityIndicator,\n} from 'react-native';\nimport {\n  ArrowLeft,\n  PhoneCall,\n  MessageSquare,\n  Clock,\n  Building,\n  FileText,\n  User,\n  ShieldAlert,\n  Trash2,\n  Save,\n  CheckCircle2,\n  Calendar,\n  GraduationCap,\n  School,\n  Check,\n  HelpCircle,\n  Eye,\n  FileCheck,\n  X,\n  Sparkles,\n} from 'lucide-react-native';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { CallLogsRepository } from '../db/callLogsRepository';\nimport { TelephonyService } from '../services/telephonyService';\nimport { HapticsService } from '../services/hapticsService';\nimport { AiSmsService } from '../services/aiSmsService';\nimport { Lead, CallLog, CallDisposition } from '../types';\n\nexport default function LeadDetailScreen({ route, navigation }: any) {\n  const { leadId } = route.params;\n\n  const [lead, setLead] = useState<Lead | null>(null);\n  const [logs, setLogs] = useState<CallLog[]>([]);\n  const [isEditing, setIsEditing] = useState<boolean>(false);\n  const [imageModalVisible, setImageModalVisible] = useState<boolean>(false);\n\n  // SMS Modal State\n  const [smsModalVisible, setSmsModalVisible] = useState<boolean>(false);\n  const [smsBody, setSmsBody] = useState<string>('');\n  const [isGeneratingAi, setIsGeneratingAi] = useState<boolean>(false);\n\n  // Edit form state\n  const [name, setName] = useState<string>('');\n  const [phone, setPhone] = useState<string>('');\n  const [school, setSchool] = useState<string>('');\n  const [planningPeriod, setPlanningPeriod] = useState<string>('');\n  const [yearsInFrs, setYearsInFrs] = useState<string>('');\n  const [notes, setNotes] = useState<string>('');\n\n  useEffect(() => {\n    loadLeadData();\n  }, [leadId]);\n\n  const loadLeadData = async () => {\n    const l = await LeadsRepository.getLeadById(leadId);\n    if (l) {\n      setLead(l);\n      setName(l.name);\n      setPhone(l.phone);\n      setSchool(l.school || '');\n      setPlanningPeriod(l.planning_period || '');\n      setYearsInFrs(l.years_in_frs || '');\n      setNotes(l.notes || '');\n    }\n\n    const history = await CallLogsRepository.getLogsForLead(leadId);\n    setLogs(history);\n  };\n\n  const handleSaveEdit = async () => {\n    if (!lead) return;\n    await HapticsService.success();\n    const db = await import('../db/database').then((m) => m.getDatabase());\n    await db.runAsync(\n      `UPDATE leads \n       SET name = ?, phone = ?, school = ?, planning_period = ?, years_in_frs = ?, notes = ?, updated_at = ? \n       WHERE id = ?`,\n      [name, phone, school, planningPeriod, yearsInFrs, notes, new Date().toISOString(), lead.id]\n    );\n\n    setIsEditing(false);\n    loadLeadData();\n    Alert.alert('Saved', 'Educator details updated.');\n  };\n\n  const handleMarkDNC = async () => {\n    if (!lead) return;\n    await HapticsService.heavy();\n    await LeadsRepository.updateLeadDisposition(lead.id, 'do_not_call', 'Flagged as DNC');\n    loadLeadData();\n    Alert.alert('Updated', 'Educator marked as Do Not Call.');\n  };\n\n  const openSmsModal = async () => {\n    if (!lead) return;\n    await HapticsService.tick();\n    setSmsModalVisible(true);\n    handleGenerateAiSms();\n  };\n\n  const handleGenerateAiSms = async (toneFocus?: any) => {\n    if (!lead) return;\n    setIsGeneratingAi(true);\n    try {\n      const generated = await AiSmsService.generatePersuasiveSMS(\n        lead,\n        lead.last_disposition || 'follow_up',\n        undefined,\n        toneFocus\n      );\n      setSmsBody(generated);\n      await HapticsService.success();\n    } catch {\n      setSmsBody(\n        `Hi ${lead.name.split(' ')[0]}, this is with ValuTeachers following up on your FRS Report Card from ${lead.school || 'your school'}. When is a good time to connect?`\n      );\n    } finally {\n      setIsGeneratingAi(false);\n    }\n  };\n\n  const handleSendSms = async () => {\n    if (!lead) return;\n    await HapticsService.medium();\n    setSmsModalVisible(false);\n    await TelephonyService.sendSMS(lead.phone, smsBody);\n    await CallLogsRepository.logCall({\n      leadId: lead.id,\n      listId: lead.list_id,\n      durationSeconds: 0,\n      disposition: 'callback_requested',\n      note: 'Sent persuasive ValuTeachers SMS',\n      smsSent: true,\n      smsBody: smsBody,\n    });\n    loadLeadData();\n  };\n\n  const handleDeleteLead = async () => {\n    Alert.alert('Delete Contact', 'Are you sure you want to permanently delete this lead?', [\n      { text: 'Cancel', style: 'cancel' },\n      {\n        text: 'Delete',\n        style: 'destructive',\n        onPress: async () => {\n          await HapticsService.heavy();\n          const db = await import('../db/database').then((m) => m.getDatabase());\n          await db.runAsync('DELETE FROM leads WHERE id = ?', [leadId]);\n          navigation.goBack();\n        },\n      },\n    ]);\n  };\n\n  if (!lead) {\n    return (\n      <SafeAreaView style={styles.container}>\n        <View style={styles.centerContainer}>\n          <Text style={{ color: '#94A3B8' }}>Loading contact details...</Text>\n        </View>\n      </SafeAreaView>\n    );\n  }\n\n  const getDispositionColor = (disp?: CallDisposition | null) => {\n    switch (disp) {\n      case 'connected':\n        return '#10B981';\n      case 'no_answer':\n      case 'voicemail':\n        return '#F59E0B';\n      case 'bad_number':\n      case 'do_not_call':\n        return '#EF4444';\n      default:\n        return '#94A3B8';\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>Educator Profile</Text>\n        <TouchableOpacity onPress={() => setIsEditing(!isEditing)}>\n          <Text style={styles.editLink}>{isEditing ? 'Cancel' : 'Edit'}</Text>\n        </TouchableOpacity>\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {/* Main Card */}\n        <View style={styles.profileCard}>\n          {!isEditing ? (\n            <>\n              <View style={styles.profileTop}>\n                <View style={{ flex: 1 }}>\n                  <Text style={styles.nameText}>{lead.name}</Text>\n                  <Text style={styles.phoneText}>{lead.phone}</Text>\n                  {lead.email ? <Text style={styles.emailText}>{lead.email}</Text> : null}\n                </View>\n                <View\n                  style={[\n                    styles.statusBadge,\n                    { backgroundColor: `${getDispositionColor(lead.last_disposition)}20` },\n                  ]}\n                >\n                  <Text\n                    style={[\n                      styles.statusBadgeText,\n                      { color: getDispositionColor(lead.last_disposition) },\n                    ]}\n                  >\n                    {(lead.last_disposition || 'Pending').toUpperCase()}\n                  </Text>\n                </View>\n              </View>\n\n              {/* School & FRS Info */}\n              <View style={styles.frsInfoBox}>\n                <View style={styles.infoRow}>\n                  <School size={16} color=\"#38BDF8\" />\n                  <Text style={styles.infoText}>\n                    {lead.school || 'VOL'}\n                    {lead.room_number ? ` • Room ${lead.room_number}` : ''}\n                    {lead.planning_period ? ` • ${lead.planning_period}` : ''}\n                  </Text>\n                </View>\n\n                <View style={[styles.infoRow, { marginTop: 6 }]}>\n                  <GraduationCap size={16} color=\"#38BDF8\" />\n                  <Text style={styles.infoText}>\n                    {lead.years_in_frs ? `${lead.years_in_frs} Years in FRS` : 'FRS Member'}\n                    {lead.age ? ` • Age ${lead.age}` : ''}\n                    {lead.frs_knowledge ? ` • FRS Knowledge: \"${lead.frs_knowledge}\"` : ''}\n                  </Text>\n                </View>\n              </View>\n\n              {/* FRS Needs / Checkboxes */}\n              {lead.frs_interests && lead.frs_interests.length > 0 && (\n                <View style={styles.interestsBox}>\n                  <Text style={styles.interestsHeader}>REPORT CARD NEEDS & INQUIRIES:</Text>\n                  {lead.frs_interests.map((interest, i) => (\n                    <View key={i} style={styles.interestRow}>\n                      <Check size={14} color=\"#10B981\" />\n                      <Text style={styles.interestText}>{interest}</Text>\n                    </View>\n                  ))}\n                </View>\n              )}\n\n              {/* Custom Written Questions */}\n              {lead.custom_questions ? (\n                <View style={styles.customQuestionBox}>\n                  <HelpCircle size={14} color=\"#F59E0B\" />\n                  <Text style={styles.customQuestionText}>\n                    Question: \"{lead.custom_questions}\"\n                  </Text>\n                </View>\n              ) : null}\n\n              {/* Meeting Time Preferences */}\n              {lead.meeting_preferences && lead.meeting_preferences.length > 0 && (\n                <View style={styles.meetingPrefsBox}>\n                  <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6, marginBottom: 4 }}>\n                    <Calendar size={14} color=\"#8B5CF6\" />\n                    <Text style={styles.meetingPrefsTitle}>PREFERRED MEETING AVAILABILITY:</Text>\n                  </View>\n                  {lead.meeting_preferences.map((pref, i) => (\n                    <Text key={i} style={styles.prefText}>• {pref}</Text>\n                  ))}\n                </View>\n              )}\n\n              {/* Proof of Contact / View Scanned Sheet Button */}\n              <TouchableOpacity\n                style={styles.proofButton}\n                onPress={() => {\n                  HapticsService.tick();\n                  setImageModalVisible(true);\n                }}\n                activeOpacity={0.7}\n              >\n                <FileCheck size={16} color=\"#38BDF8\" />\n                <Text style={styles.proofButtonText}>View Original Report Card (Proof of Request)</Text>\n                <Eye size={16} color=\"#38BDF8\" />\n              </TouchableOpacity>\n\n              {lead.notes ? (\n                <View style={[styles.infoRow, { marginTop: 10 }]}>\n                  <FileText size={16} color=\"#94A3B8\" />\n                  <Text style={styles.infoText}>{lead.notes}</Text>\n                </View>\n              ) : null}\n\n              {/* Quick Actions */}\n              <View style={styles.actionButtonsRow}>\n                <TouchableOpacity\n                  style={styles.callButton}\n                  onPress={() => {\n                    HapticsService.medium();\n                    TelephonyService.makeCall(lead.phone);\n                  }}\n                >\n                  <PhoneCall size={18} color=\"#FFFFFF\" />\n                  <Text style={styles.actionButtonText}>Call Now</Text>\n                </TouchableOpacity>\n\n                <TouchableOpacity\n                  style={styles.smsButton}\n                  onPress={openSmsModal}\n                >\n                  <MessageSquare size={18} color=\"#FFFFFF\" />\n                  <Text style={styles.actionButtonText}>Draft Text</Text>\n                </TouchableOpacity>\n\n                <TouchableOpacity style={styles.dncButton} onPress={handleMarkDNC}>\n                  <ShieldAlert size={18} color=\"#EF4444\" />\n                </TouchableOpacity>\n              </View>\n            </>\n          ) : (\n            /* Edit Form */\n            <View style={styles.editForm}>\n              <Text style={styles.fieldLabel}>Educator Name</Text>\n              <TextInput style={styles.input} value={name} onChangeText={setName} />\n\n              <Text style={[styles.fieldLabel, { marginTop: 10 }]}>Phone Number</Text>\n              <TextInput\n                style={styles.input}\n                value={phone}\n                onChangeText={setPhone}\n                keyboardType=\"phone-pad\"\n              />\n\n              <Text style={[styles.fieldLabel, { marginTop: 10 }]}>School / District</Text>\n              <TextInput style={styles.input} value={school} onChangeText={setSchool} />\n\n              <Text style={[styles.fieldLabel, { marginTop: 10 }]}>Planning Period / Room</Text>\n              <TextInput style={styles.input} value={planningPeriod} onChangeText={setPlanningPeriod} />\n\n              <Text style={[styles.fieldLabel, { marginTop: 10 }]}>Years in FRS</Text>\n              <TextInput style={styles.input} value={yearsInFrs} onChangeText={setYearsInFrs} />\n\n              <Text style={[styles.fieldLabel, { marginTop: 10 }]}>Notes</Text>\n              <TextInput\n                style={[styles.input, styles.textArea]}\n                value={notes}\n                onChangeText={setNotes}\n                multiline\n                numberOfLines={3}\n              />\n\n              <TouchableOpacity style={styles.saveEditButton} onPress={handleSaveEdit}>\n                <Save size={18} color=\"#FFFFFF\" />\n                <Text style={styles.saveEditText}>Save Changes</Text>\n              </TouchableOpacity>\n            </View>\n          )}\n        </View>\n\n        {/* Call Attempt History Timeline */}\n        <Text style={styles.sectionHeader}>CALL ATTEMPT HISTORY ({logs.length})</Text>\n\n        {logs.length === 0 ? (\n          <View style={styles.emptyLogsCard}>\n            <Clock size={24} color=\"#64748B\" />\n            <Text style={styles.emptyLogsText}>No call attempts logged for this contact yet.</Text>\n          </View>\n        ) : (\n          logs.map((log) => (\n            <View key={log.id} style={styles.logCard}>\n              <View style={styles.logHeader}>\n                <View style={styles.logHeaderLeft}>\n                  <CheckCircle2 size={16} color={getDispositionColor(log.disposition)} />\n                  <Text style={styles.logDisposition}>\n                    {log.disposition.replace('_', ' ').toUpperCase()}\n                  </Text>\n                </View>\n                <Text style={styles.logTimestamp}>\n                  {new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} •{' '}\n                  {new Date(log.timestamp).toLocaleDateString()}\n                </Text>\n              </View>\n\n              {log.duration_seconds > 0 && (\n                <Text style={styles.logDuration}>\n                  Talk Time: {Math.floor(log.duration_seconds / 60)}m {log.duration_seconds % 60}s\n                </Text>\n              )}\n\n              {log.note && <Text style={styles.logNote}>\"{log.note}\"</Text>}\n\n              {log.sms_sent && (\n                <View style={styles.smsSentBox}>\n                  <MessageSquare size={12} color=\"#3B82F6\" />\n                  <Text style={styles.smsSentText}>SMS Delivered: \"{log.sms_body}\"</Text>\n                </View>\n              )}\n            </View>\n          ))\n        )}\n\n        {/* Delete Contact Button */}\n        <TouchableOpacity style={styles.deleteButton} onPress={handleDeleteLead}>\n          <Trash2 size={16} color=\"#EF4444\" />\n          <Text style={styles.deleteButtonText}>Delete Contact</Text>\n        </TouchableOpacity>\n      </ScrollView>\n\n      {/* AI Draft SMS Modal */}\n      <Modal visible={smsModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.imageModalOverlay}>\n          <View style={styles.modalContent}>\n            <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>\n              <Text style={styles.modalTitle}>Draft Text Message</Text>\n              <TouchableOpacity\n                style={styles.aiGenerateBtn}\n                onPress={() => handleGenerateAiSms()}\n                disabled={isGeneratingAi}\n              >\n                {isGeneratingAi ? (\n                  <ActivityIndicator size=\"small\" color=\"#38BDF8\" />\n                ) : (\n                  <>\n                    <Sparkles size={14} color=\"#38BDF8\" />\n                    <Text style={styles.aiGenerateBtnText}>AI Re-Draft</Text>\n                  </>\n                )}\n              </TouchableOpacity>\n            </View>\n\n            <Text style={{ color: '#94A3B8', fontSize: 12, marginBottom: 8 }}>\n              Preview & edit before sending. Gemini crafts personalized copy based on call notes and FRS needs:\n            </Text>\n\n            {/* Quick Focus Chips */}\n            <View style={styles.focusChipRow}>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('meeting_confirmation')}\n              >\n                <Text style={styles.focusChipText}>🎯 Meeting Slot</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('drop_bonus_focus')}\n              >\n                <Text style={styles.focusChipText}>💰 5% Bonus</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={styles.focusChip}\n                onPress={() => handleGenerateAiSms('planning_period')}\n              >\n                <Text style={styles.focusChipText}>🏫 Planning</Text>\n              </TouchableOpacity>\n            </View>\n\n            <TextInput\n              style={[styles.modalInput, { height: 120, marginTop: 8 }]}\n              value={smsBody}\n              onChangeText={setSmsBody}\n              multiline\n              placeholder=\"Drafting persuasive SMS...\"\n              placeholderTextColor=\"#64748B\"\n            />\n\n            <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 4 }}>\n              <Text style={{ color: '#64748B', fontSize: 11 }}>\n                {smsBody.length} characters • Editable\n              </Text>\n            </View>\n\n            <View style={styles.modalButtons}>\n              <TouchableOpacity\n                style={styles.modalCancelButton}\n                onPress={() => setSmsModalVisible(false)}\n              >\n                <Text style={styles.modalCancelText}>Cancel</Text>\n              </TouchableOpacity>\n              <TouchableOpacity\n                style={[styles.modalSaveButton, { backgroundColor: '#2563EB' }]}\n                onPress={handleSendSms}\n              >\n                <Text style={styles.modalSaveText}>Open in SMS App</Text>\n              </TouchableOpacity>\n            </View>\n          </View>\n        </View>\n      </Modal>\n\n      {/* Proof of Request / Original Image Modal */}\n      <Modal visible={imageModalVisible} animationType=\"slide\" transparent>\n        <View style={styles.imageModalOverlay}>\n          <View style={styles.imageModalContent}>\n            <View style={styles.imageModalHeader}>\n              <View style={{ flex: 1 }}>\n                <Text style={styles.imageModalTitle}>Proof of Contact Request</Text>\n                <Text style={styles.imageModalSubtitle}>\n                  {lead.name} • {lead.school || 'ValuTeachers'}\n                </Text>\n              </View>\n              <TouchableOpacity\n                style={styles.imageModalCloseBtn}\n                onPress={() => setImageModalVisible(false)}\n              >\n                <X size={22} color=\"#F8FAFC\" />\n              </TouchableOpacity>\n            </View>\n\n            <View style={styles.imageFrame}>\n              <Image\n                source={\n                  lead.source_image_uri\n                    ? { uri: lead.source_image_uri }\n                    : require('../assets/sample_report_card.png')\n                }\n                style={styles.proofImage}\n                resizeMode=\"contain\"\n              />\n            </View>\n\n            <View style={styles.complianceFooter}>\n              <FileCheck size={16} color=\"#10B981\" />\n              <Text style={styles.complianceText}>\n                Verified Written Consent & Report Card Submission on Record\n              </Text>\n            </View>\n          </View>\n        </View>\n      </Modal>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 14,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  headerTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  editLink: {\n    color: '#3B82F6',\n    fontWeight: '600',\n    fontSize: 15,\n  },\n  content: {\n    flex: 1,\n    padding: 16,\n  },\n  profileCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 16,\n    padding: 18,\n    borderWidth: 1,\n    borderColor: '#334155',\n    marginBottom: 24,\n  },\n  profileTop: {\n    flexDirection: 'row',\n    alignItems: 'flex-start',\n    justifyContent: 'space-between',\n    marginBottom: 12,\n  },\n  nameText: {\n    fontSize: 22,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  phoneText: {\n    fontSize: 16,\n    color: '#38BDF8',\n    marginTop: 2,\n    fontWeight: '600',\n  },\n  emailText: {\n    fontSize: 13,\n    color: '#94A3B8',\n    marginTop: 2,\n  },\n  statusBadge: {\n    paddingHorizontal: 10,\n    paddingVertical: 4,\n    borderRadius: 8,\n  },\n  statusBadgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n  },\n  frsInfoBox: {\n    backgroundColor: '#0F172A',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 6,\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 4,\n  },\n  infoRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 8,\n  },\n  infoText: {\n    color: '#CBD5E1',\n    fontSize: 13,\n    fontWeight: '500',\n  },\n  interestsBox: {\n    backgroundColor: 'rgba(16, 185, 129, 0.08)',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 10,\n    borderWidth: 1,\n    borderColor: 'rgba(16, 185, 129, 0.3)',\n    gap: 4,\n  },\n  interestsHeader: {\n    color: '#10B981',\n    fontSize: 10,\n    fontWeight: '800',\n    letterSpacing: 0.5,\n    marginBottom: 2,\n  },\n  interestRow: {\n    flexDirection: 'row',\n    alignItems: 'flex-start',\n    gap: 6,\n  },\n  interestText: {\n    color: '#F8FAFC',\n    fontSize: 12,\n    fontWeight: '500',\n    flex: 1,\n  },\n  customQuestionBox: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(245, 158, 11, 0.1)',\n    borderRadius: 8,\n    padding: 8,\n    marginTop: 8,\n    borderWidth: 1,\n    borderColor: '#F59E0B',\n    gap: 6,\n  },\n  customQuestionText: {\n    color: '#F59E0B',\n    fontSize: 12,\n    fontWeight: '600',\n    flex: 1,\n  },\n  meetingPrefsBox: {\n    backgroundColor: 'rgba(139, 92, 246, 0.12)',\n    borderRadius: 10,\n    padding: 10,\n    marginTop: 8,\n    borderWidth: 1,\n    borderColor: '#8B5CF6',\n  },\n  meetingPrefsTitle: {\n    color: '#A78BFA',\n    fontSize: 10,\n    fontWeight: '800',\n    letterSpacing: 0.5,\n    marginBottom: 2,\n  },\n  prefText: {\n    color: '#F8FAFC',\n    fontSize: 12,\n    fontWeight: '600',\n    marginTop: 2,\n  },\n  proofButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    backgroundColor: 'rgba(56, 189, 248, 0.1)',\n    paddingVertical: 10,\n    paddingHorizontal: 12,\n    borderRadius: 8,\n    marginTop: 10,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n  },\n  proofButtonText: {\n    color: '#38BDF8',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  actionButtonsRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginTop: 16,\n    paddingTop: 14,\n    borderTopWidth: 1,\n    borderTopColor: '#334155',\n    gap: 10,\n  },\n  callButton: {\n    flex: 1,\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#10B981',\n    paddingVertical: 12,\n    borderRadius: 10,\n    gap: 6,\n  },\n  smsButton: {\n    flex: 1,\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#2563EB',\n    paddingVertical: 12,\n    borderRadius: 10,\n    gap: 6,\n  },\n  dncButton: {\n    padding: 12,\n    backgroundColor: '#0F172A',\n    borderRadius: 10,\n    borderWidth: 1,\n    borderColor: '#EF4444',\n  },\n  actionButtonText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 14,\n  },\n  editForm: {\n    gap: 6,\n  },\n  fieldLabel: {\n    color: '#94A3B8',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  input: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 8,\n    padding: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n    fontSize: 14,\n  },\n  textArea: {\n    height: 70,\n    textAlignVertical: 'top',\n  },\n  saveEditButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#10B981',\n    paddingVertical: 12,\n    borderRadius: 10,\n    marginTop: 12,\n    gap: 6,\n  },\n  saveEditText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 14,\n  },\n  sectionHeader: {\n    color: '#64748B',\n    fontSize: 12,\n    fontWeight: '700',\n    letterSpacing: 1,\n    marginBottom: 10,\n  },\n  emptyLogsCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    padding: 24,\n    alignItems: 'center',\n    borderWidth: 1,\n    borderColor: '#334155',\n    gap: 8,\n  },\n  emptyLogsText: {\n    color: '#94A3B8',\n    fontSize: 13,\n  },\n  logCard: {\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    padding: 14,\n    marginBottom: 10,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  logHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginBottom: 6,\n  },\n  logHeaderLeft: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 6,\n  },\n  logDisposition: {\n    color: '#F8FAFC',\n    fontWeight: '700',\n    fontSize: 13,\n  },\n  logTimestamp: {\n    color: '#64748B',\n    fontSize: 11,\n  },\n  logDuration: {\n    color: '#38BDF8',\n    fontSize: 12,\n    fontWeight: '600',\n    marginBottom: 4,\n  },\n  logNote: {\n    color: '#CBD5E1',\n    fontSize: 13,\n    fontStyle: 'italic',\n    marginTop: 2,\n  },\n  smsSentBox: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#0F172A',\n    padding: 8,\n    borderRadius: 6,\n    marginTop: 8,\n    gap: 6,\n  },\n  smsSentText: {\n    color: '#94A3B8',\n    fontSize: 12,\n    flex: 1,\n  },\n  deleteButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    paddingVertical: 14,\n    marginTop: 20,\n    gap: 6,\n  },\n  deleteButtonText: {\n    color: '#EF4444',\n    fontSize: 14,\n    fontWeight: '600',\n  },\n  centerContainer: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n  },\n  imageModalOverlay: {\n    flex: 1,\n    backgroundColor: 'rgba(0,0,0,0.85)',\n    justifyContent: 'center',\n    padding: 16,\n  },\n  imageModalContent: {\n    backgroundColor: '#0F172A',\n    borderRadius: 20,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n    maxHeight: '90%',\n  },\n  imageModalHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginBottom: 12,\n  },\n  imageModalTitle: {\n    fontSize: 17,\n    fontWeight: '800',\n    color: '#F8FAFC',\n  },\n  imageModalSubtitle: {\n    fontSize: 12,\n    color: '#38BDF8',\n    marginTop: 2,\n    fontWeight: '600',\n  },\n  imageModalCloseBtn: {\n    padding: 6,\n    backgroundColor: '#1E293B',\n    borderRadius: 10,\n  },\n  imageFrame: {\n    backgroundColor: '#1E293B',\n    borderRadius: 12,\n    overflow: 'hidden',\n    height: 400,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  proofImage: {\n    width: '100%',\n    height: '100%',\n  },\n  complianceFooter: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(16, 185, 129, 0.15)',\n    padding: 10,\n    borderRadius: 10,\n    marginTop: 12,\n    gap: 8,\n  },\n  complianceText: {\n    color: '#10B981',\n    fontSize: 12,\n    fontWeight: '700',\n    flex: 1,\n  },\n  modalContent: {\n    backgroundColor: '#1E293B',\n    borderRadius: 20,\n    padding: 20,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  modalTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  aiGenerateBtn: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(56, 189, 248, 0.15)',\n    paddingHorizontal: 10,\n    paddingVertical: 6,\n    borderRadius: 8,\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n    gap: 4,\n  },\n  aiGenerateBtnText: {\n    color: '#38BDF8',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  focusChipRow: {\n    flexDirection: 'row',\n    gap: 6,\n    marginBottom: 6,\n  },\n  focusChip: {\n    backgroundColor: '#0F172A',\n    paddingHorizontal: 8,\n    paddingVertical: 4,\n    borderRadius: 6,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  focusChipText: {\n    color: '#CBD5E1',\n    fontSize: 11,\n    fontWeight: '600',\n  },\n  modalInput: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 10,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    textAlignVertical: 'top',\n    fontSize: 14,\n  },\n  modalButtons: {\n    flexDirection: 'row',\n    justifyContent: 'flex-end',\n    marginTop: 16,\n    gap: 12,\n  },\n  modalCancelButton: {\n    paddingVertical: 10,\n    paddingHorizontal: 16,\n  },\n  modalCancelText: {\n    color: '#94A3B8',\n    fontSize: 15,\n    fontWeight: '600',\n  },\n  modalSaveButton: {\n    backgroundColor: '#10B981',\n    paddingVertical: 10,\n    paddingHorizontal: 20,\n    borderRadius: 10,\n  },\n  modalSaveText: {\n    color: '#FFFFFF',\n    fontSize: 15,\n    fontWeight: '700',\n  },\n});\n","Description":"Upgraded LeadDetailScreen with Gemini AI text drafting, tone options, and editable preview modal","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\LeadDetailScreen.tsx","toolAction":"Updating LeadDetailScreen with AI SMS drafting","toolSummary":"Update LeadDetailScreen.tsx with AI SMS compose"}}]}
