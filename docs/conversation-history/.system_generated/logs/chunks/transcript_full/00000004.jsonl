st(listId);\n80:       // Filter out any DNC numbers\n81:       const dncFiltered = leads.filter(\n82:         (l) => !s.dnc_phone_numbers.includes(TelephonyService.sanitizePhoneNumber(l.phone))\n83:       );\n84:       setQueue(dncFiltered);\n85:       setCurrentIndex(0);\n86:     } catch (e) {\n87:       console.error(e);\n88:       Alert.alert('Error', 'Failed to load dialing queue.');\n89:     } finally {\n90:       setLoading(false);\n91:     }\n92:   };\n93: \n94:   useEffect(() => {\n95:     loadQueue();\n96:     return () => {\n97:       if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n98:       if (callTimerRef.current) clearInterval(callTimerRef.current);\n99:     };\n100:   }, [listId]);\n101: \n102:   const currentLead: Lead | undefined = queue[currentIndex];\n103: \n104:   // Trigger outbound call via zero-cost native SIM bridge\n105:   const handleDial = async () => {\n106:     if (!currentLead) return;\n107:     setSessionDials((prev) => prev + 1);\n108:     setIsOnCall(true);\n109:     setCallDuration(0);\n110: \n111:     if (callTimerRef.current) clearInterval(callTimerRef.current);\n112:     callTimerRef.current = setInterval(() => {\n113:       setCallDuration((prev) => prev + 1);\n114:     }, 1000);\n115: \n116:     await TelephonyService.makeCall(currentLead.phone);\n117:   };\n118: \n119:   // Disposition Handlers\n120:   const handleDisposition = async (disposition: CallDisposition, note?: string) => {\n121:     if (!currentLead) return;\n122: \n123:     if (callTimerRef.current) clearInterval(callTimerRef.current);\n124:     setIsOnCall(false);\n125: \n126:     if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n127:     setAutoAdvanceCountdown(null);\n128: \n129:     if (disposition === 'connected') {\n130:       setSessionConnects((prev) => prev + 1);\n131:     }\n132: \n133:     // Evaluate cadence rule for SMS trigger\n134:     const cadenceResult = await CadenceEngine.evaluateCadence(currentLead, disposition);\n135: \n136:     // Save disposition to SQLite\n137:     await LeadsRepository.updateLeadDisposition(currentLead.id, disposition, note);\n138:     await CallLogsRepository.logCall({\n139:       leadId: currentLead.id,\n140:       listId: currentLead.list_id,\n141:       durationSeconds: callDuration,\n142:       disposition,\n143:       note,\n144:       smsSent: false,\n145:     });\n146: \n147:     // Check if we should prompt SMS\n148:     if (cadenceResult.shouldPromptSMS && cadenceResult.template) {\n149:       promptCadenceSMS(currentLead, cadenceResult.template);\n150:     } else {\n151:       startAutoAdvanceTimer();\n152:     }\n153:   };\n154: \n155:   const handleMarkDNC = async () => {\n156:     if (!currentLead) return;\n157:     Alert.alert(\n158:       'Mark as Do Not Call (DNC)?',\n159:       `Suppress ${currentLead.phone} across all queues permanently?`,\n160:       [\n161:         { text: 'Cancel', style: 'cancel' },\n162:         {\n163:           text: 'Mark DNC',\n164:           style: 'destructive',\n165:           onPress: async () => {\n166:             await SettingsRepository.addDNCNumber(currentLead.phone);\n167:             await handleDisposition('do_not_call', 'Added to DNC list');\n168:           },\n169:         },\n170:       ]\n171:     );\n172:   };\n173: \n174:   const promptCadenceSMS = (lead: Lead, template: SMSTemplate) => {\n175:     const interpolated = TelephonyService.interpolateTemplate(\n176:       template,\n177:       lead,\n178:       appSettings?.user_name || 'Alex'\n179:     );\n180:     Alert.alert(\n181:       'Cadence Trigger: Send Follow-up SMS?',\n182:       `\"${interpolated}\"`,\n183:       [\n184:         {\n185:           text: 'Skip SMS',\n186:           style: 'cancel',\n187:           onPress: () => startAutoAdvanceTimer(),\n188:         },\n189:         {\n190:           text: 'Send Pre-filled SMS',\n191:           onPress: async () => {\n192:             await TelephonyService.sendSMS(lead.phone, interpolated);\n193:             startAutoAdvanceTimer();\n194:           },\n195:         },\n196:       ]\n197:     );\n198:   };\n199: \n200:   const openSmsModal = () => {\n201:     if (!currentLead) return;\n202:     if (templates.length > 0) {\n203:       const first = templates[0];\n204:       setSelectedTemplate(first);\n205:       setCustomSmsBody(\n206:         TelephonyService.interpolateTemplate(first, currentLead, appSettings?.user_name || 'Alex')\n207:       );\n208:     } else {\n209:       setCustomSmsBody(`Hi ${currentLead.name}, just tried reaching you. Let me know when is a good time to connect!`);\n210:     }\n211:     setSmsModalVisible(true);\n212:   };\n213: \n214:   const handleSendCustomSms = async () => {\n215:     if (!currentLead) return;\n216:     setSmsModalVisible(false);\n217:     await TelephonyService.sendSMS(currentLead.phone, customSmsBody);\n218:     await CallLogsRepository.logCall({\n219:       leadId: currentLead.id,\n220:       listId: currentLead.list_id,\n221:       durationSeconds: 0,\n222:       disposition: 'callback_requested',\n223:       note: 'Sent manual SMS',\n224:       smsSent: true,\n225:       smsBody: customSmsBody,\n226:     });\n227:   };\n228: \n229:   const startAutoAdvanceTimer = () => {\n230:     if (isAutoPaused || !appSettings?.auto_advance_enabled) {\n231:       advanceNextLead();\n232:       return;\n233:     }\n234: \n235:     const duration = appSettings?.auto_advance_seconds || 3;\n236:     setAutoAdvanceCountdown(duration);\n237:     let secondsLeft = duration;\n238: \n239:     if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n240:     countdownTimerRef.current = setInterval(() => {\n241:       secondsLeft -= 1;\n242:       if (secondsLeft <= 0) {\n243:         if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n244:         setAutoAdvanceCountdown(null);\n245:         advanceNextLead();\n246:       } else {\n247:         setAutoAdvanceCountdown(secondsLeft);\n248:       }\n249:     }, 1000);\n250:   };\n251: \n252:   const advanceNextLead = () => {\n253:     if (currentIndex + 1 < queue.length) {\n254:       setCurrentIndex((prev) => prev + 1);\n255:     } else {\n256:       loadQueue();\n257:     }\n258:   };\n259: \n260:   const togglePause = () => {\n261:     if (countdownTimerRef.current) {\n262:       clearInterval(countdownTimerRef.current);\n263:       setAutoAdvanceCountdown(null);\n264:     }\n265:     setIsAutoPaused(!isAutoPaused);\n266:   };\n267: \n268:   if (loading) {\n269:     return (\n270:       <SafeAreaView style={styles.container}>\n271:         <View style={styles.centerContainer}>\n272:           <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n273:           <Text style={styles.loadingText}>Preparing Power Dialer...</Text>\n274:         </View>\n275:       </SafeAreaView>\n276:     );\n277:   }\n278: \n279:   // Finished queue\n280:   if (!currentLead || queue.length === 0) {\n281:     return (\n282:       <SafeAreaView style={styles.container}>\n283:         <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n284:         <View style={styles.finishedContainer}>\n285:           <Flame size={64} color=\"#F59E0B\" />\n286:           <Text style={styles.finishedTitle}>Session Complete!</Text>\n287:           <Text style={styles.finishedSubtitle}>\n288:             You have cycled through all active leads in \"{listTitle}\".\n289:           </Text>\n290: \n291:           <View style={styles.sessionSummaryBox}>\n292:             <View style={styles.summaryItem}>\n293:               <Text style={styles.summaryVal}>{sessionDials}</Text>\n294:               <Text style={styles.summaryLabel}>Total Dials</Text>\n295:             </View>\n296:             <View style={styles.summaryDivider} />\n297:             <View style={styles.summaryItem}>\n298:               <Text style={[styles.summaryVal, { color: '#10B981' }]}>{sessionConnects}</Text>\n299:               <Text style={styles.summaryLabel}>Connects</Text>\n300:             </View>\n301:           </View>\n302: \n303:           <TouchableOpacity\n304:             style={styles.returnButton}\n305:             onPress={() => navigation.navigate('Lists')}\n306:           >\n307:             <Text style={styles.returnButtonText}>Back to Lead Lists</Text>\n308:           </TouchableOpacity>\n309:         </View>\n310:       </SafeAreaView>\n311:     );\n312:   }\n313: \n314:   return (\n315:     <SafeAreaView style={styles.container}>\n316:       <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n317: \n318:       {/* Top Header */}\n319:       <View style={styles.header}>\n320:         <TouchableOpacity\n321:           onPress={() => navigation.navigate('Lists')}\n322:           style={styles.backButton}\n323:         >\n324:           <ArrowLeft size={22} color=\"#F8FAFC\" />\n325:         </TouchableOpacity>\n326:         <View style={{ alignItems: 'center' }}>\n327:           <Text style={styles.queueCounter}>\n328:             Lead {currentIndex + 1} of {queue.length}\n329:           </Text>\n330:           <Text style={styles.listSubheading}>{listTitle}</Text>\n331:         </View>\n332:         <TouchableOpacity onPress={togglePause} style={styles.pauseButton}>\n333:           {isAutoPaused ? (\n334:             <Play size={20} color=\"#10B981\" />\n335:           ) : (\n336:             <Pause size={20} color=\"#94A3B8\" />\n337:           )}\n338:         </TouchableOpacity>\n339:       </View>\n340: \n341:       {/* Auto Advance Countdown Banner */}\n342:       {autoAdvanceCountdown !== null && (\n343:         <View style={styles.countdownBanner}>\n344:           <Text style={styles.countdownText}>\n345:             Advancing to next contact in {autoAdvanceCountdown}s...\n346:           </Text>\n347:           <TouchableOpacity\n348:             onPress={() => {\n349:               if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n350:               setAutoAdvanceCountdown(null);\n351:             }}\n352:           >\n353:             <Text style={styles.countdownCancel}>Pause</Text>\n354:           </TouchableOpacity>\n355:         </View>\n356:       )}\n357: \n358:       {/* Main Lead Contact Card */}\n359:       <View style={styles.contactCard}>\n360:         <View style={styles.contactTopRow}>\n361:           <View style={styles.avatarCircle}>\n362:             <User size={30} color=\"#3B82F6\" />\n363:           </View>\n364:           <View style={{ flex: 1, marginLeft: 14 }}>\n365:             <Text style={styles.contactName}>{currentLead.name}</Text>\n366:             <Text style={styles.contactPhone}>{currentLead.phone}</Text>\n367:           </View>\n368:           <View style={styles.attemptBadge}>\n369:             <Text style={styles.attemptText}>\n370:               Attempt #{currentLead.attempts_count + 1}\n371:             </Text>\n372:           </View>\n373:         </View>\n374: \n375:         {/* Lead Metadata */}\n376:         <View style={styles.leadDetailsContainer}>\n377:           {currentLead.company ? (\n378:             <View style={styles.detailRow}>\n379:               <Building size={16} color=\"#94A3B8\" />\n380:               <Text style={styles.detailText}>{currentLead.company}</Text>\n381:             </View>\n382:           ) : null}\n383:           {currentLead.notes ? (\n384:             <View style={styles.detailRow}>\n385:               <FileText size={16} color=\"#94A3B8\" />\n386:               <Text style={styles.detailText}>{currentLead.notes}</Text>\n387:             </View>\n388:           ) : null}\n389:         </View>\n390: \n391:         {/* Live Call Duration Meter */}\n392:         {isOnCall && (\n393:           <View style={styles.callDurationBox}>\n394:             <Clock size={16} color=\"#10B981\" />\n395:             <Text style={styles.callDurationText}>\n396:               Call in progress: {Math.floor(callDuration / 60)}:\n397:               {(callDuration % 60).toString().padStart(2, '0')}\n398:             </Text>\n399:           </View>\n400:         )}\n401: \n402:         {/* Big Dial Trigger Button */}\n403:         <TouchableOpacity\n404:           style={[styles.mainDialButton, isOnCall && { backgroundColor: '#059669' }]}\n405:           onPress={handleDial}\n406:           activeOpacity={0.8}\n407:         >\n408:           <PhoneCall size={26} color=\"#FFFFFF\" />\n409:           <Text style={styles.mainDialButtonText}>\n410:             {isOnCall ? 'Redial ' + currentLead.phone : 'Dial ' + currentLead.phone}\n411:           </Text>\n412:         </TouchableOpacity>\n413:       </View>\n414: \n415:       {/* Giant 1-Tap Disposition Controls */}\n416:       <View style={styles.dispositionContainer}>\n417:         <Text style={styles.dispositionHeading}>LOG CALL OUTCOME (1-TAP)</Text>\n418: \n419:         <View style={styles.buttonGrid}>\n420:           {/* No Answer / VM Drop */}\n421:           <TouchableOpacity\n422:             style={[styles.dispositionButton, { backgroundColor: '#F59E0B' }]}\n423:             onPress={() => handleDisposition('no_answer')}\n424:             activeOpacity={0.7}\n425:           >\n426:             <PhoneOff size={24} color=\"#FFFFFF\" />\n427:             <Text style={styles.dispositionButtonText}>No Answer / VM</Text>\n428:             <Text style={styles.dispositionSubtext}>Advance & check SMS</Text>\n429:           </TouchableOpacity>\n430: \n431:           {/* Connected / Qualified */}\n432:           <TouchableOpacity\n433:             style={[styles.dispositionButton, { backgroundColor: '#10B981' }]}\n434:             onPress={() => {\n435:               setCallNote('');\n436:               setNoteModalVisible(true);\n437:             }}\n438:             activeOpacity={0.7}\n439:           >\n440:             <CheckCircle2 size={24} color=\"#FFFFFF\" />\n441:             <Text style={styles.dispositionButtonText}>Connected</Tex