>\n182: \n183:         {/* Do Not Call (DNC) Management */}\n184:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DO NOT CALL (DNC) SUPPRESSION</Text>\n185:         <View style={styles.card}>\n186:           <View style={styles.cardHeaderRow}>\n187:             <ShieldAlert size={18} color=\"#EF4444\" />\n188:             <Text style={styles.cardTitle}>Suppressed Numbers ({dncList.length})</Text>\n189:           </View>\n190:           <Text style={styles.cardDesc}>\n191:             These numbers are blocked permanently across all power dialing sessions.\n192:           </Text>\n193: \n194:           <View style={[styles.inputRow, { marginTop: 10 }]}>\n195:             <TextInput\n196:               style={[styles.input, { flex: 1 }]}\n197:               placeholder=\"Add phone to DNC (e.g. 5551234567)\"\n198:               placeholderTextColor=\"#64748B\"\n199:               value={newDncPhone}\n200:               onChangeText={setNewDncPhone}\n201:               keyboardType=\"phone-pad\"\n202:             />\n203:             <TouchableOpacity style={styles.addDncButton} onPress={handleAddDnc}>\n204:               <Text style={styles.addDncButtonText}>Add DNC</Text>\n205:             </TouchableOpacity>\n206:           </View>\n207: \n208:           {dncList.map((num) => (\n209:             <View key={num} style={styles.dncItemRow}>\n210:               <Text style={styles.dncText}>{num}</Text>\n211:               <TouchableOpacity onPress={() => handleRemoveDnc(num)}>\n212:                 <Trash2 size={16} color=\"#EF4444\" />\n213:               </TouchableOpacity>\n214:             </View>\n215:           ))}\n216:         </View>\n217: \n218:         {/* Developer / Demo Reset */}\n219:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DEVELOPER UTILITIES</Text>\n220:         <TouchableOpacity style={styles.demoResetButton} onPress={handleResetDemoData}>\n221:           <Sparkles size={18} color=\"#38BDF8\" />\n222:           <Text style={styles.demoResetText}>Seed New Demo Trade Show Leads</Text>\n223:         </TouchableOpacity>\n224:       </ScrollView>\n225:     </SafeAreaView>\n226:   );\n227: }\n228: \n229: const styles = StyleSheet.create({\n230:   container: {\n231:     flex: 1,\n232:     backgroundColor: '#0F172A',\n233:   },\n234:   header: {\n235:     flexDirection: 'row',\n236:     alignItems: 'center',\n237:     justifyContent: 'space-between',\n238:     paddingHorizontal: 16,\n239:     paddingVertical: 14,\n240:     borderBottomWidth: 1,\n241:     borderBottomColor: '#1E293B',\n242:   },\n243:   backButton: {\n244:     padding: 8,\n245:   },\n246:   headerTitle: {\n247:     fontSize: 18,\n248:     fontWeight: '700',\n249:     color: '#F8FAFC',\n250:   },\n251:   saveLink: {\n252:     color: '#10B981',\n253:     fontWeight: '700',\n254:     fontSize: 15,\n255:   },\n256:   content: {\n257:     flex: 1,\n258:     padding: 16,\n259:   },\n260:   sectionHeader: {\n261:     color: '#64748B',\n262:     fontSize: 12,\n263:     fontWeight: '700',\n264:     letterSpacing: 1,\n265:     marginBottom: 8,\n266:   },\n267:   card: {\n268:     backgroundColor: '#1E293B',\n269:     borderRadius: 14,\n270:     padding: 16,\n271:     borderWidth: 1,\n272:     borderColor: '#334155',\n273:   },\n274:   cardHeaderRow: {\n275:     flexDirection: 'row',\n276:     alignItems: 'center',\n277:     gap: 8,\n278:     marginBottom: 6,\n279:   },\n280:   cardTitle: {\n281:     fontSize: 16,\n282:     fontWeight: '700',\n283:     color: '#F8FAFC',\n284:   },\n285:   cardDesc: {\n286:     fontSize: 13,\n287:     color: '#94A3B8',\n288:     lineHeight: 18,\n289:     marginBottom: 10,\n290:   },\n291:   tokenTag: {\n292:     color: '#38BDF8',\n293:     fontWeight: '600',\n294:   },\n295:   input: {\n296:     backgroundColor: '#0F172A',\n297:     color: '#F8FAFC',\n298:     borderRadius: 8,\n299:     padding: 12,\n300:     borderWidth: 1,\n301:     borderColor: '#334155',\n302:     fontSize: 14,\n303:   },\n304:   switchRow: {\n305:     flexDirection: 'row',\n306:     justifyContent: 'space-between',\n307:     alignItems: 'center',\n308:   },\n309:   inputRow: {\n310:     flexDirection: 'row',\n311:     alignItems: 'center',\n312:     gap: 10,\n313:   },\n314:   inlineLabel: {\n315:     color: '#CBD5E1',\n316:     fontSize: 14,\n317:     flex: 1,\n318:   },\n319:   addDncButton: {\n320:     backgroundColor: '#EF4444',\n321:     paddingHorizontal: 14,\n322:     paddingVertical: 12,\n323:     borderRadius: 8,\n324:     justifyContent: 'center',\n325:   },\n326:   addDncButtonText: {\n327:     color: '#FFFFFF',\n328:     fontWeight: '700',\n329:     fontSize: 13,\n330:   },\n331:   dncItemRow: {\n332:     flexDirection: 'row',\n333:     justifyContent: 'space-between',\n334:     alignItems: 'center',\n335:     backgroundColor: '#0F172A',\n336:     padding: 10,\n337:     borderRadius: 8,\n338:     marginTop: 8,\n339:   },\n340:   dncText: {\n341:     color: '#F8FAFC',\n342:     fontSize: 14,\n343:     fontWeight: '500',\n344:   },\n345:   demoResetButton: {\n346:     flexDirection: 'row',\n347:     alignItems: 'center',\n348:     justifyContent: 'center',\n349:     backgroundColor: '#1E293B',\n350:     borderWidth: 1,\n351:     borderColor: '#38BDF8',\n352:     paddingVertical: 14,\n353:     borderRadius: 12,\n354:     gap: 8,\n355:   },\n356:   demoResetText: {\n357:     color: '#38BDF8',\n358:     fontSize: 15,\n359:     fontWeight: '700',\n360:   },\n361: });\n362: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":176,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-18T18:21:35Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useEffect } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  SafeAreaView,\n  StatusBar,\n  ScrollView,\n  TouchableOpacity,\n  TextInput,\n  Switch,\n  Alert,\n} from 'react-native';\nimport {\n  ArrowLeft,\n  Key,\n  User,\n  Timer,\n  Sparkles,\n} from 'lucide-react-native';\nimport { SettingsRepository } from '../db/settingsRepository';\nimport { LeadsRepository } from '../db/leadsRepository';\nimport { VisionService } from '../services/visionService';\nimport { AppSettings } from '../types';\n\nexport default function SettingsScreen({ navigation }: any) {\n  const [apiKey, setApiKey] = useState<string>('');\n  const [userName, setUserName] = useState<string>('Alex');\n  const [autoAdvanceEnabled, setAutoAdvanceEnabled] = useState<boolean>(true);\n  const [autoAdvanceSeconds, setAutoAdvanceSeconds] = useState<string>('3');\n\n  useEffect(() => {\n    loadSettings();\n  }, []);\n\n  const loadSettings = async () => {\n    const s = await SettingsRepository.getSettings();\n    setApiKey(s.gemini_api_key || '');\n    setUserName(s.user_name || 'Alex');\n    setAutoAdvanceEnabled(s.auto_advance_enabled);\n    setAutoAdvanceSeconds(String(s.auto_advance_seconds || 3));\n  };\n\n  const handleSaveAll = async () => {\n    await SettingsRepository.saveSetting('gemini_api_key', apiKey.trim());\n    await SettingsRepository.saveSetting('user_name', userName.trim());\n    await SettingsRepository.saveSetting('auto_advance_enabled', autoAdvanceEnabled ? '1' : '0');\n    await SettingsRepository.saveSetting(\n      'auto_advance_seconds',\n      parseInt(autoAdvanceSeconds, 10) || 3\n    );\n    Alert.alert('Settings Saved', 'Your preferences and API key have been stored locally.');\n  };\n\n  const handleResetDemoData = async () => {\n    Alert.alert(\n      'Load Fresh Demo Leads',\n      'This will add a fresh 5-lead trade show demo list to your database for testing.',\n      [\n        { text: 'Cancel', style: 'cancel' },\n        {\n          text: 'Load Demo Leads',\n          onPress: async () => {\n            const sampleLeads = VisionService.getDemoExtractedLeads();\n            await LeadsRepository.createListWithLeads(\n              'Demo Trade Show Roster',\n              null,\n              sampleLeads\n            );\n            Alert.alert('Success', 'Demo list added to your home screen.');\n          },\n        },\n      ]\n    );\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>Global Settings</Text>\n        <TouchableOpacity onPress={handleSaveAll}>\n          <Text style={styles.saveLink}>Save</Text>\n        </TouchableOpacity>\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {/* Gemini Vision API Key */}\n        <Text style={styles.sectionHeader}>VISION AI PARSER CONFIGURATION</Text>\n        <View style={styles.card}>\n          <View style={styles.cardHeaderRow}>\n            <Key size={18} color=\"#3B82F6\" />\n            <Text style={styles.cardTitle}>Google Gemini API Key</Text>\n          </View>\n          <Text style={styles.cardDesc}>\n            Used to extract contacts from photos of paper lead sheets with 99%+ accuracy (free tier from Google AI Studio).\n          </Text>\n          <TextInput\n            style={styles.input}\n            placeholder=\"AIzaSy...\"\n            placeholderTextColor=\"#64748B\"\n            value={apiKey}\n            onChangeText={setApiKey}\n            secureTextEntry\n          />\n        </View>\n\n        {/* User Profile for SMS Tokens */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>CALLER PROFILE (SMS TEMPLATES)</Text>\n        <View style={styles.card}>\n          <View style={styles.cardHeaderRow}>\n            <User size={18} color=\"#10B981\" />\n            <Text style={styles.cardTitle}>Your Name / Signature</Text>\n          </View>\n          <Text style={styles.cardDesc}>\n            Automatically replaces <Text style={styles.tokenTag}>{'{{my_name}}'}</Text> in follow-up SMS templates.\n          </Text>\n          <TextInput\n            style={styles.input}\n            placeholder=\"e.g. Alex\"\n            placeholderTextColor=\"#64748B\"\n            value={userName}\n            onChangeText={setUserName}\n          />\n        </View>\n\n        {/* Power Dialer Pacing Controls */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>POWER DIALER PACING CONTROLS</Text>\n        <View style={styles.card}>\n          <View style={styles.switchRow}>\n            <View style={{ flex: 1 }}>\n              <Text style={styles.cardTitle}>Auto-Advance Countdown</Text>\n              <Text style={styles.cardDesc}>\n                Automatically queue next lead after call outcome is logged\n              </Text>\n            </View>\n            <Switch\n              value={autoAdvanceEnabled}\n              onValueChange={setAutoAdvanceEnabled}\n              trackColor={{ false: '#334155', true: '#2563EB' }}\n            />\n          </View>\n\n          {autoAdvanceEnabled && (\n            <View style={[styles.inputRow, { marginTop: 12 }]}>\n              <Timer size={18} color=\"#94A3B8\" />\n              <Text style={styles.inlineLabel}>Countdown Buffer (seconds):</Text>\n              <TextInput\n                style={[styles.input, { width: 60, textAlign: 'center' }]}\n                value={autoAdvanceSeconds}\n                onChangeText={setAutoAdvanceSeconds}\n                keyboardType=\"numeric\"\n              />\n            </View>\n          )}\n        </View>\n\n        {/* Developer / Demo Reset */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DEVELOPER UTILITIES</Text>\n        <TouchableOpacity style={styles.demoResetButton} onPress={handleResetDemoData}>\n          <Sparkles size={18} color=\"#38BDF8\" />\n          <Text style={styles.demoResetText}>Seed New Demo Trade Show Leads</Text>\n        </TouchableOpacity>\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 14,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  headerTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  saveLink: {\n    color: '#10B981',\n    fontWeight: '700',\n    fontSize: 15,\n  },\n  content: {\n    flex: 1,\n    padding: 16,\n  },\n  sectionHeader: {\n    color: '#64748B',\n    fontSize: 12,\n    fontWeight: '700',\n    letterSpacing: 1,\n    marginBottom: 8,\n  },\n  card: {\n    backgroundColor: '#1E293B',\n    borderRadius: 14,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  cardHeaderRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 8,\n    marginBottom: 6,\n  },\n  cardTitle: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  cardDesc: {\n    fontSize: 13,\n    color: '#94A3B8',\n    lineHeight: 18,\n    marginBottom: 10,\n  },\n  tokenTag: {\n    color: '#38BDF8',\n    fontWeight: '600',\n  },\n  input: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 8,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    fontSize: 14,\n  },\n  switchRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'cente