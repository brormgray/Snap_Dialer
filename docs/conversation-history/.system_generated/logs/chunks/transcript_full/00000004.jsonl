ey || '');\n45:     setUserName(s.user_name || 'Alex');\n46:     setAutoAdvanceEnabled(s.auto_advance_enabled);\n47:     setAutoAdvanceSeconds(String(s.auto_advance_seconds || 3));\n48:     setDncList(s.dnc_phone_numbers || []);\n49:   };\n50: \n51:   const handleSaveAll = async () => {\n52:     await SettingsRepository.saveSetting('gemini_api_key', apiKey.trim());\n53:     await SettingsRepository.saveSetting('user_name', userName.trim());\n54:     await SettingsRepository.saveSetting('auto_advance_enabled', autoAdvanceEnabled ? '1' : '0');\n55:     await SettingsRepository.saveSetting(\n56:       'auto_advance_seconds',\n57:       parseInt(autoAdvanceSeconds, 10) || 3\n58:     );\n59:     Alert.alert('Settings Saved', 'Your preferences and API key have been stored locally.');\n60:   };\n61: \n62:   const handleAddDnc = async () => {\n63:     if (!newDncPhone.trim()) return;\n64:     await SettingsRepository.addDNCNumber(newDncPhone.trim());\n65:     setNewDncPhone('');\n66:     loadSettings();\n67:   };\n68: \n69:   const handleRemoveDnc = async (phone: string) => {\n70:     const updated = dncList.filter((p) => p !== phone);\n71:     await SettingsRepository.saveSetting('dnc_phone_numbers', updated);\n72:     setDncList(updated);\n73:   };\n74: \n75:   const handleResetDemoData = async () => {\n76:     Alert.alert(\n77:       'Load Fresh Demo Leads',\n78:       'This will add a fresh 5-lead trade show demo list to your database for testing.',\n79:       [\n80:         { text: 'Cancel', style: 'cancel' },\n81:         {\n82:           text: 'Load Demo Leads',\n83:           onPress: async () => {\n84:             const sampleLeads = VisionService.getDemoExtractedLeads();\n85:             await LeadsRepository.createListWithLeads(\n86:               'Demo Trade Show Roster',\n87:               null,\n88:               sampleLeads\n89:             );\n90:             Alert.alert('Success', 'Demo list added to your home screen.');\n91:           },\n92:         },\n93:       ]\n94:     );\n95:   };\n96: \n97:   return (\n98:     <SafeAreaView style={styles.container}>\n99:       <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n100: \n101:       {/* Header */}\n102:       <View style={styles.header}>\n103:         <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n104:           <ArrowLeft size={22} color=\"#F8FAFC\" />\n105:         </TouchableOpacity>\n106:         <Text style={styles.headerTitle}>Global Settings</Text>\n107:         <TouchableOpacity onPress={handleSaveAll}>\n108:           <Text style={styles.saveLink}>Save</Text>\n109:         </TouchableOpacity>\n110:       </View>\n111: \n112:       <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n113:         {/* Gemini Vision API Key */}\n114:         <Text style={styles.sectionHeader}>VISION AI PARSER CONFIGURATION</Text>\n115:         <View style={styles.card}>\n116:           <View style={styles.cardHeaderRow}>\n117:             <Key size={18} color=\"#3B82F6\" />\n118:             <Text style={styles.cardTitle}>Google Gemini API Key</Text>\n119:           </View>\n120:           <Text style={styles.cardDesc}>\n121:             Used to extract contacts from photos of paper lead sheets with 99%+ accuracy (free tier from Google AI Studio).\n122:           </Text>\n123:           <TextInput\n124:             style={styles.input}\n125:             placeholder=\"AIzaSy...\"\n126:             placeholderTextColor=\"#64748B\"\n127:             value={apiKey}\n128:             onChangeText={setApiKey}\n129:             secureTextEntry\n130:           />\n131:         </View>\n132: \n133:         {/* User Profile for SMS Tokens */}\n134:         <Text style={[styles.sectionHeader, { marginTop: 24 }]}>CALLER PROFILE (SMS TEMPLATES)</Text>\n135:         <View style={styles.card}>\n136:           <View style={styles.cardHeaderRow}>\n137:             <User size={18} color=\"#10B981\" />\n138:   