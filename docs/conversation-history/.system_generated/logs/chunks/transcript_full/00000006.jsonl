t { BackupService } from '../services/backupService';\nimport { HapticsService } from '../services/hapticsService';\nimport { AppSettings } from '../types';\n\nexport default function SettingsScreen({ navigation }: any) {\n  const [apiKey, setApiKey] = useState<string>('');\n  const [userName, setUserName] = useState<string>('Alex');\n  const [autoAdvanceEnabled, setAutoAdvanceEnabled] = useState<boolean>(true);\n  const [autoAdvanceSeconds, setAutoAdvanceSeconds] = useState<string>('3');\n\n  useEffect(() => {\n    loadSettings();\n  }, []);\n\n  const loadSettings = async () => {\n    const s = await SettingsRepository.getSettings();\n    setApiKey(s.gemini_api_key || '');\n    setUserName(s.user_name || 'Alex');\n    setAutoAdvanceEnabled(s.auto_advance_enabled);\n    setAutoAdvanceSeconds(String(s.auto_advance_seconds || 3));\n  };\n\n  const handleSaveAll = async () => {\n    await HapticsService.success();\n    await SettingsRepository.saveSetting('gemini_api_key', apiKey.trim());\n    await SettingsRepository.saveSetting('user_name', userName.trim());\n    await SettingsRepository.saveSetting('auto_advance_enabled', autoAdvanceEnabled ? '1' : '0');\n    await SettingsRepository.saveSetting(\n      'auto_advance_seconds',\n      parseInt(autoAdvanceSeconds, 10) || 3\n    );\n    Alert.alert('Settings Saved', 'Your preferences and API key have been stored locally.');\n  };\n\n  const handleExportBackup = async () => {\n    await HapticsService.medium();\n    const success = await BackupService.exportFullBackup();\n    if (success) {\n      await HapticsService.success();\n    }\n  };\n\n  const handleResetDemoData = async () => {\n    Alert.alert(\n      'Load Fresh Demo Leads',\n      'This will add a fresh 5-lead trade show demo list to your database for testing.',\n      [\n        { text: 'Cancel', style: 'cancel' },\n        {\n          text: 'Load Demo Leads',\n          onPress: async () => {\n            await HapticsService.success();\n            const sampleLeads = VisionService.getDemoExtractedLeads();\n            await LeadsRepository.createListWithLeads(\n              'Demo Trade Show Roster',\n              null,\n              sampleLeads\n            );\n            Alert.alert('Success', 'Demo list added to your home screen.');\n          },\n        },\n      ]\n    );\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n          <ArrowLeft size={22} color=\"#F8FAFC\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>Global Settings</Text>\n        <TouchableOpacity onPress={handleSaveAll}>\n          <Text style={styles.saveLink}>Save</Text>\n        </TouchableOpacity>\n      </View>\n\n      <ScrollView style={styles.content} contentContainerStyle={{ paddingBottom: 40 }}>\n        {/* Gemini Vision API Key */}\n        <Text style={styles.sectionHeader}>VISION AI PARSER CONFIGURATION</Text>\n        <View style={styles.card}>\n          <View style={styles.cardHeaderRow}>\n            <Key size={18} color=\"#3B82F6\" />\n            <Text style={styles.cardTitle}>Google Gemini API Key</Text>\n          </View>\n          <Text style={styles.cardDesc}>\n            Used to extract contacts from photos of paper lead sheets with 99%+ accuracy (free tier from Google AI Studio).\n          </Text>\n          <TextInput\n            style={styles.input}\n            placeholder=\"AIzaSy...\"\n            placeholderTextColor=\"#64748B\"\n            value={apiKey}\n            onChangeText={setApiKey}\n            secureTextEntry\n          />\n        </View>\n\n        {/* User Profile for SMS Tokens */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>CALLER PROFILE (SMS TEMPLATES)</Text>\n        <View style={styles.card}>\n          <View style={styles.cardHeaderRow}>\n            <User size={18} color=\"#10B981\" />\n            <Text style={styles.cardTitle}>Your Name / Signature</Text>\n          </View>\n          <Text style={styles.cardDesc}>\n            Automatically replaces <Text style={styles.tokenTag}>{'{{my_name}}'}</Text> in follow-up SMS templates.\n          </Text>\n          <TextInput\n            style={styles.input}\n            placeholder=\"e.g. Alex\"\n            placeholderTextColor=\"#64748B\"\n            value={userName}\n            onChangeText={setUserName}\n          />\n        </View>\n\n        {/* Power Dialer Pacing Controls */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>POWER DIALER PACING CONTROLS</Text>\n        <View style={styles.card}>\n          <View style={styles.switchRow}>\n            <View style={{ flex: 1 }}>\n              <Text style={styles.cardTitle}>Auto-Advance Countdown</Text>\n              <Text style={styles.cardDesc}>\n                Automatically queue next lead after call outcome is logged\n              </Text>\n            </View>\n            <Switch\n              value={autoAdvanceEnabled}\n              onValueChange={(val) => {\n                HapticsService.tick();\n                setAutoAdvanceEnabled(val);\n              }}\n              trackColor={{ false: '#334155', true: '#2563EB' }}\n            />\n          </View>\n\n          {autoAdvanceEnabled && (\n            <View style={[styles.inputRow, { marginTop: 12 }]}>\n              <Timer size={18} color=\"#94A3B8\" />\n              <Text style={styles.inlineLabel}>Countdown Buffer (seconds):</Text>\n              <TextInput\n                style={[styles.input, { width: 60, textAlign: 'center' }]}\n                value={autoAdvanceSeconds}\n                onChangeText={setAutoAdvanceSeconds}\n                keyboardType=\"numeric\"\n              />\n            </View>\n          )}\n        </View>\n\n        {/* Cloud & Drive Backup */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DATA BACKUP & CLOUD STORAGE</Text>\n        <View style={styles.card}>\n          <View style={styles.cardHeaderRow}>\n            <Cloud size={18} color=\"#38BDF8\" />\n            <Text style={styles.cardTitle}>Database Snapshot Backup</Text>\n          </View>\n          <Text style={styles.cardDesc}>\n            Export your entire lead database, call history, and templates to iCloud Drive, Google Drive, or your Files app.\n          </Text>\n          <TouchableOpacity style={styles.backupButton} onPress={handleExportBackup}>\n            <Share2 size={18} color=\"#FFFFFF\" />\n            <Text style={styles.backupButtonText}>Export Backup Snapshot</Text>\n          </TouchableOpacity>\n        </View>\n\n        {/* Developer / Demo Reset */}\n        <Text style={[styles.sectionHeader, { marginTop: 24 }]}>DEVELOPER UTILITIES</Text>\n        <TouchableOpacity style={styles.demoResetButton} onPress={handleResetDemoData}>\n          <Sparkles size={18} color=\"#38BDF8\" />\n          <Text style={styles.demoResetText}>Seed New Demo Trade Show Leads</Text>\n        </TouchableOpacity>\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#0F172A',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 14,\n    borderBottomWidth: 1,\n    borderBottomColor: '#1E293B',\n  },\n  backButton: {\n    padding: 8,\n  },\n  headerTitle: {\n    fontSize: 18,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  saveLink: {\n    color: '#10B981',\n    fontWeight: '700',\n    fontSize: 15,\n  },\n  content: {\n    flex: 1,\n    padding: 16,\n  },\n  sectionHeader: {\n    color: '#64748B',\n    fontSize: 12,\n    fontWeight: '700',\n    letterSpacing: 1,\n    marginBottom: 8,\n  },\n  card: {\n    backgroundColor: '#1E293B',\n    borderRadius: 14,\n    padding: 16,\n    borderWidth: 1,\n    borderColor: '#334155',\n  },\n  cardHeaderRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 8,\n    marginBottom: 6,\n  },\n  cardTitle: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#F8FAFC',\n  },\n  cardDesc: {\n    fontSize: 13,\n    color: '#94A3B8',\n    lineHeight: 18,\n    marginBottom: 10,\n  },\n  tokenTag: {\n    color: '#38BDF8',\n    fontWeight: '600',\n  },\n  input: {\n    backgroundColor: '#0F172A',\n    color: '#F8FAFC',\n    borderRadius: 8,\n    padding: 12,\n    borderWidth: 1,\n    borderColor: '#334155',\n    fontSize: 14,\n  },\n  switchRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n  },\n  inputRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 10,\n  },\n  inlineLabel: {\n    color: '#CBD5E1',\n    fontSize: 14,\n    flex: 1,\n  },\n  backupButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#2563EB',\n    paddingVertical: 14,\n    borderRadius: 10,\n    marginTop: 6,\n    gap: 8,\n  },\n  backupButtonText: {\n    color: '#FFFFFF',\n    fontWeight: '700',\n    fontSize: 15,\n  },\n  demoResetButton: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: '#1E293B',\n    borderWidth: 1,\n    borderColor: '#38BDF8',\n    paddingVertical: 14,\n    borderRadius: 12,\n    gap: 8,\n  },\n  demoResetText: {\n    color: '#38BDF8',\n    fontSize: 15,\n    fontWeight: '700',\n  },\n});\n","Description":"Upgraded SettingsScreen with 1-tap iCloud/Google Drive backup snapshot export and Haptic integration","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\src\\screens\\SettingsScreen.tsx","toolAction":"Updating SettingsScreen.tsx","toolSummary":"Update SettingsScreen.tsx with Cloud Backup"}}]}
