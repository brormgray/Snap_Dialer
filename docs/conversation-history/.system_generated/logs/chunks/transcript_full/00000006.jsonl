{"step_index":227,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T15:22:57Z","content":"Created At: 2026-08-20T11:22:57-04:00\nCompleted At: 2026-08-20T11:22:57-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/db/leadsRepository.ts`\nTotal Lines: 138\nTotal Bytes: 4564\nShowing lines 1 to 138\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { getDatabase } from './database';\n2: import { Lead, LeadList, CallDisposition, ExtractedLeadItem } from '../types';\n3: \n4: export class LeadsRepository {\n5:   static async createListWithLeads(\n6:     title: string,\n7:     imageUri: string | null,\n8:     leads: ExtractedLeadItem[]\n9:   ): Promise<LeadList> {\n10:     const db = await getDatabase();\n11:     const listId = 'list_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);\n12:     const now = new Date().toISOString();\n13: \n14:     const validLeads = leads.filter((l) => l.name.trim() && l.phone.trim());\n15: \n16:     await db.withTransactionAsync(async () => {\n17:       await db.runAsync(\n18:         `INSERT INTO lists (id, title, source_image_uri, total_leads, completed_leads, connected_leads, created_at, updated_at)\n19:          VALUES (?, ?, ?, ?, 0, 0, ?, ?)`,\n20:         [listId, title, imageUri, validLeads.length, now, now]\n21:       );\n22: \n23:       for (const item of validLeads) {\n24:         const leadId = 'lead_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);\n25:         await db.runAsync(\n26:           `INSERT INTO leads (id, list_id, name, phone, company, notes, cadence_step, last_disposition, attempts_count, created_at, updated_at)\n27:            VALUES (?, ?, ?, ?, ?, ?, 1, 'pending', 0, ?, ?)`,\n28:           [\n29:             leadId,\n30:             listId,\n31:             item.name.trim(),\n32:             item.phone.trim(),\n33:             item.company || null,\n34:             item.notes || null,\n35:             now,\n36:             now,\n37:           ]\n38:         );\n39:       }\n40:     });\n41: \n42:     return {\n43:       id: listId,\n44:       title,\n45:       source_image_uri: imageUri,\n46:       total_leads: validLeads.length,\n47:       completed_leads: 0,\n48:       connected_leads: 0,\n49:       created_at: now,\n50:       updated_at: now,\n51:     };\n52:   }\n53: \n54:   static async getAllLists(): Promise<LeadList[]> {\n55:     const db = await getDatabase();\n56:     return await db.getAllAsync<LeadList>('SELECT * FROM lists ORDER BY created_at DESC');\n57:   }\n58: \n59:   static async getListById(id: string): Promise<LeadList | null> {\n60:     const db = await getDatabase();\n61:     return await db.getFirstAsync<LeadList>('SELECT * FROM lists WHERE id = ?', [id]);\n62:   }\n63: \n64:   static async deleteList(id: string): Promise<void> {\n65:     const db = await getDatabase();\n66:     await db.runAsync('DELETE FROM lists WHERE id = ?', [id]);\n67:   }\n68: \n69:   static async getLeadsForList(listId: string): Promise<Lead[]> {\n70:     const db = await getDatabase();\n71:     return await db.getAllAsync<Lead>(\n72:       'SELECT * FROM leads WHERE list_id = ? ORDER BY created_at ASC',\n73:       [listId]\n74:     );\n75:   }\n76: \n77:   static async getDialingQueueForList(listId: string): Promise<Lead[]> {\n78:     const db = await getDatabase();\n79:     // Exclude bad numbers and connected/do_not_call leads from the active power dial queue\n80:     return await db.getAllAsync<Lead>(\n81:       `SELECT * FROM leads \n82:        WHERE list_id = ? \n83:          AND (last_disposition IS NULL OR last_disposition IN ('pending', 'no_answer', 'voicemail'))\n84:        ORDER BY attempts_count ASC, created_at ASC`,\n85:       [listId]\n86:     );\n87:   }\n88: \n89:   static async updateLeadDisposition(\n90:     leadId: string,\n91:     disposition: CallDisposition,\n92:     note?: string\n93:   ): Promise<void> {\n94:     const db = await getDatabase();\n95:     const now = new Date().toISOString();\n96: \n97:     const lead = await db.getFirstAsync<Lead>('SELECT * FROM leads WHERE id = ?', [leadId]);\n98:     if (!lead) return;\n99: \n100:     const newAttempts = lead.attempts_count + 1;\n101:     const newCadenceStep = lead.cadence_step + 1;\n102: \n103:     await db.withTransactionAsync(async () => {\n104:       // Update lead\n105:       await db.runAsync(\n106:         `UPDATE leads \n107:          SET last_disposition = ?, \n108:              attempts_count = ?, \n109:              cadence_step = ?, \n110:              last_attempt_at = ?, \n111:              notes = COALESCE(?, notes),\n112:              updated_at = ?\n113:          WHERE id = ?`,\n114:         [disposition, newAttempts, newCadenceStep, now, note || null, now, leadId]\n115:       );\n116: \n117:       // Recalculate list stats\n118:       const stats = await db.getFirstAsync<{ total: number; completed: number; connected: number }>(\n119:         `SELECT \n120:            COUNT(*) as total,\n121:            SUM(CASE WHEN last_disposition IN ('connected', 'bad_number', 'do_not_call') THEN 1 ELSE 0 END) as completed,\n122:            SUM(CASE WHEN last_disposition = 'connected' THEN 1 ELSE 0 END) as connected\n123:          FROM leads WHERE list_id = ?`,\n124:         [lead.list_id]\n125:       );\n126: \n127:       if (stats) {\n128:         await db.runAsync(\n129:           `UPDATE lists \n130:            SET completed_leads = ?, connected_leads = ?, updated_at = ? \n131:            WHERE id = ?`,\n132:           [stats.completed || 0, stats.connected || 0, now, lead.list_id]\n133:         );\n134:       }\n135:     });\n136:   }\n137: }\n138: \nThe above content shows the entire, complete file contents of the requested file.\n"}
