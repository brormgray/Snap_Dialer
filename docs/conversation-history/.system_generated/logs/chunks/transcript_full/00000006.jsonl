  const [queue, setQueue] = useState<Lead[]>([]);\n47:   const [currentIndex, setCurrentIndex] = useState<number>(0);\n48:   const [loading, setLoading] = useState<boolean>(true);\n49:   const [autoAdvanceCountdown, setAutoAdvanceCountdown] = useState<number | null>(null);\n50:   const [isAutoPaused, setIsAutoPaused] = useState<boolean>(false);\n51:   const [appSettings, setAppSettings] = useState<AppSettings | null>(null);\n52: \n53:   // Call duration counter\n54:   const [isOnCall, setIsOnCall] = useState<boolean>(false);\n55:   const [callDuration, setCallDuration] = useState<number>(0);\n56:   const callTimerRef = useRef<NodeJS.Timeout | null>(null);\n57: \n58:   // Quick Notes modal for Connected calls\n59:   const [noteModalVisible, setNoteModalVisible] = useState<boolean>(false);\n60:   const [callNote, setCallNote] = useState<string>('');\n61: \n62:   // Multi-template SMS Modal\n63:   const [smsModalVisible, setSmsModalVisible] = useState<boolean>(false);\n64:   const [templates, setTemplates] = useState<SMSTemplate[]>([]);\n65:   const [selectedTemplate, setSelectedTemplate] = useState<SMSTemplate | null>(null);\n66:   const [customSmsBody, setCustomSmsBody] = useState<string>('');\n67: \n68:   // Session stats\n69:   const [sessionDials, setSessionDials] = useState<number>(0);\n70:   const [sessionConnects, setSessionConnects] = useState<number>(0);\n71: \n72:   const countdownTimerRef = useRef<NodeJS.Timeout | null>(null);\n73: \n74:   const loadQueue = async () => {\n75:     setLoading(true);\n76:     try {\n77:       const s = await SettingsRepository.getSettings();\n78:       setAppSettings(s);\n79:       const allTemplates = await CadenceRepository.getAllTemplates();\n80:       setTemplates(allTemplates);\n81: \n82:       const leads = await LeadsRepository.getDialingQueueForList(listId);\n83:       setQueue(leads);\n84:       setCurrentIndex(0);\n85:     } catch (e) {\n86:       console.error(e);\n87:       Alert.alert('Error', 'Failed to load dialing queue.');\n88:     } finally {\n89:       setLoading(false);\n90:     }\n91:   };\n92: \n93:   useEffect(() => {\n94:     loadQueue();\n95:     return () => {\n96:       if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);\n97:       if (callTimerRef.current) clearInterval(callTimerRef.current);\n98:     };\n99:   }, [listId]);\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
