 \n278:         leads.push({\n279:           id: `offline_${Date.now()}_${i}`,\n280:           name: name.replace(/[0-9]/g, '').trim() || 'Educator',\n281:           phone: cleanedPhone,\n282:           school,\n283:           email,\n284:           years_in_frs: '5+',\n285:           frs_knowledge: 'I know a little',\n286:           frs_interests: ['Florida State Retirement and/or 403b Plans', 'Guaranteed 5% Bonus'],\n287:           meeting_preferences: ['Mon 1-2 PM', 'Wed 1-2 PM'],\n288:           company: 'ValuTeachers',\n289:           notes,\n290:           isValid: true,\n291:         });\n292:       }\n293:     }\n294: \n295:     return leads.length > 0 ? leads : this.getDemoExtractedLeads();\n296:   }\n297: \n298:   /**\n299:    * Pre-loaded sample leads directly matching authentic ValuTeachers cards\n300:    */\n301:   public static getDemoExtractedLeads(): ExtractedLeadItem[] {\n302:     return [\n303:       {\n304:         id: 'valuteachers_1',\n305:         name: 'Joseph Adona',\n306:         phone: '(386) 212-3234',\n307:         email: 'jradona@volusia.k12.fl.us',\n308:         school: 'VOL (Volusia County)',\n309:         age: '42',\n310:         planning_period: '3rd Period',\n311:         room_number: '204',\n312:         years_in_frs: '9',\n313:         text_ok: true,\n314:         frs_knowledge: 'I know a little',\n315:         frs_interests: [\n316:           \"I'd like to know more about my Florida State Retirement and/or 403b Plans\",\n317:           'I want a plan with GUARANTEED interest and a 5% interest bonus on my contributions and rollovers',\n318:           \"I'm currently saving for retirement, but I don't really understand the plan/available plans\",\n319:         ],\n320:         custom_questions: 'Interested in comparing DROP vs 403(b) rollover option',\n321:         meeting_preferences: [\n322:           '1. Mon 1-2 PM',\n323:           '2. Wed 1-2 PM',\n324:           '3. Fri 1-2 PM',\n325:         ],\n326:         annual_salary: '$54,000',\n327:         present_403b_contribution: '$150/mo',\n328:         company: 'ValuTeachers',\n329:         notes: 'High interest in 5% bonus and guaranteed interest options.',\n330:         isValid: true,\n331:       },\n332:       {\n333:         id: 'valuteachers_2',\n334:         name: 'Maria Gonzalez',\n335:         phone: '(386) 451-8890',\n336:         email: 'mgonzalez@volusia.k12.fl.us',\n337:         school: 'Heritage Middle',\n338:         age: '55',\n339:         planning_period: '1:15 - 2:00 PM',\n340:         room_number: '118',\n341:         years_in_frs: '18',\n342:         text_ok: true,\n343:         frs_knowledge: 'Not very much',\n344:         frs_interests: [\n345:           \"I'd like to know more about D.R.O.P. -or- I'm already in D.R.O.P.\",\n346:           \"I'm not in D.R.O.P. and I'm retiring < 5 years\",\n347:           'Receive a state pension analysis',\n348:         ],\n349:         custom_questions: 'How does entering DROP affect my final pension payout?',\n350:         meeting_preferences: [\n351:           '1. Tue 1:15-2:00 PM',\n352:           '2. Thu 1:15-2:00 PM',\n353:         ],\n354:         annual_salary: '$68,500',\n355:         present_403b_contribution: '$0',\n356:         company: 'ValuTeachers',\n357:         notes: 'Retiring in 3 years. Needs full FRS pension analysis.',\n358:         isValid: true,\n359:       },\n360:       {\n361:         id: 'valuteachers_3',\n362:         name: 'David Sterling',\n363:         phone: '(407) 832-7611',\n364:         email: 'dsterling@orange.k12.fl.us',\n365:         school: 'West Orange High',\n366:         age: '34',\n367:         planning_period: 'Period 4 (11:30 AM)',\n368:         room_number: 'B-12',\n369:         years_in_frs: '6',\n370:         text_ok: true,\n371:         frs_knowledge: 'I know a little',\n372:         frs_interests: [\n373:           'I want to increase my retirement or 403b contributions',\n374:           'How to increase my retirement savings and re