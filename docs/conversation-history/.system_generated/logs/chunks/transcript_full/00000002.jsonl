{"step_index":110,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-18T16:17:36Z","content":"Created At: 2026-08-18T12:17:36-04:00\nCompleted At: 2026-08-18T12:17:36-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/screens/ScanSheetScreen.tsx`\nTotal Lines: 493\nTotal Bytes: 14459\nShowing lines 1 to 493\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React, { useState } from 'react';\n2: import {\n3:   View,\n4:   Text,\n5:   StyleSheet,\n6:   TouchableOpacity,\n7:   SafeAreaView,\n8:   StatusBar,\n9:   ScrollView,\n10:   TextInput,\n11:   Image,\n12:   ActivityIndicator,\n13:   Alert,\n14: } from 'react-native';\n15: import * as ImagePicker from 'expo-image-picker';\n16: import { Camera, Image as ImageIcon, Check, Trash2, Plus, Sparkles, ArrowLeft } from 'lucide-react-native';\n17: import { VisionService } from '../services/visionService';\n18: import { LeadsRepository } from '../db/leadsRepository';\n19: import { ExtractedLeadItem } from '../types';\n20: \n21: export default function ScanSheetScreen({ navigation }: any) {\n22:   const [imageUri, setImageUri] = useState<string | null>(null);\n23:   const [isProcessing, setIsProcessing] = useState<boolean>(false);\n24:   const [listTitle, setListTitle] = useState<string>('Lead Sheet ' + new Date().toLocaleDateString());\n25:   const [extractedLeads, setExtractedLeads] = useState<ExtractedLeadItem[]>([]);\n26:   const [apiKey, setApiKey] = useState<string>('');\n27:   const [hasScanned, setHasScanned] = useState<boolean>(false);\n28: \n29:   const takePhoto = async () => {\n30:     const permission = await ImagePicker.requestCameraPermissionsAsync();\n31:     if (!permission.granted) {\n32:       Alert.alert('Permission required', 'Camera permission is required to snap lead sheets.');\n33:       return;\n34:     }\n35: \n36:     const result = await ImagePicker.launchCameraAsync({\n37:       mediaTypes: ImagePicker.MediaTypeOptions.Images,\n38:       quality: 0.85,\n39:     });\n40: \n41:     if (!result.canceled && result.assets[0]) {\n42:       handleImageCaptured(result.assets[0].uri);\n43:     }\n44:   };\n45: \n46:   const pickImage = async () => {\n47:     const result = await ImagePicker.launchImageLibraryAsync({\n48:       mediaTypes: ImagePicker.MediaTypeOptions.Images,\n49:       quality: 0.85,\n50:     });\n51: \n52:     if (!result.canceled && result.assets[0]) {\n53:       handleImageCaptured(result.assets[0].uri);\n54:     }\n55:   };\n56: \n57:   const handleImageCaptured = async (uri: string) => {\n58:     setImageUri(uri);\n59:     setIsProcessing(true);\n60:     try {\n61:       const leads = await VisionService.extractLeadsFromImage(uri, apiKey);\n62:       setExtractedLeads(leads);\n63:       setHasScanned(true);\n64:     } catch (e) {\n65:       Alert.alert('Extraction Error', 'Could not parse leads from image. You can add them manually.');\n66:       setExtractedLeads(VisionService.getDemoExtractedLeads());\n67:       setHasScanned(true);\n68:     } finally {\n69:       setIsProcessing(false);\n70:     }\n71:   };\n72: \n73:   const handleUpdateLead = (index: number, field: keyof ExtractedLeadItem, value: string) => {\n74:     const updated = [...extractedLeads];\n75:     updated[index] = { ...updated[index], [field]: value };\n76:     setExtractedLeads(updated);\n77:   };\n78: \n79:   const handleDeleteRow = (index: number) => {\n80:     setExtractedLeads(extractedLeads.filter((_, i) => i !== index));\n81:   };\n82: \n83:   const handleAddRow = () => {\n84:     setExtractedLeads([\n85:       ...extractedLeads,\n86:       {\n87:         id: `manual_${Date.now()}`,\n88:         name: '',\n89:         phone: '',\n90:         company: '',\n91:         notes: '',\n92:         isValid: true,\n93:       },\n94:     ]);\n95:   };\n96: \n97:   const handleSaveAndDial = async () => {\n98:     const validLeads = extractedLeads.filter((l) => l.name.trim() && l.phone.trim());\n99:     if (validLeads.length === 0) {\n100:       Alert.alert('No valid leads', 'Please provide at least one contact with a valid name and phone number.');\n101:       return;\n102:     }\n103: \n104:     try {\n105:       const newList = await LeadsRepository.createListWithLeads(\n106:         listTitle.trim() || 'Scanned Lead Sheet',\n107:         imageUri,\n108:         validLeads\n109:       );\n110: \n111:       Alert.alert(\n112:         'List Saved!',\n113:         `Successfully imported ${validLeads.length} leads into local SQLite.`,\n114:         [\n115:           {\n116:             text: 'Start Power Dialing Now',\n117:             onPress: () =>\n118:               navigation.replace('DialerHUD', {\n119:                 listId: newList.id,\n120:                 listTitle: newList.title,\n121:               }),\n122:           },\n123:           {\n124:             text: 'Go to Lists',\n125:             onPress: () => navigation.navigate('Lists'),\n126:             style: 'cancel',\n127:           },\n128:         ]\n129:       );\n130:     } catch (e) {\n131:       console.error(e);\n132:       Alert.alert('Error', 'Failed to save leads to local database.');\n133:     }\n134:   };\n135: \n136:   return (\n137:     <SafeAreaView style={styles.container}>\n138:       <StatusBar barStyle=\"light-content\" backgroundColor=\"#0F172A\" />\n139: \n140:       {/* Header */}\n141:       <View style={styles.header}>\n142:         <TouchableOpacity style={styles.backButton} onPress={() => navigation.goBack()}>\n143:           <ArrowLeft size={22} color=\"#F8FAFC\" />\n144:         </TouchableOpacity>\n145:         <Text style={styles.headerTitle}>\n146:           {!hasScanned ? 'Snap Lead Sheet' : 'Verify & Clean Leads'}\n147:         </Text>\n148:         <View style={{ width: 40 }} />\n149: 