ill be extracted for immediate testing.\n187:               </Text>\n188:             </View>\n189:           </View>\n190:         ) : isProcessing ? (\n191:           <View style={styles.loadingContainer}>\n192:             <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n193:             <Text style={styles.loadingText}>Extracting contacts from sheet...</Text>\n194:           </View>\n195:         ) : (\n196:           <View style={styles.reviewSection}>\n197:             {/* List Title Input */}\n198:             <Text style={styles.fieldLabel}>List Name</Text>\n199:             <TextInput\n200:               style={styles.input}\n201:               value={listTitle}\n202:               onChangeText={setListTitle}\n203:               placeholder=\"e.g. Open House Leads - June 2026\"\n204:               placeholderTextColor=\"#64748B\"\n205:             />\n206: \n207:             {/* Extracted Leads Header */}\n208:             <View style={styles.tableHeader}>\n209:               <Text style={styles.tableTitle}>\n210:                 Detected Contacts ({extractedLeads.length})\n211:               </Text>\n212:               <TouchableOpacity style={styles.addRowButton} onPress={handleAddRow}>\n213:                 <Plus size={16} color=\"#3B82F6\" />\n214:                 <Text style={styles.addRowText}>Add Lead</Text>\n215:               </TouchableOpacity>\n216:             </View>\n217: \n218:             {/* Editable Rows */}\n219:             {extractedLeads.map((item, index) => (\n220:               <View key={item.id || index} style={styles.leadRowCard}>\n221:                 <View style={styles.rowHeader}>\n222:                   <Text style={styles.rowNumber}>#{index + 1}</Text>\n223:                   <TouchableOpacity onPress={() => handleDeleteRow(index)}>\n224:                     <Trash2 size={16} color=\"#EF4444\" />\n225:                   </TouchableOpacity>\n226:                 </View>\n227: \n228:                 <View style={styles.inputRow}>\n229:                   <View style={{ flex: 1, marginRight: 8 }}>\n230:                     <Text style={styles.smallLabel}>Name</Text>\n231:                     <TextInput\n232:                       style={styles.rowInput}\n233:                       value={item.name}\n234:                       onChangeText={(val) => handleUpdateLead(index, 'name', val)}\n235:                       placeholder=\"Contact Name\"\n236:                       placeholderTextColor=\"#64748B\"\n237:                     />\n238:                   </View>\n239:                   <View style={{ flex: 1 }}>\n240:                     <Text style={styles.smallLabel}>Phone</Text>\n241:                     <TextInput\n242:                       style={styles.rowInput}\n243:                       value={item.phone}\n244:                       onChangeText={(val) => handleUpdateLead(index, 'phone', val)}\n245:                       placeholder=\"(555) 000-0000\"\n246:                       placeholderTextColor=\"#64748B\"\n247:                       keyboardType=\"phone-pad\"\n248:                     />\n249:                   </View>\n250:                 </View>\n251: \n252:                 <View style={[styles.inputRow, { marginTop: 8 }]}>\n253:                   <View style={{ flex: 1, marginRight: 8 }}>\n254:                     <Text style={styles.smallLabel}>Company / Org</Text>\n255:                     <TextInput\n256:                       style={styles.rowInput}\n257:                       value={item.company || ''}\n258:                       onChangeText={(val) => handleUpdateLead(index, 'company', val)}\n259:                       placeholder=\"Company\"\n260:                       placeholderTextColor=\"#64748B\"\n261:                     />\n262:                   </View>\n263:                   <View style={{ flex: 1 }}>\n264:                     <Text style={styles.smallLabel}>Notes</Text>\n265:                     <TextInput\n266:                       style={styles.rowInput}\n267:                       value={item.notes || ''}\n268:                       onChangeText={(val) => handleUpdateLead(index, 'notes', val)}\n269:                       placeholder=\"Notes\"\n270:                       placeholderTextColor=\"#64748B\"\n271:                     />\n272:                   </View>\n273:                 </View>\n274:               </View>\n275:             ))}\n276: \n277:             {/* Save & Start Dialing */}\n278:             <TouchableOpacity style={styles.saveButton} onPress={handleSaveAndDial}>\n279:               <Check size={20} color=\"#FFFFFF\" />\n280:               <Text style={styles.saveButtonText}>Save List & Launch Power Dialer</Text>\n281:             </TouchableOpacity>\n282:           </View>\n283:         )}\n284:       </ScrollView>\n285:     </SafeAreaView>\n286:   );\n287: }\n288: \n289: const styles = StyleSheet.create({\n290:   container: {\n291:     flex: 1,\n292:     backgroundColor: '#0F172A',\n293:   },\n294:   header: {\n295:     flexDirection: 'row',\n296:     alignItems: 'center',\n297:     justifyContent: 'space-between',\n298:     paddingHorizontal: 16,\n299:     paddingVertical: 14,\n300:     borderBottomWidth: 1,\n301:     borderBottomColor: '#1E293B',\n302:   },\n303:   backButton: {\n304:     padding: 8,\n305:   },\n306:   headerTitle: {\n307:     fontSize: 18,\n308:     fontWeight: '700',\n309:     color: '#F8FAFC',\n310:   },\n311:   content: {\n312:     flex: 1,\n313:     padding: 16,\n314:   },\n315:   captureSection: {\n316:     alignItems: 'center',\n317:     paddingTop: 16,\n318:   },\n319:   instructionsBox: {\n320:     flexDirection: 'row',\n321:     backgroundColor: '#1E293B',\n322:     padding: 16,\n323:     borderRadius: 12,\n324:     borderWidth: 1,\n325:     borderColor: '#3B82F6',\n326:     gap: 12,\n327:     marginBottom: 32,\n328:     alignItems: 'center',\n329:   },\n330:   instructionText: {\n331:     flex: 1,\n332:     color: '#CBD5E1',\n333:     fontSize: 14,\n334