{"step_index":106,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-18T16:15:21Z","content":"Created At: 2026-08-18T12:15:21-04:00\nCompleted At: 2026-08-18T12:15:21-04:00\nFile Path: `file:///C:/Users/brorm/.gemini/antigravity/scratch/snap-dialer/src/services/visionService.ts`\nTotal Lines: 150\nTotal Bytes: 4406\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import * as FileSystem from 'expo-file-system';\n2: import { ExtractedLeadItem } from '../types';\n3: \n4: export class VisionService {\n5:   /**\n6:    * Sanitizes phone number string to standard (XXX) XXX-XXXX or E.164\n7:    */\n8:   static cleanPhone(raw: string): string {\n9:     const digits = raw.replace(/\\D/g, '');\n10:     if (digits.length === 10) {\n11:       return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;\n12:     } else if (digits.length === 11 && digits.startsWith('1')) {\n13:       return `+1 (${digits.slice(1, 4)}) ${digits.slice(4, 7)}-${digits.slice(7)}`;\n14:     }\n15:     return raw.trim();\n16:   }\n17: \n18:   /**\n19:    * Extracts lead contacts from an image using Gemini 2.5 Flash API or local intelligent parser\n20:    */\n21:   static async extractLeadsFromImage(\n22:     imageUri: string,\n23:     apiKey?: string\n24:   ): Promise<ExtractedLeadItem[]> {\n25:     try {\n26:       if (apiKey && apiKey.trim().length > 0) {\n27:         return await this.extractWithGemini(imageUri, apiKey);\n28:       }\n29:     } catch (e) {\n30:       console.warn('Gemini extraction failed, falling back to local extractor:', e);\n31:     }\n32: \n33:     // High quality mock / demo parser for immediate offline testing without API key setup\n34:     return this.getDemoExtractedLeads();\n35:   }\n36: \n37:   private static async extractWithGemini(\n38:     imageUri: string,\n39:     apiKey: string\n40:   ): Promise<ExtractedLeadItem[]> {\n41:     const base64Image = await FileSystem.readAsStringAsync(imageUri, {\n42:       encoding: 'base64',\n43:     });\n44: \n45:     const prompt = `\n46:       Analyze this image of a lead sheet, roster, sign-in form, or data table.\n47:       Extract all contacts (Name, Phone Number, Company/Organization if visible, and any relevant Notes).\n48:       Return ONLY a valid JSON array matching this exact schema:\n49:       [\n50:         {\n51:           \"name\": \"Full Name\",\n52:           \"phone\": \"Phone Number\",\n53:           \"company\": \"Company Name (optional)\",\n54:           \"notes\": \"Any notes or details (optional)\"\n55:         }\n56:       ]\n57:       Ensure every phone number includes area code. If a row has no phone or name, omit it.\n58:     `;\n59: \n60:     const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;\n61: \n62:     const response = await fetch(endpoint, {\n63:       method: 'POST',\n64:       headers: { 'Content-Type': 'application/json' },\n65:       body: JSON.stringify({\n66:         contents: [\n67:           {\n68:             parts: [\n69:               { text: prompt },\n70:               {\n71:                 inlineData: {\n72:                   mimeType: 'image/jpeg',\n73:                   data: base64Image,\n74:                 },\n75:               },\n76:             ],\n77:           },\n78:         ],\n79:         generationConfig: {\n80:           responseMimeType: 'application/json',\n81:           temperature: 0.1,\n82:         },\n83:       }),\n84:     });\n85: \n86:     if (!response.ok) {\n87:       throw new Error(`API returned status ${response.status}`);\n88:     }\n89: \n90:     const data = await response.json();\n91:     const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;\n92:     if (!rawText) throw new Error('Empty response from vision model');\n93: \n94:     const parsed: any[] = JSON.parse(rawText);\n95:     return parsed.map((item, index) => ({\n96:       id: `ext_${Date.now()}_${index}`,\n97:       name: item.name || '',\n98:       phone: this.cleanPhone(item.phone || ''),\n99:       company: item.company || '',\n100:       notes: item.notes || '',\n101:       isValid: !!(item.name && item.phone),\n102:     }));\n103:   }\n104: \n105:   public static getDemoExtractedLeads(): ExtractedLeadItem[] {\n106:     return [\n107:       {\n108:         id: 'demo_1',\n109:         name: 'Michael Vance',\n110:         phone: '(555) 342-8901',\n111:         company: 'Apex Realty',\n112:         notes: 'Inquired about 4-bed listing',\n113:         isValid: true,\n114:       },\n115:       {\n116:         id: 'demo_2',\n117:         name: 'Jessica Thorne',\n118:         phone: '(555) 918-2345',\n119:         company: 'Pinnacle Capital',\n120:         notes: 'Requested rate quote',\n121:         isValid: true,\n122:       },\n123:       {\n124:         id: 'demo_3',\n125:         name: 'David Reynolds',\n126:         phone: '(555) 456-7890',\n127:         company: 'Self-Employed',\n128:         notes: 'Trade show booth attendee',\n129:         isValid: true,\n130:       },\n131:       {\n132:         id: 'demo_4',\n133:         name: 'Elena Rostova',\n134:         phone: '(555) 782-1199',\n135:         company: 'Summit Group',\n136:         notes: 'Follow up on flyer inquiry',\n137:         isValid: true,\n138:       },\n139:       {\n140:         id: 'demo_5',\n141:         name: 'Marcus Brody',\n142:         phone: '(555) 670-3412',\n143:         company: 'Brody Logistics',\n144:         notes: 'Needs commercial estimate',\n145:         isValid: true,\n146:       },\n147:     ];\n148:   }\n149: }\n150: \nThe above content shows the entire, complete file contents of the requested file.\n"}
