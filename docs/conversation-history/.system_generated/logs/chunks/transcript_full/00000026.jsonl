lect: none;\n      }\n      #root {\n        display: flex;\n        height: 100%;\n        flex: 1;\n        background-color: #14291B;\n      }\n    </style>\n  </head>\n\n  <body>\n    <noscript>\n      You need to enable JavaScript to run this app.\n    </noscript>\n    <div id=\"root\"></div>\n    <script src=\"/_expo/static/js/web/index-8aae5d345dbf63f48d4ff2299f8749e1.js\" defer></script>\n  </body>\n</html>\n","Description":"Inject 5 Trees Fellowship branding and mobile PWA meta tags into dist/index.html","Overwrite":true,"TargetFile":"C:\\Users\\brorm\\.gemini\\antigravity\\scratch\\snap-dialer\\dist\\index.html","toolAction":"Updating dist/index.html","toolSummary":"Inject theme tags into dist/index.html"}}]}
